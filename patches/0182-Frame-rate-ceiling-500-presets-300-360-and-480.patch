+// High frame rate (GA2_FPS=<61..500>) and the frame-timing oracle trace
 // (GA2_FRAMETRACE=<file>); docs/rendering/horplus-and-framerate.md.
 //
 // The games run one Update(dt) + Render per loop iteration and wait for the
@@ -22,7 +22,7 @@ class PS2Runtime;
 
 namespace ga2_framepace
 {
-    // The highest rate this run can reach: 240 whenever the hooks can run (the settings menu raises the cap live),
+    // The highest rate this run can reach: 500 whenever the hooks can run (the settings menu raises the cap live),
     // 0 = native only (VR, software GS; GA2_FPS_LIVE=0 limits it to GA2_FPS as before). Read once.
     int fps();
     // GA2_FPS: the cap the run starts with, 61..fps(); 60 = the native cadence (unset, 60, invalid, or "monitor":
