@@ -72,9 +73,7 @@ namespace bvr_assets
                 const uint64_t position = uint64_t(e.lba) * kSector + from;
                 if (!ec && position + count <= imageSize)
                 {
-                    in.seekg(std::streamoff(position));
-                    in.read(reinterpret_cast<char *>(out.data() + done), std::streamsize(count));
-                    if (!in)
+                    if (!in.readAt(position, out.data() + done, size_t(count)))
                         return false;
