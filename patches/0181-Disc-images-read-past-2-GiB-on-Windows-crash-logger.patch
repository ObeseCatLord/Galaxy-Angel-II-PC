+#if !defined(_WIN32) && !defined(__ANDROID__)
+#include <signal.h>
+#include <unistd.h>
+#if defined(__GLIBC__)
+#include <execinfo.h>
+#endif
+#endif
 #include <algorithm>
 #include <cstdlib>
 
@@ -37,6 +47,21 @@ extern "C"
     __declspec(dllimport) void *__stdcall LocalFree(void *);
     __declspec(dllimport) int __stdcall WideCharToMultiByte(unsigned, unsigned long, const wchar_t *, int, char *, int,
                                                            const char *, int *);
+    // The crash logger's filter (EXCEPTION_RECORD / EXCEPTION_POINTERS as the SDK lays them out).
+    struct Ga2ExceptionRecord
+    {
+        unsigned long ExceptionCode, ExceptionFlags;
+        Ga2ExceptionRecord *ExceptionRecord;
+        void *ExceptionAddress;
+        unsigned long NumberParameters;
+        unsigned long long ExceptionInformation[15];
+    };
+    struct Ga2ExceptionPointers
+    {
+        Ga2ExceptionRecord *ExceptionRecord;
+        void *ContextRecord;
+    };
+    __declspec(dllimport) void *__stdcall SetUnhandledExceptionFilter(long(__stdcall *)(Ga2ExceptionPointers *));
 }
 #endif
 
@@ -109,6 +134,56 @@ namespace
     }
 #endif
 
+    // Hard crashes (a bad access, an abort, a bus error) used to end the log with no word (a Steam Deck report, issue
+    // #1): the signal or exception, the game time and (glibc) a backtrace go to the log first, then the crash proceeds.
+#if defined(_WIN32)
+    long __stdcall crashFilter(Ga2ExceptionPointers *info)
+    {
+        const Ga2ExceptionRecord *r = info ? info->ExceptionRecord : nullptr;
+        std::fprintf(stderr, "[crash] exception 0x%08lx at %p (game time %.1f s)\n", r ? static_cast<unsigned long>(r->ExceptionCode) : 0ul,
+                     r ? r->ExceptionAddress : nullptr, ga2_activity::gameSeconds());
+        if (r && r->ExceptionCode == 0xC0000005ul /* access violation */ && r->NumberParameters >= 2)
+            std::fprintf(stderr, "[crash] %s address 0x%llx\n", r->ExceptionInformation[0] ? "write to" : "read from",
+                         static_cast<unsigned long long>(r->ExceptionInformation[1]));
+        std::fflush(stderr);
+        return 0; // EXCEPTION_CONTINUE_SEARCH: the crash goes on as it would have
+    }
+    void setupCrashLogger() { SetUnhandledExceptionFilter(crashFilter); }
+#elif !defined(__ANDROID__)
+    void crashSignal(int sig)
+    {
+        const char *name = sig == SIGSEGV ? "SIGSEGV (bad memory access)" : sig == SIGBUS ? "SIGBUS" : sig == SIGILL ? "SIGILL"
+                         : sig == SIGFPE ? "SIGFPE" : sig == SIGABRT ? "SIGABRT (abort)" : "signal";
+        char line[160];
+        const int n = std::snprintf(line, sizeof(line), "[crash] %s (game time %.1f s); backtrace:\n", name, ga2_activity::gameSeconds());
+        if (n > 0)
+            (void)!::write(2, line, size_t(n));
+#if defined(__GLIBC__)
+        void *frames[64];
+        const int count = backtrace(frames, 64);
+        backtrace_symbols_fd(frames, count, 2);
+#endif
+        // SA_RESETHAND restored the default action: the crash goes on as it would have (core dump, exit status).
+        raise(sig);
+    }
+    void setupCrashLogger()
+    {
+        static std::vector<char> altStack(64 * 1024);
+        stack_t ss{};
+        ss.ss_sp = altStack.data();
+        ss.ss_size = altStack.size();
+        sigaltstack(&ss, nullptr);
+        struct sigaction sa{};
+        sa.sa_handler = crashSignal;
+        sigemptyset(&sa.sa_mask);
+        sa.sa_flags = SA_RESETHAND | SA_ONSTACK;
+        for (int sig : {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT})
+            sigaction(sig, &sa, nullptr);
+    }
+#else
+    void setupCrashLogger() {}
+#endif
+
     void setupTerminateLogger() // to help on release build crashs
     {
         std::set_terminate([]()
@@ -214,6 +289,7 @@ int main(int argc, char *argv[])
     redirectStdioToLogcat();
 #endif
     setupTerminateLogger();
+    setupCrashLogger();
 #ifdef _WIN32
     // The CRT's argv is in the ANSI code page: a path with characters outside
     // it (a user name, the launcher's data folder) would arrive as '?'. Decode
