-            std::ifstream in(image, std::ios::binary);
-            std::error_code ec;
-            const uint64_t imageSize = std::filesystem::file_size(image, ec);
+            const ga2_fileread::File in(image); // positional reads: the images are over 4 GB (no 2 GiB seek limit)
