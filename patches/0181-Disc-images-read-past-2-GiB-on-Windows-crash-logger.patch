         auto iso = std::make_shared<Iso>();
-        iso->in.open(image, std::ios::binary);
-        if (iso->in)
+        if (iso->in.open(image))
         {
             std::vector<uint8_t> vd(kSector);
             bool primary = false;
             for (uint64_t sector = 16; sector < 116 && !primary; ++sector)
             {
-                iso->in.seekg(std::streamoff(sector * kSector));
-                iso->in.read(reinterpret_cast<char *>(vd.data()), std::streamsize(kSector));
-                if (!iso->in || std::memcmp(vd.data() + 1, "CD001", 5) != 0 || vd[0] == 255)
+                if (!iso->in.readAt(sector * kSector, vd.data(), kSector) || std::memcmp(vd.data() + 1, "CD001", 5) != 0 ||
+                    vd[0] == 255)
                     break;
                 primary = vd[0] == 1;
             }
@@ -111,8 +108,8 @@ namespace bvr_assets
             {
                 const uint64_t lba = u32(vd.data() + 156 + 2), size = u32(vd.data() + 156 + 10);
                 std::vector<uint8_t> dir(size_t(std::min<uint64_t>(size, 1u << 20)));
-                iso->in.seekg(std::streamoff(lba * kSector));
-                iso->in.read(reinterpret_cast<char *>(dir.data()), std::streamsize(dir.size()));
+                if (!iso->in.readAt(lba * kSector, dir.data(), dir.size()))
+                    dir.clear();
                 for (size_t pos = 0; pos < dir.size();)
                 {
                     const uint8_t n = dir[pos];
@@ -151,10 +148,7 @@ namespace bvr_assets
             if (it == iso->files.end() || offset > it->second.second || size > it->second.second - offset)
                 return false;
             out.resize(size);
-            iso->in.clear();
-            iso->in.seekg(std::streamoff(it->second.first + offset));
-            iso->in.read(reinterpret_cast<char *>(out.data()), std::streamsize(size));
-            return bool(iso->in);
+            return iso->in.readAt(it->second.first + offset, out.data(), size);
         };
     }
 
