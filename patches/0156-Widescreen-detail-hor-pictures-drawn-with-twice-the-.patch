@@ -1302,6 +1425,30 @@ bool PS2Runtime::initialize(const char *title)
             std::fprintf(stderr, "[display] %dx%d: internal resolution %s (automatic)\n", GetMonitorWidth(monitor), height,
                          std::string(pick) == "16" ? "4x" : std::string(pick) == "4" ? "2x" : "native");
         }
+        // Widescreen detail: a hor+ picture is the game's 640-wide frame widened; where the screen gives that picture
+        // more columns than the frame has (16:9 at 1080p or 4K, ultrawide), a second GS instance doubles the columns
+        // (gs_pgs.cpp) instead of the picture being stretched. GA2_PGS_WIDE_DETAIL=0/1 overrides.
+        if (!std::getenv("GA2_PGS_WIDE_DETAIL") && !vrMode)
+        {
+            const char *wide3d = ga2_settings::value(ga2_options::Widescreen3d);
+            const int monitor = GetCurrentMonitor();
+            const float mw = float(std::max(GetMonitorWidth(monitor), 1)), mh = float(std::max(GetMonitorHeight(monitor), 1));
+            float aspect = ga2_display::parseAspect(ga2_settings::value(ga2_options::Aspect));
+            if (aspect <= 0.0f || aspect > mw / mh) // "fill" (the screen's own shape), or wider than the screen
+                aspect = mw / mh;
+            const int ssaa = std::atoi(std::getenv("GA2_PGS_SSAA") ? std::getenv("GA2_PGS_SSAA") : "1");
+            const float frameColumns = 640.0f * float(ssaa >= 16 ? 4 : ssaa >= 4 ? 2 : 1);
+            const float pictureColumns = std::min(mw, mh * aspect);
+            const bool on = !(wide3d && *wide3d == '0') && aspect > 4.0f / 3.0f + 0.01f && pictureColumns > frameColumns * 1.1f;
+#if defined(_WIN32)
+            _putenv_s("GA2_PGS_WIDE_DETAIL", on ? "1" : "0");
+#else
+            setenv("GA2_PGS_WIDE_DETAIL", on ? "1" : "0", 1);
+#endif
+            if (on)
+                std::fprintf(stderr, "[display] widescreen detail: a %.0f-column picture from a %.0f-column frame, columns doubled\n",
