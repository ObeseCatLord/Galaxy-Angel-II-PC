+// Widescreen detail (ga2_pgs::wideDetail): eye 0 and the instance half an output pixel to its right, columns
+// interleaved into a picture twice as wide.
+static const char *kWideJoin = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform sampler2D right;
+uniform vec2 outSize;
+out vec4 finalColor;
+void main() {
+    ivec2 p = ivec2(floor(fragTexCoord * outSize));
+    ivec2 q = ivec2(p.x / 2, p.y);
+    vec4 c = (p.x & 1) == 0 ? texelFetch(texture0, q, 0) : texelFetch(right, q, 0);
+    finalColor = vec4(c.rgb, 1.0);
+})";
+
+// `left` and `right` (w x h each, the frames' orientation) into the joined texture (2w x h); false when it cannot.
+static bool JoinWide(unsigned left, unsigned right, int w, int h, Texture2D &joined)
+{
+    static RenderTexture2D s_target{};
+    static Shader s_shader{};
+    static int s_loaded = -1;
+    if (s_loaded < 0)
+    {
+        s_shader = LoadShaderFromMemory(nullptr, kWideJoin);
+        s_loaded = IsShaderValid(s_shader) ? 1 : 0;
+        if (s_loaded != 1)
+            std::fprintf(stderr, "[display] widescreen detail: join shader failed; wide pictures are stretched\n");
+    }
+    if (s_loaded != 1 || !left || !right || w <= 0 || h <= 0)
+        return false;
+    if (s_target.texture.width != 2 * w || s_target.texture.height != h)
+    {
+        if (s_target.id)
+            UnloadRenderTexture(s_target);
+        s_target = LoadRenderTexture(2 * w, h);
+        SetTextureFilter(s_target.texture, TEXTURE_FILTER_BILINEAR);
+    }
+    const Texture2D l{left, w, h, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8}, r{right, w, h, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+    rlDrawRenderBatchActive();
+    BeginTextureMode(s_target);
+    BeginShaderMode(s_shader);
+    const float outSize[2] = {float(2 * w), float(h)};
+    SetShaderValue(s_shader, GetShaderLocation(s_shader, "outSize"), outSize, SHADER_UNIFORM_VEC2);
+    SetShaderValueTexture(s_shader, GetShaderLocation(s_shader, "right"), r);
+    // Upside down into the render target, so its texture has the frames' orientation.
+    DrawTexturePro(l, Rectangle{0.0f, 0.0f, float(w), -float(h)}, Rectangle{0.0f, 0.0f, outSize[0], outSize[1]}, Vector2{0, 0},
+                   0.0f, WHITE);
+    EndShaderMode();
+    EndTextureMode();
+    joined = s_target.texture;
+    return true;
+}
