+    // ---- RAIC ---------------------------------------------------------------------------------------------------
+
+    bool raicDecompress(const uint8_t *data, size_t size, std::vector<uint8_t> &out)
+    {
+        if (size < 8)
+            return false;
+        char magic[4];
+        for (int i = 0; i < 4; ++i)
+            magic[i] = char(data[i] ^ 0x72);
+        const uint32_t usize = u32(data + 4);
+        out.clear();
+        if (std::memcmp(magic, "RAIB", 4) == 0)
+        {
+            if (size - 8 < usize)
+                return false;
+            out.resize(usize);
+            for (uint32_t i = 0; i < usize; ++i)
+                out[i] = uint8_t(data[8 + i] ^ 0x72);
+            return true;
+        }
+        if (std::memcmp(magic, "RAIC", 4) != 0)
+            return false;
+        out.reserve(usize);
+        uint8_t window[4096] = {};
+        uint32_t r = 0xFEE, flags = 0;
+        size_t i = 8;
+        auto src = [&](size_t k) { return uint8_t(data[k] ^ 0x72); };
+        while (out.size() < usize && i < size)
+        {
+            flags >>= 1;
+            if (!(flags & 0x100))
+            {
+                flags = src(i++) | 0xFF00u;
+                if (i >= size)
+                    break;
+            }
+            if (flags & 1)
+            {
+                const uint8_t c = src(i++);
+                out.push_back(c);
+                window[r] = c;
+                r = (r + 1) & 0xFFF;
+            }
+            else
+            {
+                if (i + 1 >= size)
+                    break;
+                const uint8_t a = src(i), b = src(i + 1);
+                i += 2;
+                const uint32_t p = a | (uint32_t(b & 0xF0) << 4);
+                for (uint32_t k = 0; k < uint32_t(b & 0x0F) + 3u && out.size() < usize; ++k)
+                {
+                    const uint8_t c = window[(p + k) & 0xFFF];
+                    out.push_back(c);
+                    window[r] = c;
+                    r = (r + 1) & 0xFFF;
+                }
+            }
+        }
+        return out.size() == usize;
+    }
