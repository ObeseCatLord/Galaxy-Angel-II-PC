diff --git a/ps2xTest/src/bvr_assets_tests.cpp b/ps2xTest/src/bvr_assets_tests.cpp
new file mode 100644
index 0000000..5b5c0eb
--- /dev/null
+++ b/ps2xTest/src/bvr_assets_tests.cpp
@@ -0,0 +1,140 @@
+#include "MiniTest.h"
+
+#include "battlevr/bvr_assets.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace
+{
+    uint64_t fnv(const std::vector<uint32_t> &rgba)
+    {
+        uint64_t h = 0xcbf29ce484222325ull;
+        for (uint32_t c : rgba)
+            for (int k = 0; k < 4; ++k)
+            {
+                h ^= (c >> (8 * k)) & 0xFFu;
+                h *= 0x100000001b3ull;
+            }
+        return h;
+    }
+    void put32(std::vector<uint8_t> &d, size_t at, uint32_t v)
+    {
+        for (int k = 0; k < 4; ++k)
+            d[at + size_t(k)] = uint8_t(v >> (8 * k));
+    }
+}
+
+void register_bvr_assets_tests()
+{
+    MiniTest::Case("BvrAssets", [](TestCase &tc) {
+        tc.Run("RAIC and RAIB streams decompress", [](TestCase &t) {
+            // RAIB: stored, XOR 0x72.
+            std::vector<uint8_t> raib = {'R' ^ 0x72, 'A' ^ 0x72, 'I' ^ 0x72, 'B' ^ 0x72, 3, 0, 0, 0, 'x' ^ 0x72, 'y' ^ 0x72, 'z' ^ 0x72};
+            std::vector<uint8_t> out;
+            t.IsTrue(bvr_assets::raicDecompress(raib.data(), raib.size(), out), "stored stream");
+            t.Equals(std::string(out.begin(), out.end()), std::string("xyz"), "its bytes");
+            // RAIC: flags 0x07 (three literals 'a' 'b' 'c', then a reference to window 0xFEE length 3 = "abc").
+            std::vector<uint8_t> src = {0x07, 'a', 'b', 'c', 0xEE, 0xF0};
+            std::vector<uint8_t> raic = {'R' ^ 0x72, 'A' ^ 0x72, 'I' ^ 0x72, 'C' ^ 0x72, 6, 0, 0, 0};
+            for (uint8_t b : src)
+                raic.push_back(uint8_t(b ^ 0x72));
+            t.IsTrue(bvr_assets::raicDecompress(raic.data(), raic.size(), out), "LZSS stream");
+            t.Equals(std::string(out.begin(), out.end()), std::string("abcabc"), "literals and a back reference");
+            raic[4] = 9; // claims more than it holds
+            t.IsFalse(bvr_assets::raicDecompress(raic.data(), raic.size(), out), "a truncated stream is refused");
+        });
+
+        tc.Run("AGI PSMT8 uses the CSM1 CLUT order and doubles alpha", [](TestCase &t) {
+            std::vector<uint8_t> agi(0x40 + 4 + 256 * 4, 0);
+            put32(agi, 0x08, 0x40);
+            agi[0x0E] = 0x13;
+            agi[0x18] = 2, agi[0x1A] = 2;
+            put32(agi, 0x1C, 0x44);
+            agi[0x40] = 0x08, agi[0x41] = 0x10, agi[0x42] = 1, agi[0x43] = 0;
+            put32(agi, 0x44 + 4 * 0x10, 0x80112233u); // index 0x08 reads CLUT slot 0x10
+            put32(agi, 0x44 + 4 * 0x08, 0x40445566u); // index 0x10 reads CLUT slot 0x08
+            put32(agi, 0x44 + 4 * 0x01, 0x00000000u);
+            bvr_assets::Texture tex;
+            t.IsTrue(bvr_assets::decodeAgi(agi.data(), agi.size(), tex), "decoded");
+            t.Equals(tex.rgba[0], 0xFF112233u, "index 8 -> slot 16, alpha 0x80 -> 255");
+            t.Equals(tex.rgba[1], 0x80445566u, "index 16 -> slot 8, alpha 0x40 -> 0x80");
+            t.Equals(tex.rgba[2], 0x00000000u, "transparent");
+        });
+
+        // GA2_TEST_ISO=<Eigou disc 1 image>: the ship models and their textures match the Python decoder
+        // (tools/assets/extract_skybox.py), numbers taken from it on 2026-11-19.
+        tc.Run("disc models match the Python decoder (GA2_TEST_ISO)", [](TestCase &t) {
+            const char *iso = std::getenv("GA2_TEST_ISO");
+            if (!iso || !*iso)
+            {
+                t.IsTrue(true, "skipped: GA2_TEST_ISO not set");
+                return;
+            }
+            bvr_assets::Archive archive;
+            t.IsTrue(archive.open(bvr_assets::isoFile(iso)), "archives indexed");
+            struct Ref
+            {
+                const char *name;
+                size_t triangles;
+                float lo[3], hi[3];
+                const char *tex[2];
+                uint64_t hash[2];
+            };
+            const Ref refs[] = {
+                {"si_mon_0000.axo", 1708, {-13.333f, -4.26f, -24.867f}, {13.333f, 4.26f, 12.738f}, {"si_mon_000", "si_mon_010"},
+                 {0x85596151e90d7d39ull, 0x33f9e744df3ebe33ull}},
+                {"si_mes_0101.axo", 195, {-30.72f, -40.96f, -83.28f}, {30.72f, 92.6f, 163.76f}, {"enm01", "si_mes_0100"},
+                 {0x4ce4484added7987ull, 0xf9aa923cf254a244ull}},
+                {"si_mon_1000.axo", 1712, {-8.437f, -7.403f, -23.232f}, {8.437f, 7.403f, 12.134f}, {"si_mon_100", "si_mon_110"}, {0, 0}},
+                {"si_mon_2000.axo", 2139, {-10.677f, -10.331f, -15.017f}, {10.677f, 10.331f, 12.334f}, {"si_mon_210", "si_mon_200"}, {0, 0}},
+                {"si_mes_0102b.axo", 130, {-60.16f, -10.24f, -23.12f}, {-20.48f, 10.24f, 42.16f}, {"enm01", "si_mes_0100"}, {0, 0}},
+            };
+            {
+                // The model table names its model, motion and clips.
+                std::vector<uint8_t> text;
+                bvr_assets::Table table;
+                t.IsTrue(archive.read("slg/machines/si_mon_0000.tbl", text), "model table read");
+                bvr_assets::parseTable(text.data(), text.size(), table);
+                const auto models = table.list("MODELFILE");
+                t.IsTrue(!models.empty() && models[0] == "slg/machines/si_mon_0000.axo", "MODELFILE #000");
+                t.IsTrue(table.get("HEADER", "TEXDIR") && *table.get("HEADER", "TEXDIR") == "slg/machines", "TEXDIR");
+                t.IsTrue(table.number("ANIME01", "PLAYSPEED", -1.0f) == 1.0f, "ANIME01 PLAYSPEED");
+                t.IsTrue(table.number("ANIME02", "BEGINFRAME", 0.0f) == -1.0f, "ANIME02 BEGINFRAME");
+            }
+            for (const Ref &r : refs)
+            {
+                std::vector<uint8_t> data;
+                bvr_assets::Model model;
+                std::string error;
+                const bool ok = archive.read(r.name, data) && bvr_assets::decodeAxo(data.data(), data.size(), model, &error);
+                t.IsTrue(ok, std::string(r.name) + " decoded " + error);
+                if (!ok)
+                    continue;
+                t.Equals(model.triangles(), r.triangles, std::string(r.name) + " triangles");
+                float lo[3], hi[3];
+                bvr_assets::modelBounds(model, lo, hi);
+                bool bounds = true;
+                for (int k = 0; k < 3; ++k)
+                    bounds = bounds && std::fabs(lo[k] - r.lo[k]) < 0.01f && std::fabs(hi[k] - r.hi[k]) < 0.01f;
+                t.IsTrue(bounds, std::string(r.name) + " bounds");
+                t.Equals(model.textures.size(), size_t(2), std::string(r.name) + " textures");
+                for (int k = 0; k < 2 && model.textures.size() == 2; ++k)
+                {
+                    t.Equals(model.textures[size_t(k)], std::string(r.tex[k]), "texture name");
+                    if (!r.hash[k])
+                        continue;
+                    bvr_assets::Texture tex;
+                    const bool texOk = archive.read(model.textures[size_t(k)] + ".agi", data) &&
+                                       bvr_assets::decodeAgi(data.data(), data.size(), tex);
+                    t.IsTrue(texOk && tex.width == 256 && tex.height == 256, std::string(r.tex[k]) + " 256 x 256");
+                    t.Equals(fnv(tex.rgba), r.hash[k], std::string(r.tex[k]) + " pixels");
+                }
+            }
+        });
+    });
+}
