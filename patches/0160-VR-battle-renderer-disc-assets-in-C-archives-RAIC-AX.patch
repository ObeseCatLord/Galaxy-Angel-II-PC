+        constexpr uint64_t kSector = 2048;
+
+        uint32_t u32(const uint8_t *p) { return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24; }
+        uint16_t u16(const uint8_t *p) { return uint16_t(p[0] | p[1] << 8); }
+        float f32(const uint8_t *p)
+        {
+            const uint32_t v = u32(p);
+            float f;
+            std::memcpy(&f, &v, 4);
+            return f;
+        }
+        bool fits(size_t size, uint64_t offset, uint64_t length) { return offset <= size && length <= size - offset; }
+
+        std::string lower(std::string s)
+        {
+            for (char &c : s)
+                c = char(std::tolower(static_cast<unsigned char>(c)));
+            return s;
+        }
+        std::string cstr(const std::vector<uint8_t> &d, uint64_t offset)
+        {
+            std::string s;
+            for (uint64_t i = offset; i < d.size() && d[i]; ++i)
+                s.push_back(char(d[i]));
+            return s;
+        }
