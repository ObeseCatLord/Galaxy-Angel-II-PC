+    // ---- disc sources -------------------------------------------------------------------------------------------
+
+    ReadFn mountedDisc()
+    {
+        return [](const std::string &name, uint64_t offset, size_t size, std::vector<uint8_t> &out) {
+            ps2_disc::File file;
+            std::filesystem::path image;
+            if (!ps2_disc::findFile(name, file, &image) || offset > file.size || size > file.size - offset)
+                return false;
+            out.assign(size, 0);
+            std::ifstream in(image, std::ios::binary);
+            std::error_code ec;
+            const uint64_t imageSize = std::filesystem::file_size(image, ec);
+            // Walk the extents to the requested bytes (files are mostly one extent).
+            uint64_t fileOffset = 0, done = 0;
+            for (const ps2_disc::Extent &e : file.extents)
+            {
+                const uint64_t begin = fileOffset, end = fileOffset + e.size;
+                fileOffset = end;
+                if (offset + done >= end || done == size)
+                    continue;
+                const uint64_t from = offset + done - begin;
+                const uint64_t count = std::min<uint64_t>(end - (offset + done), size - done);
+                const uint64_t position = uint64_t(e.lba) * kSector + from;
+                if (!ec && position + count <= imageSize)
+                {
+                    in.seekg(std::streamoff(position));
+                    in.read(reinterpret_cast<char *>(out.data() + done), std::streamsize(count));
+                    if (!in)
+                        return false;
+                }
+                else if (!ps2_disc::readOverlay(image, position, out.data() + done, size_t(count)))
+                    return false;
+                done += count;
+            }
+            return done == size;
+        };
+    }
+
+    ReadFn isoFile(const std::filesystem::path &image)
+    {
+        struct Iso
+        {
+            std::ifstream in;
+            std::map<std::string, std::pair<uint64_t, uint64_t>> files; // upper-case name -> byte offset, size
+            std::mutex mutex;
+        };
+        auto iso = std::make_shared<Iso>();
+        iso->in.open(image, std::ios::binary);
+        if (iso->in)
+        {
+            std::vector<uint8_t> vd(kSector);
+            bool primary = false;
+            for (uint64_t sector = 16; sector < 116 && !primary; ++sector)
+            {
+                iso->in.seekg(std::streamoff(sector * kSector));
+                iso->in.read(reinterpret_cast<char *>(vd.data()), std::streamsize(kSector));
+                if (!iso->in || std::memcmp(vd.data() + 1, "CD001", 5) != 0 || vd[0] == 255)
+                    break;
+                primary = vd[0] == 1;
+            }
+            if (primary)
+            {
+                const uint64_t lba = u32(vd.data() + 156 + 2), size = u32(vd.data() + 156 + 10);
+                std::vector<uint8_t> dir(size_t(std::min<uint64_t>(size, 1u << 20)));
+                iso->in.seekg(std::streamoff(lba * kSector));
+                iso->in.read(reinterpret_cast<char *>(dir.data()), std::streamsize(dir.size()));
+                for (size_t pos = 0; pos < dir.size();)
+                {
+                    const uint8_t n = dir[pos];
+                    if (n == 0) // records do not cross sectors
+                    {
+                        pos = (pos / kSector + 1) * kSector;
+                        continue;
+                    }
+                    if (pos + 34 > dir.size() || pos + n > dir.size())
+                        break;
+                    const uint8_t *rec = dir.data() + pos;
+                    const uint8_t nameLength = rec[32];
+                    std::string name(reinterpret_cast<const char *>(rec + 33), std::min<size_t>(nameLength, n - 33u));
+                    if (!(rec[25] & 2) && name != std::string(1, '\0') && name != std::string(1, '\1'))
+                    {
+                        name = name.substr(0, name.find(';'));
+                        for (char &c : name)
+                            c = char(std::toupper(static_cast<unsigned char>(c)));
+                        const uint64_t extent = u32(rec + 2), bytes = u32(rec + 10);
+                        auto prev = iso->files.find(name);
+                        if (prev != iso->files.end() && !(rec[25] & 0x80)) // a multi-extent file's tail
+                            prev->second.second += bytes;
+                        else
+                            iso->files[name] = {extent * kSector, bytes};
+                    }
+                    pos += n;
+                }
+            }
+        }
+        return [iso](const std::string &name, uint64_t offset, size_t size, std::vector<uint8_t> &out) {
+            std::string key = name;
+            for (char &c : key)
+                c = char(std::toupper(static_cast<unsigned char>(c)));
+            std::lock_guard<std::mutex> lock(iso->mutex);
+            const auto it = iso->files.find(key);
+            if (it == iso->files.end() || offset > it->second.second || size > it->second.second - offset)
+                return false;
+            out.resize(size);
+            iso->in.clear();
+            iso->in.seekg(std::streamoff(it->second.first + offset));
+            iso->in.read(reinterpret_cast<char *>(out.data()), std::streamsize(size));
+            return bool(iso->in);
+        };
+    }
