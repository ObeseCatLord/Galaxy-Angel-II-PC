diff --git a/ps2xRuntime/src/lib/ga2_vr_hand.h b/ps2xRuntime/src/lib/ga2_vr_hand.h
new file mode 100644
index 0000000..17cb5b2
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_vr_hand.h
@@ -0,0 +1,111 @@
+#pragma once
+
+#include "ga2_vr_hand_mesh_mobile.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+// The VR hands' geometry (no GL): the hand mesh (ga2_vr_hand_mesh_mobile.h, a right hand) posed for a frame, as
+// interleaved vertices (px py pz nx ny nz) in the play space, ready for the hand mesh's indices.
+//   - fixed poses: relaxed, point (the trigger) and fist (the grip) blended, placed by a 4x4 (column-major) frame;
+//   - finger tracking: linear blend skinning to the 26 XR_EXT_hand_tracking joints.
+// The left hand is the right one mirrored in x: in the placing frame, or (tracked) in each joint's own frame, since
+// OpenXR's joint frames are right-handed for both hands (the left hand's are the right's mirrored with their x
+// flipped).
+namespace ga2_vr_hand
+{
+    namespace mesh = ga2_vr_hand_mesh_mobile;
+    constexpr int kVertices = mesh::kVertices;
+    constexpr int kIndices = mesh::kIndices;
+    constexpr int kJoints = mesh::kJoints;
+
+    inline void transform(const float *m, const float p[3], float w, float out[3])
+    {
+        for (int r = 0; r < 3; ++r)
+            out[r] = m[r] * p[0] + m[4 + r] * p[1] + m[8 + r] * p[2] + m[12 + r] * w;
+    }
+
+    // The inverse of a rotation + translation.
+    inline void inverseRigid(const float *a, float r[16])
+    {
+        for (int i = 0; i < 16; ++i)
+            r[i] = (i == 15) ? 1.0f : 0.0f;
+        for (int i = 0; i < 3; ++i)
+            for (int j = 0; j < 3; ++j)
+                r[i * 4 + j] = a[j * 4 + i];
+        for (int i = 0; i < 3; ++i)
+            r[12 + i] = -(r[i] * a[12] + r[4 + i] * a[13] + r[8 + i] * a[14]);
+    }
+
+    // Each vertex's four influences in their joint's bind frame (point, normal): made once.
+    inline std::vector<float> bindLocal()
+    {
+        std::vector<float> local(size_t(kVertices) * 4 * 6);
+        float inverse[kJoints][16];
+        for (int j = 0; j < kJoints; ++j)
+            inverseRigid(mesh::kBindJoints[j], inverse[j]);
+        for (int v = 0; v < kVertices; ++v)
+        {
+            const float *p = &mesh::kPositions[mesh::kPoseRelaxed][v * 3], *n = &mesh::kNormals[mesh::kPoseRelaxed][v * 3];
+            for (int i = 0; i < 4; ++i)
+            {
+                const float *m = inverse[mesh::kJointIndex[v * 4 + i] % kJoints];
+                float *o = &local[(size_t(v) * 4 + size_t(i)) * 6];
+                transform(m, p, 1.0f, o);
+                transform(m, n, 0.0f, o + 3);
+            }
+        }
+        return local;
+    }
+
+    // Skinned to tracked joints (26 column-major 4x4s, play space).
+    inline void skin(const std::vector<float> &local, const float (*joints)[16], bool left, float *out)
+    {
+        const float sx = left ? -1.0f : 1.0f;
+        for (int v = 0; v < kVertices; ++v)
+        {
+            float p[3] = {0, 0, 0}, n[3] = {0, 0, 0};
+            for (int i = 0; i < 4; ++i)
+            {
+                const float w = mesh::kJointWeight[v * 4 + i];
+                if (w <= 0.0f)
+                    continue;
+                const float *m = joints[mesh::kJointIndex[v * 4 + i] % kJoints];
+                const float *l = &local[(size_t(v) * 4 + size_t(i)) * 6];
+                const float lp[3] = {l[0] * sx, l[1], l[2]}, ln[3] = {l[3] * sx, l[4], l[5]};
+                float tp[3], tn[3];
+                transform(m, lp, 1.0f, tp);
+                transform(m, ln, 0.0f, tn);
+                for (int r = 0; r < 3; ++r)
+                    p[r] += w * tp[r], n[r] += w * tn[r];
+            }
+            float *o = out + size_t(v) * 6;
+            o[0] = p[0], o[1] = p[1], o[2] = p[2], o[3] = n[0], o[4] = n[1], o[5] = n[2];
+        }
+    }
+
+    // The fixed poses: relaxed -> point by `point`, then -> fist by `fist` (0..1 each), placed by `place` (the aim
+    // pose: the pointing index fingertip at its origin, the finger along -z).
+    inline void posed(float point, float fist, const float place[16], bool left, float *out)
+    {
+        point = std::clamp(point, 0.0f, 1.0f), fist = std::clamp(fist, 0.0f, 1.0f);
+        const float *r0 = mesh::kPositions[mesh::kPoseRelaxed], *r1 = mesh::kPositions[mesh::kPosePoint], *r2 = mesh::kPositions[mesh::kPoseFist];
+        const float *n0 = mesh::kNormals[mesh::kPoseRelaxed], *n1 = mesh::kNormals[mesh::kPosePoint], *n2 = mesh::kNormals[mesh::kPoseFist];
+        const float sx = left ? -1.0f : 1.0f;
+        for (int v = 0; v < kVertices; ++v)
+        {
+            float lp[3], ln[3];
+            for (int k = 0; k < 3; ++k)
+            {
+                const size_t i = size_t(v) * 3 + size_t(k);
+                const float a = r0[i] + (r1[i] - r0[i]) * point, an = n0[i] + (n1[i] - n0[i]) * point;
+                lp[k] = a + (r2[i] - a) * fist;
+                ln[k] = an + (n2[i] - an) * fist;
+            }
+            lp[0] *= sx, ln[0] *= sx;
+            transform(place, lp, 1.0f, out + size_t(v) * 6);
+            transform(place, ln, 0.0f, out + size_t(v) * 6 + 3);
+        }
+    }
+}
