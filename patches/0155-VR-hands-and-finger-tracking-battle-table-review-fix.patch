diff --git a/ps2xTest/src/ga2_flatart_tests.cpp b/ps2xTest/src/ga2_flatart_tests.cpp
new file mode 100644
index 0000000..cf182de
--- /dev/null
+++ b/ps2xTest/src/ga2_flatart_tests.cpp
@@ -0,0 +1,100 @@
+#include "MiniTest.h"
+
+#include "gs/ga2_flatart.h"
+
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace
+{
+    constexpr uint32_t kClear = 0x00000000u, kRed = 0xFF000066u, kYellow = 0xFF00FFFFu, kWhite = 0xFFFFFFFFu;
+
+    // An HP-ring-like texture: a pixel ring (radius 19..23 about the centre), its first quarter yellow, a 2-pixel
+    // white tick at the top.
+    std::vector<uint32_t> ring(int size)
+    {
+        std::vector<uint32_t> px(size_t(size) * size, kClear);
+        const float c = size * 0.5f;
+        for (int y = 0; y < size; ++y)
+            for (int x = 0; x < size; ++x)
+            {
+                const float dx = x + 0.5f - c, dy = y + 0.5f - c, r = std::hypot(dx, dy);
+                if (r < 19.0f || r > 23.0f)
+                    continue;
+                const float angle = std::atan2(dx, -dy); // 0 at the top, clockwise
+                px[size_t(y) * size + x] = angle >= 0.0f && angle < 1.5708f ? kYellow : kRed;
+                if (std::fabs(dx) < 1.0f && dy < 0.0f)
+                    px[size_t(y) * size + x] = kWhite;
+            }
+        return px;
+    }
+    uint32_t at(const std::vector<uint32_t> &img, int w, float x, float y) { return img[size_t(int(y)) * w + size_t(int(x))]; }
+    int alpha(uint32_t c) { return int(c >> 24); }
+}
+
+void register_ga2_flatart_tests()
+{
+    MiniTest::Case("FlatArt", [](TestCase &tc) {
+        tc.Run("a ring is redrawn as a true circle with its arc colours and tick", [](TestCase &t) {
+            const int n = 48, s = 4;
+            const std::vector<uint32_t> src = ring(n);
+            ga2_flatart::Classes cls;
+            t.IsTrue(ga2_flatart::classify(src.data(), n, n, cls), "a few flat colours: flat art");
+            t.Equals(int(cls.colors.size()), 4, "clear, red, yellow and the tick's white");
+            const std::vector<uint32_t> out = ga2_flatart::upscale(cls, n, n, s);
+            t.Equals(out.size(), size_t(n * s) * size_t(n * s), "4x the size");
+            const float c = n * s * 0.5f, mid = 21.0f * s;
+            bool round = true;
+            for (int k = 0; k < 64; ++k) // every direction: on the band at its middle radius, clear inside and outside
+            {
+                const float a = 6.2831853f * float(k) / 64.0f;
+                round = round && alpha(at(out, n * s, c + std::sin(a) * mid, c - std::cos(a) * mid)) == 255 &&
+                        alpha(at(out, n * s, c + std::sin(a) * 18.0f * s, c - std::cos(a) * 18.0f * s)) == 0 &&
+                        alpha(at(out, n * s, c + std::sin(a) * 23.6f * s, c - std::cos(a) * 23.6f * s)) == 0;
+            }
+            t.IsTrue(round, "a full circle at the ring's radius, nothing inside or outside");
+            t.Equals(at(out, n * s, c + std::sin(0.8f) * mid, c - std::cos(0.8f) * mid), kYellow, "the yellow arc stays yellow");
+            t.Equals(at(out, n * s, c + std::sin(3.0f) * mid, c - std::cos(3.0f) * mid), kRed, "the rest red");
+            t.Equals(at(out, n * s, c, c - mid), kWhite, "the tick at the top survives");
+        });
+
+        tc.Run("a disc's edge is smooth and its centre filled", [](TestCase &t) {
+            const int n = 32, s = 4;
+            std::vector<uint32_t> src(size_t(n) * n, kClear);
+            for (int y = 0; y < n; ++y)
+                for (int x = 0; x < n; ++x)
+                    if (std::hypot(x + 0.5f - 16.0f, y + 0.5f - 16.0f) <= 12.0f)
+                        src[size_t(y) * n + x] = kWhite;
+            ga2_flatart::Classes cls;
+            t.IsTrue(ga2_flatart::classify(src.data(), n, n, cls), "flat art");
+            const std::vector<uint32_t> out = ga2_flatart::upscale(cls, n, n, s);
+            t.Equals(at(out, n * s, 64.0f, 64.0f), kWhite, "the centre is filled");
+            // Along a diagonal (a pixel staircase in the source) the edge is where the circle is.
+            const float r45 = 12.0f * s / std::sqrt(2.0f);
+            t.Equals(alpha(at(out, n * s, 64.0f + r45 - 3.0f, 64.0f + r45 - 3.0f)), 255, "inside the circle on the diagonal");
+            t.Equals(alpha(at(out, n * s, 64.0f + r45 + 3.0f, 64.0f + r45 + 3.0f)), 0, "outside it");
+        });
+
+        tc.Run("pictures with many colours are left to Anime4K", [](TestCase &t) {
+            const int n = 32;
+            std::vector<uint32_t> src(size_t(n) * n);
+            for (int i = 0; i < n * n; ++i) // a gradient
+                src[size_t(i)] = 0xFF000000u | uint32_t(i % 256) | (uint32_t((i / 7) % 256) << 8) | (uint32_t((i * 3) % 256) << 16);
+            ga2_flatart::Classes cls;
+            t.IsFalse(ga2_flatart::classify(src.data(), n, n, cls), "a gradient is not flat art");
+            // A glow in a few steps (a soft dot in six shades): its regions meet between near colours.
+            std::vector<uint32_t> glow(size_t(n) * n, kClear);
+            for (int y = 0; y < n; ++y)
+                for (int x = 0; x < n; ++x)
+                {
+                    const int step = int(std::hypot(x + 0.5f - 16.0f, y + 0.5f - 16.0f) / 2.5f);
+                    if (step < 6)
+                        glow[size_t(y) * n + x] = 0xFF000000u | uint32_t(255 - step * 30) * 0x010101u;
+                }
+            t.IsFalse(ga2_flatart::classify(glow.data(), n, n, cls), "a stepped glow is not flat art");
+            std::vector<uint32_t> big(size_t(256) * 256, kWhite);
+            t.IsFalse(ga2_flatart::classify(big.data(), 256, 256, cls), "large pictures are not either");
+        });
+    });
+}
