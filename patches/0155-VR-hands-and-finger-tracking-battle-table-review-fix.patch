-        // Surfaces are handed out by pointer: never reallocate the pool.
+        // Surfaces are handed out by pointer: never reallocate the pool. When it is full (a chain run on textures
+        // of many sizes, like the per-layer upscaling of a battle's HUD), the free surface used longest ago is
+        // made again at the new size.
         if (m_pool.capacity() < 64)
             m_pool.reserve(64);
+        Surface *slot = nullptr;
         if (m_pool.size() == m_pool.capacity())
-            return nullptr;
+        {
+            for (Surface &s : m_pool)
+                if (!s.busy && (!slot || s.lastUse < slot->lastUse))
+                    slot = &s;
+            if (!slot)
+                return nullptr;
+            glDeleteFramebuffers(1, &slot->framebuffer);
+            glDeleteTextures(1, &slot->texture);
+        }
         Surface s;
         s.width = width;
         s.height = height;
+        s.lastUse = m_frame;
         glGenTextures(1, &s.texture);
         glBindTexture(GL_TEXTURE_2D, s.texture);
         glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA16F, width, height, 0, GL_RGBA, GL_FLOAT, nullptr);
@@ -285,6 +298,11 @@ namespace ga2_mpv
