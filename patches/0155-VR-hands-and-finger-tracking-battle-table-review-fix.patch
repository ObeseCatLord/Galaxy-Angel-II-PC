@@ -0,0 +1,143 @@
+#include "MiniTest.h"
+
+#include "ga2_vr_hand.h"
+
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace
+{
+    namespace hand = ga2_vr_hand;
+    namespace mesh = ga2_vr_hand_mesh_mobile;
+
+    void identity(float m[16])
+    {
+        for (int i = 0; i < 16; ++i)
+            m[i] = (i % 5 == 0) ? 1.0f : 0.0f;
+    }
+    void mul(const float *a, const float *b, float r[16])
+    {
+        for (int c = 0; c < 4; ++c)
+            for (int row = 0; row < 4; ++row)
+            {
+                float s = 0.0f;
+                for (int k = 0; k < 4; ++k)
+                    s += a[k * 4 + row] * b[c * 4 + k];
+                r[c * 4 + row] = s;
+            }
+    }
+    // A turn about y by `angle` and a move.
+    void turnMove(float angle, float x, float y, float z, float m[16])
+    {
+        identity(m);
+        m[0] = std::cos(angle), m[2] = -std::sin(angle);
+        m[8] = std::sin(angle), m[10] = std::cos(angle);
+        m[12] = x, m[13] = y, m[14] = z;
+    }
+    // The largest distance between a posed vertex and `expected` (pose positions, transformed by m, x mirrored).
+    float worst(const std::vector<float> &out, const float *expected, const float *m, bool mirror)
+    {
+        float most = 0.0f;
+        for (int v = 0; v < hand::kVertices; ++v)
+        {
+            float p[3] = {expected[v * 3] * (mirror ? -1.0f : 1.0f), expected[v * 3 + 1], expected[v * 3 + 2]}, q[3];
+            hand::transform(m, p, 1.0f, q);
+            for (int k = 0; k < 3; ++k)
+                most = std::max(most, std::fabs(out[size_t(v) * 6 + size_t(k)] - q[k]));
+        }
+        return most;
+    }
+}
+
+void register_ga2_vr_hand_tests()
+{
+    MiniTest::Case("VrHand", [](TestCase &tc) {
+        tc.Run("the mesh is complete: indices in range, weights summing to 1, joints in range", [](TestCase &t) {
+            bool indices = true, weights = true, joints = true;
+            for (int i = 0; i < hand::kIndices; ++i)
+                indices = indices && mesh::kIndexData[i] < hand::kVertices;
+            for (int v = 0; v < hand::kVertices; ++v)
+            {
+                float sum = 0.0f;
+                for (int i = 0; i < 4; ++i)
+                {
+                    sum += mesh::kJointWeight[v * 4 + i];
+                    joints = joints && mesh::kJointIndex[v * 4 + i] < hand::kJoints;
+                }
+                weights = weights && std::fabs(sum - 1.0f) < 1e-3f;
+            }
+            t.IsTrue(indices, "every index names a vertex");
+            t.IsTrue(weights, "every vertex's weights sum to 1");
+            t.IsTrue(joints, "every influence names one of the 26 joints");
+            t.Equals(hand::kIndices % 3, 0, "whole triangles");
+        });
+
+        tc.Run("tracked joints at the bind pose give pose 0, moved and turned with the hand", [](TestCase &t) {
+            const std::vector<float> local = hand::bindLocal();
+            std::vector<float> out(size_t(hand::kVertices) * 6);
+            float joints[hand::kJoints][16];
+            for (int j = 0; j < hand::kJoints; ++j)
+                std::memcpy(joints[j], mesh::kBindJoints[j], sizeof(joints[j]));
+            float id[16];
+            identity(id);
+            hand::skin(local, joints, false, out.data());
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPoseRelaxed], id, false) < 1e-4f, "the bind pose reproduces pose 0");
+            // The whole hand turned and moved: every joint by the same transform.
+            float tm[16];
+            turnMove(0.7f, 0.2f, -0.3f, -0.5f, tm);
+            for (int j = 0; j < hand::kJoints; ++j)
+                mul(tm, mesh::kBindJoints[j], joints[j]);
+            hand::skin(local, joints, false, out.data());
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPoseRelaxed], tm, false) < 1e-4f, "the hand follows a rigid move");
+        });
+
+        tc.Run("the left hand: the right hand's joints mirrored give the mirrored mesh", [](TestCase &t) {
+            const std::vector<float> local = hand::bindLocal();
+            std::vector<float> out(size_t(hand::kVertices) * 6);
+            // OpenXR's left-hand joint frames: the right's mirrored in world x with their own x flipped (S M S).
+            float s[16];
+            identity(s);
+            s[0] = -1.0f;
+            float joints[hand::kJoints][16], tmp[16];
+            for (int j = 0; j < hand::kJoints; ++j)
+            {
+                mul(s, mesh::kBindJoints[j], tmp);
+                mul(tmp, s, joints[j]);
+            }
+            hand::skin(local, joints, true, out.data());
+            float id[16];
+            identity(id);
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPoseRelaxed], id, true) < 1e-4f, "the left hand is the mirror image");
+            // Normals mirror too (x flips sign).
+            const float nx = out[3], ex = -mesh::kNormals[mesh::kPoseRelaxed][0];
+            t.IsTrue(std::fabs(nx - ex) < 1e-4f, "normals mirror with it");
+        });
+
+        tc.Run("fixed poses: trigger points, grip makes a fist, placed by the aim pose", [](TestCase &t) {
+            std::vector<float> out(size_t(hand::kVertices) * 6);
+            float place[16];
+            turnMove(-0.4f, 0.1f, 0.0f, -0.3f, place);
+            hand::posed(0.0f, 0.0f, place, false, out.data());
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPoseRelaxed], place, false) < 1e-5f, "rest: relaxed");
+            hand::posed(1.0f, 0.0f, place, false, out.data());
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPosePoint], place, false) < 1e-5f, "trigger: pointing");
+            hand::posed(1.0f, 1.0f, place, false, out.data());
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPoseFist], place, false) < 1e-5f, "grip: fist (whatever the trigger)");
+            hand::posed(1.0f, 0.0f, place, true, out.data());
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPosePoint], place, true) < 1e-5f, "the left hand mirrors x");
+            hand::posed(3.0f, -2.0f, place, false, out.data());
+            t.IsTrue(worst(out, mesh::kPositions[mesh::kPosePoint], place, false) < 1e-5f, "inputs are clamped");
+        });
+
+        tc.Run("the pointing index fingertip is at the aim point", [](TestCase &t) {
+            // The vertex furthest along -z in the pointing pose is the index fingertip: within 1.5 cm of the origin.
+            int tip = 0;
+            for (int v = 1; v < hand::kVertices; ++v)
+                if (mesh::kPositions[mesh::kPosePoint][v * 3 + 2] < mesh::kPositions[mesh::kPosePoint][tip * 3 + 2])
+                    tip = v;
+            const float *p = &mesh::kPositions[mesh::kPosePoint][tip * 3];
+            t.IsTrue(std::sqrt(p[0] * p[0] + p[1] * p[1] + p[2] * p[2]) < 0.015f, "fingertip at the aim point");
+        });
+    });
+}
