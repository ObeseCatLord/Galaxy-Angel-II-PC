+// HD redraws of flat-coloured HUD art (rings, discs, arrows, stars, digits, icons): a small texture made of a few
+// flat colours is split into its colour regions, and each region's outline is rebuilt as a smooth curve at the higher
+// resolution (the regions' masks smoothed with a cubic B-spline, the strongest region wins, edges anti-aliased over one
+// output pixel). Anime4K, which works on soft art, blurs and rings such shapes; this keeps them crisp. Works on what
+// the game draws at run time, so every variant (an HP ring at each fill) is redrawn.
+//
+// Pixels are RGBA (r in the low byte), alpha 255 = opaque.
+namespace ga2_flatart
+{
+    constexpr int kMaxColors = 10;
+    constexpr int kMaxSize = 128;
+
+    struct Classes
+    {
+        std::vector<uint32_t> colors;  // each region's colour (the mean of its pixels)
+        std::vector<uint8_t> labels;   // each pixel's region
+    };
+
+    inline int channel(uint32_t c, int k) { return int((c >> (8 * k)) & 255u); }
+
+    // The texture's few flat colours, false when it is not flat art: too large or small, or more than kMaxColors
+    // colours carrying it (anti-aliased edge pixels may be anything: they join the nearest colour).
+    inline bool classify(const uint32_t *rgba, int w, int h, Classes &out, int perTenThousand);
+    // Small accents (an HP ring's tick) are colours of their own when that stays within kMaxColors; otherwise only
+    // colours of at least 1.5 % of the pixels count.
+    inline bool classify(const uint32_t *rgba, int w, int h, Classes &out)
+    {
+        return classify(rgba, w, h, out, 25) || classify(rgba, w, h, out, 150);
+    }
+    inline bool classify(const uint32_t *rgba, int w, int h, Classes &out, int perTenThousand)
+    {
+        if (w < 8 || h < 8 || w > kMaxSize || h > kMaxSize)
+            return false;
+        const int n = w * h;
+        auto key = [](uint32_t c) -> uint32_t {
+            if (channel(c, 3) < 16)
+                return 0xFFFFFFFFu; // transparent, whatever its colour
+            return (uint32_t(channel(c, 0) >> 4)) | (uint32_t(channel(c, 1) >> 4) << 4) | (uint32_t(channel(c, 2) >> 4) << 8) |
+                   (uint32_t(channel(c, 3) >> 5) << 12);
+        };
+        std::vector<std::pair<uint32_t, int>> counts;
+        for (int i = 0; i < n; ++i)
+        {
+            const uint32_t k = key(rgba[i]);
+            auto it = std::find_if(counts.begin(), counts.end(), [&](const auto &p) { return p.first == k; });
+            if (it == counts.end())
+            {
+                if (counts.size() > 256)
+                    return false; // a photo or a gradient
+                counts.push_back({k, 1});
+            }
+            else
+                ++it->second;
+        }
+        std::sort(counts.begin(), counts.end(), [](const auto &a, const auto &b) { return a.second > b.second; });
+        const int minCount = std::max(2, n * perTenThousand / 10000);
+        std::vector<uint32_t> major;
+        int covered = 0;
+        for (const auto &[k, c] : counts)
+            if (c >= minCount)
+            {
+                major.push_back(k);
+                covered += c;
+            }
+        if (major.size() < 2 || major.size() > size_t(kMaxColors) || covered * 100 < n * 85)
+            return false;
+        // Each major colour's mean, then every pixel to the nearest.
+        std::vector<double> sum(major.size() * 4, 0.0);
+        std::vector<int> num(major.size(), 0);
+        for (int i = 0; i < n; ++i)
+        {
+            const uint32_t k = key(rgba[i]);
+            for (size_t m = 0; m < major.size(); ++m)
+                if (major[m] == k)
+                {
+                    for (int ch = 0; ch < 4; ++ch)
+                        sum[m * 4 + size_t(ch)] += channel(rgba[i], ch);
+                    ++num[m];
+                }
+        }
+        out.colors.assign(major.size(), 0u);
+        for (size_t m = 0; m < major.size(); ++m)
+        {
+            uint32_t c = 0;
+            for (int ch = 0; ch < 4; ++ch)
+                c |= uint32_t(std::lround(sum[m * 4 + size_t(ch)] / std::max(1, num[m]))) << (8 * ch);
+            if (major[m] == 0xFFFFFFFFu)
+                c = 0; // transparent
+            out.colors[m] = c;
+        }
+        out.labels.assign(size_t(n), 0);
+        for (int i = 0; i < n; ++i)
+        {
+            const uint32_t c = rgba[i];
+            int best = 0;
+            long bestD = -1;
+            for (size_t m = 0; m < major.size(); ++m)
+            {
+                const uint32_t q = out.colors[m];
+                // Against transparent only the alpha counts (a half-transparent edge pixel goes to the side its alpha
+                // is nearer).
+                long d = 0;
+                const long da = channel(c, 3) - channel(q, 3);
+                if (channel(q, 3) == 0)
+                    d = 4L * da * da; // with the opaque side's 4 * da^2: the split is at half alpha
+                else
+                {
+                    for (int ch = 0; ch < 3; ++ch)
+                        d += long(channel(c, ch) - channel(q, ch)) * (channel(c, ch) - channel(q, ch));
+                    d += 4L * da * da;
+                }
+                if (bestD < 0 || d < bestD)
+                    bestD = d, best = int(m);
+            }
+            out.labels[size_t(i)] = uint8_t(best);
+        }
+        // Flat art meets its regions at sharp edges between clearly different colours; a glow or a shaded ball made of
+        // a few steps meets them between near ones (a gradient): those stay with Anime4K.
+        auto near = [&](uint8_t a, uint8_t b) {
+            const uint32_t p = out.colors[a], q = out.colors[b];
+            const int da = std::abs(channel(p, 3) - channel(q, 3));
+            if (channel(p, 3) == 0 || channel(q, 3) == 0)
+                return da < 96;
+            int d = 0;
+            for (int ch = 0; ch < 3; ++ch)
+                d += (channel(p, ch) - channel(q, ch)) * (channel(p, ch) - channel(q, ch));
+            return d < 70 * 70 && da < 96;
+        };
+        int edges = 0, soft = 0;
+        for (int y = 0; y < h; ++y)
+            for (int x = 0; x < w; ++x)
+            {
+                const uint8_t l = out.labels[size_t(y) * size_t(w) + size_t(x)];
+                for (int k = 0; k < 2; ++k)
+                {
+                    const int nx = x + (k == 0), ny = y + (k == 1);
+                    if (nx >= w || ny >= h)
+                        continue;
+                    const uint8_t m = out.labels[size_t(ny) * size_t(w) + size_t(nx)];
+                    if (m == l)
+                        continue;
+                    ++edges;
+                    soft += near(l, m) ? 1 : 0;
+                }
+            }
+        return edges == 0 || soft * 100 < edges * 20;
+    }
+
+    // Cubic B-spline weights: smooth enough to round a pixel staircase into a curve, while a 1-pixel line still
+    // peaks at 2/3 (it keeps winning over its surroundings).
+    inline void bspline(float t, float w[4])
+    {
+        const float t2 = t * t, t3 = t2 * t, u = 1.0f - t;
+        w[0] = u * u * u / 6.0f;
+        w[1] = (3.0f * t3 - 6.0f * t2 + 4.0f) / 6.0f;
+        w[2] = (-3.0f * t3 + 3.0f * t2 + 3.0f * t + 1.0f) / 6.0f;
+        w[3] = t3 / 6.0f;
+    }
+
+    // Rings and discs drawn as true circles: when the shape (all but the background, the corners' colour) depends only
+    // on the distance from its centre, its edges are measured from the pixels (where the share of shape pixels crosses
+    // one half) and drawn exactly; each band's colour is read by angle at its middle radius (an HP ring's arc keeps
+    // its fill). false: not such a shape.
+    inline bool radialUpscale(const Classes &cls, int w, int h, int scale, std::vector<uint32_t> &out)
+    {
+        if (std::abs(w - h) > 2 || w < 12)
+            return false;
+        const uint8_t bg = cls.labels[0];
+        if (cls.labels[size_t(w - 1)] != bg || cls.labels[size_t(h - 1) * size_t(w)] != bg ||
+            cls.labels[size_t(h) * size_t(w) - 1] != bg)
+            return false;
+        // Shape: a colour other than the background's, and (against a transparent background) at least half opaque.
+        const uint32_t back = cls.colors[bg];
+        std::vector<uint8_t> shape(cls.colors.size(), 0);
+        for (size_t c = 0; c < cls.colors.size(); ++c)
+            shape[c] = c != bg && (channel(back, 3) >= 128 || channel(cls.colors[c], 3) >= 128);
+        int count = 0;
+        for (int y = 0; y < h; ++y)
+            for (int x = 0; x < w; ++x)
+                count += shape[cls.labels[size_t(y) * size_t(w) + size_t(x)]];
+        if (count < 16)
+            return false;
+        // The centre: the shape's bounding box middle (a ring's arc colours do not move it; the centroid of a
+        // partly drawn shape would).
+        int x0 = w, y0 = h, x1 = -1, y1 = -1;
+        for (int y = 0; y < h; ++y)
+            for (int x = 0; x < w; ++x)
+                if (shape[cls.labels[size_t(y) * size_t(w) + size_t(x)]])
+                    x0 = std::min(x0, x), x1 = std::max(x1, x), y0 = std::min(y0, y), y1 = std::max(y1, y);
+        const float cx = 0.5f * float(x0 + x1 + 1), cy = 0.5f * float(y0 + y1 + 1);
+        if (std::abs((x1 - x0) - (y1 - y0)) > 2)
+            return false;
+        // The share of shape pixels per half-pixel band of radius.
+        const int bins = int(std::ceil(std::hypot(float(w), float(h)) * 0.5f * 2.0f)) + 2;
+        std::vector<int> fg(size_t(bins), 0), all(size_t(bins), 0);
+        for (int y = 0; y < h; ++y)
+            for (int x = 0; x < w; ++x)
+            {
+                const int b = int(std::hypot(x + 0.5f - cx, y + 0.5f - cy) * 2.0f);
+                ++all[size_t(b)];
+                fg[size_t(b)] += shape[cls.labels[size_t(y) * size_t(w) + size_t(x)]];
+            }
+        // A radial shape: nearly every band is mostly one or the other.
+        int agree = 0, total = 0;
+        for (int b = 0; b < bins; ++b)
+        {
+            agree += std::max(fg[size_t(b)], all[size_t(b)] - fg[size_t(b)]);
+            total += all[size_t(b)];
+        }
+        if (agree * 100 < total * 93)
+            return false;
+        // The edges: radii where the share crosses one half.
+        std::vector<float> edges;
+        float last = 0.0f;
+        bool inside = false;
+        for (int b = 0; b < bins; ++b)
+        {
+            if (!all[size_t(b)])
+                continue;
+            const float share = float(fg[size_t(b)]) / float(all[size_t(b)]);
+            const bool now = share >= 0.5f;
+            if (now != inside && edges.empty() && now && b <= 1)
+            {
+                edges.push_back(-1e6f); // a filled centre: no inner edge
+                inside = true;
+            }
+            else if (now != inside)
+            {
+                // Between the last band's middle and this one's, where the share is one half.
+                const float r0 = (float(b) - 0.5f) * 0.5f, r1 = (float(b) + 0.5f) * 0.5f;
+                const float t = std::abs(share - last) > 1e-3f ? std::clamp((0.5f - last) / (share - last), 0.0f, 1.0f) : 0.5f;
+                edges.push_back(r0 + (r1 - r0) * t);
+                inside = now;
+            }
+            last = share;
+        }
+        if (inside)
+            edges.push_back(float(bins) * 0.5f);
+        if (edges.size() < 2 || edges.size() > 8)
+            return false;
+        const int W = w * scale, H = h * scale;
+        out.assign(size_t(W) * size_t(H), 0u);
+        const float px = 1.0f / float(scale); // an output pixel in source pixels
+        for (int Y = 0; Y < H; ++Y)
+            for (int X = 0; X < W; ++X)
+            {
+                const float x = (float(X) + 0.5f) * px, y = (float(Y) + 0.5f) * px;
+                const float r = std::hypot(x - cx, y - cy);
+                float cov = 0.0f, mid = 0.0f;
+                for (size_t e = 0; e + 1 < edges.size(); e += 2)
+                {
+                    const float a = edges[e], b = edges[e + 1];
+                    const float c = std::clamp((r - a) / px + 0.5f, 0.0f, 1.0f) * std::clamp((b - r) / px + 0.5f, 0.0f, 1.0f);
+                    const float m = 0.5f * (std::max(a, 0.0f) + b);
+                    if (c > cov || (cov == 0.0f && std::abs(r - m) < std::abs(r - mid)))
+                        mid = m;
+                    cov = std::max(cov, c);
+                }
+                // The band's colour at this angle, read at its middle radius.
+                const float len = std::max(r, 1e-4f);
+                const int sxp = std::clamp(int(cx + (x - cx) / len * mid), 0, w - 1), syp = std::clamp(int(cy + (y - cy) / len * mid), 0, h - 1);
+                uint8_t lab = cls.labels[size_t(syp) * size_t(w) + size_t(sxp)];
+                if (!shape[lab]) // a stray pixel on the band: a neighbour's
+                {
+                    for (int d = 1; d <= 2 && !shape[lab]; ++d)
+                        for (int k = 0; k < 4 && !shape[lab]; ++k)
+                        {
+                            const int nx = std::clamp(sxp + (k == 0 ? d : k == 1 ? -d : 0), 0, w - 1);
+                            const int ny = std::clamp(syp + (k == 2 ? d : k == 3 ? -d : 0), 0, h - 1);
+                            lab = cls.labels[size_t(ny) * size_t(w) + size_t(nx)];
+                        }
+                }
+                const uint32_t fore = shape[lab] ? cls.colors[lab] : back;
+                uint32_t pixel = 0;
+                for (int ch = 0; ch < 4; ++ch)
+                {
+                    float v;
+                    if (ch < 3 && channel(back, 3) == 0)
+                        v = float(channel(fore, ch));
+                    else
+                        v = float(channel(back, ch)) + (float(channel(fore, ch)) - float(channel(back, ch))) * cov;
+                    pixel |= uint32_t(std::clamp(int(std::lround(v)), 0, 255)) << (8 * ch);
+                }
+                out[size_t(Y) * size_t(W) + size_t(X)] = pixel;
+            }
+        return true;
+    }
+
+    // The redraw at `scale` times the size.
+    inline std::vector<uint32_t> upscale(const Classes &cls, int w, int h, int scale)
+    {
+        if (std::vector<uint32_t> round; radialUpscale(cls, w, h, scale, round))
+            return round;
+        const int W = w * scale, H = h * scale, k = int(cls.colors.size());
+        std::vector<uint32_t> out(size_t(W) * size_t(H));
+        for (int Y = 0; Y < H; ++Y)
+        {
+            const float sy = (float(Y) + 0.5f) / float(scale) - 0.5f;
+            const int iy = int(std::floor(sy));
+            float wy[4];
+            bspline(sy - float(iy), wy);
+            for (int X = 0; X < W; ++X)
+            {
+                const float sx = (float(X) + 0.5f) / float(scale) - 0.5f;
+                const int ix = int(std::floor(sx));
+                float wx[4];
+                bspline(sx - float(ix), wx);
+                float m[kMaxColors] = {};
+                for (int j = 0; j < 4; ++j)
+                {
+                    const int y = std::clamp(iy - 1 + j, 0, h - 1);
+                    for (int i = 0; i < 4; ++i)
+                    {
+                        const int x = std::clamp(ix - 1 + i, 0, w - 1);
+                        m[cls.labels[size_t(y) * size_t(w) + size_t(x)]] += wx[i] * wy[j];
+                    }
+                }
+                int a = 0, b = -1;
+                for (int c = 1; c < k; ++c)
+                    if (m[c] > m[a])
+                        a = c;
+                for (int c = 0; c < k; ++c)
+                    if (c != a && (b < 0 || m[c] > m[b]))
+                        b = c;
+                // The edge between the two strongest regions, anti-aliased over about one output pixel.
+                const float cov = std::clamp(0.5f + (m[a] - m[b]) * float(scale) * 0.5f, 0.0f, 1.0f);
+                const uint32_t ca = cls.colors[size_t(a)], cb = cls.colors[size_t(b)];
+                uint32_t px = 0;
+                const bool clearA = channel(ca, 3) == 0, clearB = channel(cb, 3) == 0;
+                for (int ch = 0; ch < 4; ++ch)
+                {
+                    float v;
+                    if (ch < 3 && clearB)
+                        v = float(channel(ca, ch));
+                    else if (ch < 3 && clearA)
+                        v = float(channel(cb, ch));
+                    else
+                        v = float(channel(cb, ch)) + (float(channel(ca, ch)) - float(channel(cb, ch))) * cov;
+                    px |= uint32_t(std::clamp(int(std::lround(v)), 0, 255)) << (8 * ch);
+                }
+                out[size_t(Y) * size_t(W) + size_t(X)] = px;
+            }
+        }
+        return out;
+    }
+}
