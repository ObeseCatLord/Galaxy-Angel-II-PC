diff --git a/ps2xRuntime/src/lib/ga2_battletable.cpp b/ps2xRuntime/src/lib/ga2_battletable.cpp
new file mode 100644
index 0000000..3f28288
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_battletable.cpp
@@ -0,0 +1,93 @@
+#include "runtime/ga2_battletable.h"
+
+#include <chrono>
+#include <cmath>
+#include <mutex>
+
+namespace ga2_battletable
+{
+    namespace
+    {
+        std::mutex g_mutex;
+        State g_state;
+        Pose g_pose;
+        std::chrono::steady_clock::time_point g_published{};
+    }
+
+    void toPlay(const Pose &p, float u, float v, float h, float out[3])
+    {
+        // u right, v away from the player (-z), turned by yaw about y.
+        const float c = std::cos(p.yaw), s = std::sin(p.yaw);
+        const float x = u, z = -v;
+        out[0] = p.center[0] + c * x + s * z;
+        out[1] = p.center[1] + h;
+        out[2] = p.center[2] - s * x + c * z;
+    }
+
+    void toTable(const Pose &p, const float q[3], float &u, float &v, float &h)
+    {
+        const float c = std::cos(p.yaw), s = std::sin(p.yaw);
+        const float dx = q[0] - p.center[0], dz = q[2] - p.center[2];
+        const float x = c * dx - s * dz, z = s * dx + c * dz;
+        u = x;
+        v = -z;
+        h = q[1] - p.center[1];
+    }
+
+    void tableToMap(const State &s, float u, float v, float &x, float &z)
+    {
+        x = s.cx + s.s * (u * s.rx + v * s.fx);
+        z = s.cz + s.s * (u * s.rz + v * s.fz);
+    }
+
+    void mapToTable(const State &s, float x, float z, float &u, float &v)
+    {
+        // r and f are orthonormal on the ground.
+        const float dx = (x - s.cx) / s.s, dz = (z - s.cz) / s.s;
+        u = dx * s.rx + dz * s.rz;
+        v = dx * s.fx + dz * s.fz;
+    }
+
+    bool mapToPicture(const State &s, float x, float z, float &pu, float &pv)
+    {
+        const float *M = s.M;
+        const float cx = x * M[0] + z * M[8] + M[12], cy = x * M[1] + z * M[9] + M[13];
+        const float cw = x * M[3] + z * M[11] + M[15];
+        if (!(cw > 1e-6f))
+            return false;
+        float sx = cx / cw - s.originX, sy = cy / cw - s.originY; // the 2D layer's 640 x 480 space
+        if (s.wide && s.k > 0.0f)
+            sx = 320.0f + (sx - 320.0f) / s.k; // the 3D picture is squeezed into the frame by k
+        pu = sx / 640.0f;
+        pv = sy / 480.0f;
+        return std::isfinite(pu) && std::isfinite(pv);
+    }
+
+    void publish(const State &state)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_state = state;
+        g_published = std::chrono::steady_clock::now();
+    }
+
+    State latest()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        State s = g_state;
+        if (std::chrono::steady_clock::now() - g_published > std::chrono::milliseconds(400))
+            s.active = false;
+        return s;
+    }
+
+    Pose pose()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        return g_pose;
+    }
+
+    void publishPose(const Pose &pose)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_pose = pose;
+    }
+}
