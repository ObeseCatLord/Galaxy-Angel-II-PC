@@ -543,6 +550,662 @@ void main() {
 
         // Draws sky, screen and lasers for one eye. view/proj: the eye; eye:
         // its position (for billboarding).
+        // ---- the battle table (ga2_battletable.h) ----------------------------------------------
+        // In VR with "VR battle selection" Hand the tactical map hovers flat in front of the player (after
+        // BattleGroupVR's radar): the game's own picture of the map, reprojected from its camera onto a horizontal
+        // table (exact for the ground, the unit icons lie on it), the units' icons standing over it as holographic
+        // discs on stalks, the order being dragged as a beam to its target, the whole picture (HUD, dialogue,
+        // menus) on a screen beyond the table, and the hands as translucent gloves.
+        const char *kTableVs = R"(#version 330
+layout(location = 0) in vec3 pos;
+layout(location = 1) in vec2 uv;
+layout(location = 2) in vec2 aux;
+uniform mat4 mvp;
+out vec2 v_uv;
+out vec2 v_aux;
+void main() { v_uv = uv; v_aux = aux; gl_Position = mvp * vec4(pos, 1.0); })";
+
+        // uv: the picture (0..1 of the 640 x 448 frame; outside: not visible); aux: the table, -1..1 on both axes.
+        const char *kTableFs = R"(#version 330
+in vec2 v_uv;
+in vec2 v_aux;
+uniform sampler2D tex;
+uniform vec2 extent;
+uniform float time;
+uniform vec4 masks[5]; // HUD rectangles in picture uv (x0, y0, x1, y1): shown on the screen beyond, not on the table
+out vec4 o;
+float box(vec2 p, vec4 r, float soft) {
+    vec2 a = smoothstep(r.xy - soft, r.xy, p) * (1.0 - smoothstep(r.zw, r.zw + soft, p));
+    return a.x * a.y;
+}
+void main()
+{
+    vec2 e = abs(v_aux);
+    float edge = max(e.x, e.y);
+    // Inside the picture (soft border) and outside the HUD.
+    vec2 inPic = smoothstep(vec2(0.0), vec2(0.03), v_uv) * (1.0 - smoothstep(vec2(0.97), vec2(1.0), v_uv));
+    float pic = inPic.x * inPic.y;
+    for (int i = 0; i < 5; ++i)
+        pic *= 1.0 - box(v_uv, masks[i], 0.01);
+    vec3 map = texture(tex, clamp(v_uv, 0.0, 1.0) * extent).rgb * 1.15;
+    // The plate: a dark blue glass with a glowing rim and a faint scan line drifting across.
+    float rim = smoothstep(0.93, 0.985, edge) * (1.0 - smoothstep(0.985, 1.0, edge));
+    float scan = 0.5 + 0.5 * sin((v_aux.y * 0.5 + 0.5 - fract(time * 0.12)) * 60.0);
+    float scanLine = smoothstep(0.985, 1.0, scan) * 0.08;
+    vec3 plate = vec3(0.02, 0.06, 0.14);
+    float fade = 1.0 - smoothstep(0.90, 0.97, edge);
+    vec3 col = mix(plate, map, pic * fade) + vec3(0.25, 0.6, 1.0) * (rim * 1.4 + scanLine);
+    float a = clamp(0.55 + 0.4 * pic * fade + rim, 0.0, 1.0);
+    o = vec4(col * a, a);
+})";
+
+        // A unit's icon from the picture, as a round holographic disc (uv 0..1 over the disc).
+        const char *kIconFs = R"(#version 330
+in vec2 v_uv;
+uniform sampler2D tex;
+uniform vec2 extent;
+uniform vec4 src; // picture uv: centre x, y, half size x, y
+uniform vec3 tint;
+uniform float glow;
+out vec4 o;
+void main()
+{
+    vec2 d = v_uv - 0.5;
+    float r = length(d) * 2.0;
+    if (r > 1.0) discard;
+    vec3 c = texture(tex, (src.xy + d * 2.0 * src.zw) * extent).rgb;
+    float ring = smoothstep(0.80, 0.90, r) * (1.0 - smoothstep(0.95, 1.0, r));
+    float a = 1.0 - smoothstep(0.92, 1.0, r);
+    vec3 col = c * (1.0 + glow * 0.3) + tint * ring * (1.0 + glow);
+    o = vec4(col * a, a);
+})";
+
+        // A solid additive colour (stalks, lines).
+        const char *kColorFs = R"(#version 330
+in vec2 v_uv;
+uniform vec4 color;
+out vec4 o;
+void main() { float a = 1.0 - smoothstep(0.6, 1.0, abs(v_uv.y * 2.0 - 1.0)); o = vec4(color.rgb * color.a * a, 0.0); })";
+
+        // The gloves: translucent, bright at the silhouette (fresnel), with a faint fill.
+        const char *kHandVs = R"(#version 330
+layout(location = 0) in vec3 pos;
+layout(location = 1) in vec3 nrm;
+uniform mat4 mvp;
+uniform vec3 eye;
+out vec3 v_n;
+out vec3 v_v;
+void main() { v_n = nrm; v_v = normalize(eye - pos); gl_Position = mvp * vec4(pos, 1.0); })";
+        const char *kHandFs = R"(#version 330
+in vec3 v_n;
+in vec3 v_v;
+uniform vec3 color;
+uniform float strength;
+out vec4 o;
+void main()
+{
+    float f = 1.0 - abs(dot(normalize(v_n), normalize(v_v)));
+    float rim = pow(f, 2.2);
+    vec3 c = color * (0.10 + rim * 0.95) * strength;
+    o = vec4(c, 0.0);
+})";
+
+        struct TableGl
+        {
+            GLuint table = 0, icon = 0, color = 0, hand = 0;
+            GLuint vao7 = 0, vbo7 = 0, vao6 = 0, vbo6 = 0;
+            bool ready = false;
+        } g_tableGl;
+
+        void initTableGl()
+        {
+            if (g_tableGl.ready)
+                return;
+            g_tableGl.table = compile(kTableVs, kTableFs, "table");
+            g_tableGl.icon = compile(kMeshVs, kIconFs, "table icon");
+            g_tableGl.color = compile(kMeshVs, kColorFs, "table line");
+            g_tableGl.hand = compile(kHandVs, kHandFs, "glove");
+            auto make = [](GLuint &vao, GLuint &vbo, std::initializer_list<int> sizes) {
+                glGenVertexArrays(1, &vao);
+                glGenBuffers(1, &vbo);
+                glBindVertexArray(vao);
+                glBindBuffer(GL_ARRAY_BUFFER, vbo);
+                int stride = 0;
+                for (int s : sizes)
+                    stride += s;
+                int offset = 0, index = 0;
+                for (int s : sizes)
+                {
+                    glEnableVertexAttribArray(GLuint(index));
+                    glVertexAttribPointer(GLuint(index), s, GL_FLOAT, GL_FALSE, stride * int(sizeof(float)),
+                                          reinterpret_cast<void *>(size_t(offset) * sizeof(float)));
+                    offset += s;
+                    ++index;
+                }
+                glBindVertexArray(0);
+            };
+            make(g_tableGl.vao7, g_tableGl.vbo7, {3, 2, 2});
+            make(g_tableGl.vao6, g_tableGl.vbo6, {3, 3});
+            // The glove program takes "nrm" at location 1 (compile() binds "uv" there; the layout qualifiers win).
+            g_tableGl.ready = true;
+        }
+
+        void drawArrays(GLuint vao, GLuint vbo, const std::vector<float> &data, int floatsPerVertex)
+        {
+            glBindVertexArray(vao);
+            glBindBuffer(GL_ARRAY_BUFFER, vbo);
+            glBufferData(GL_ARRAY_BUFFER, GLsizeiptr(sizeof(float) * data.size()), data.data(), GL_DYNAMIC_DRAW);
+            glDrawArrays(GL_TRIANGLES, 0, GLsizei(data.size() / size_t(floatsPerVertex)));
+        }
+
+        V3 playPoint(const ga2_battletable::Pose &pose, float u, float v, float h)
+        {
+            float p[3];
+            ga2_battletable::toPlay(pose, u, v, h, p);
+            return V3{p[0], p[1], p[2]};
+        }
+
+        // A thin camera-facing band from a to b (additive colour).
+        void drawLine(const M4 &viewProj, V3 eye, V3 a, V3 b, float width, V3 rgb, float alpha)
+        {
+            const V3 axis = b - a;
+            if (dot(axis, axis) < 1e-8f)
+                return;
+            const V3 side = normalize(cross(normalize(axis), normalize(eye - (a + b) * 0.5f))) * (width * 0.5f);
+            const V3 a0 = a - side, a1 = a + side, b0 = b - side, b1 = b + side;
+            const float q[30] = {a0.x, a0.y, a0.z, 0, 0, b0.x, b0.y, b0.z, 1, 0, b1.x, b1.y, b1.z, 1, 1,
+                                 a0.x, a0.y, a0.z, 0, 0, b1.x, b1.y, b1.z, 1, 1, a1.x, a1.y, a1.z, 0, 1};
+            glUseProgram(g_tableGl.color);
+            setMatrix(g_tableGl.color, "mvp", viewProj);
+            glUniform4f(glGetUniformLocation(g_tableGl.color, "color"), rgb.x, rgb.y, rgb.z, alpha);
+            drawMesh(q, 6);
+        }
+
+        // A flat ring on the table (the cursor program's hologram ring), centre c, radius r.
+        void drawTableRing(const M4 &viewProj, const ga2_battletable::Pose &pose, float u, float v, float r, float strength,
+                           float time)
+        {
+            const V3 c = playPoint(pose, u, v, 0.004f);
+            const V3 ux = playPoint(pose, u + r, v, 0.004f) - c, vy = playPoint(pose, u, v + r, 0.004f) - c;
+            glUseProgram(g_gl.cursor);
+            setMatrix(g_gl.cursor, "mvp", viewProj);
+            glUniform1f(glGetUniformLocation(g_gl.cursor, "time"), time);
+            glUniform1f(glGetUniformLocation(g_gl.cursor, "strength"), strength);
+            rect(c, ux, vy, false);
+        }
+
+        // ---- the gloves ----
+        // A hand from capsule-like segments in the aim pose's frame (x right, y up, -z forward; metres). The palm
+        // stands vertical with the knuckle row along -y (the index on top), as a hand holds a controller; fingers
+        // curl toward the palm side (-x for the right hand, +x for the left). curl: index, middle, ring, pinky, thumb
+        // (radians per joint).
+        void appendSegment(std::vector<float> &out, const M4 &frame, V3 a, V3 b, float ra, float rb)
+        {
+            constexpr int kSides = 12;
+            const V3 axis = b - a;
+            const float len = std::sqrt(dot(axis, axis));
+            if (len < 1e-5f)
+                return;
+            const V3 d = axis * (1.0f / len);
+            const V3 up = std::fabs(d.y) > 0.9f ? V3{1, 0, 0} : V3{0, 1, 0};
+            const V3 s1 = normalize(cross(d, up)), s2 = cross(s1, d);
+            auto world = [&](V3 p) {
+                return V3{frame.m[0] * p.x + frame.m[4] * p.y + frame.m[8] * p.z + frame.m[12],
+                          frame.m[1] * p.x + frame.m[5] * p.y + frame.m[9] * p.z + frame.m[13],
+                          frame.m[2] * p.x + frame.m[6] * p.y + frame.m[10] * p.z + frame.m[14]};
+            };
+            auto dir = [&](V3 n) {
+                return V3{frame.m[0] * n.x + frame.m[4] * n.y + frame.m[8] * n.z, frame.m[1] * n.x + frame.m[5] * n.y + frame.m[9] * n.z,
+                          frame.m[2] * n.x + frame.m[6] * n.y + frame.m[10] * n.z};
+            };
+            auto push = [&](V3 p, V3 n) {
+                const V3 wp = world(p), wn = dir(n);
+                out.insert(out.end(), {wp.x, wp.y, wp.z, wn.x, wn.y, wn.z});
+            };
+            for (int i = 0; i < kSides; ++i)
+            {
+                const float t0 = 6.2831853f * float(i) / kSides, t1 = 6.2831853f * float(i + 1) / kSides;
+                const V3 n0 = s1 * std::cos(t0) + s2 * std::sin(t0), n1 = s1 * std::cos(t1) + s2 * std::sin(t1);
+                const V3 p0 = a + n0 * ra, p1 = a + n1 * ra, q0 = b + n0 * rb, q1 = b + n1 * rb;
+                push(p0, n0), push(q0, n0), push(q1, n1);
+                push(p0, n0), push(q1, n1), push(p1, n1);
+                // Caps: a cone at each end (rounded look from the fresnel).
+                const V3 tipB = b + d * rb, tipA = a - d * ra;
+                push(q0, n0 * 0.5f + d * 0.5f), push(tipB, d), push(q1, n1 * 0.5f + d * 0.5f);
+                push(p1, n1 * 0.5f - d * 0.5f), push(tipA, d * -1.0f), push(p0, n0 * 0.5f - d * 0.5f);
+            }
+        }
+
+        // A finger: base point, the straight direction, the curl axis, joint lengths, curl per joint.
+        void appendFinger(std::vector<float> &out, const M4 &frame, V3 base, V3 straight, V3 axis, const float *lengths,
+                          float radius, float curl)
+        {
+            V3 p = base, d = straight;
+            for (int j = 0; j < 3; ++j)
+            {
+                // Rotate d about axis by curl (Rodrigues).
+                const float c = std::cos(curl), s = std::sin(curl);
+                d = d * c + cross(axis, d) * s + axis * (dot(axis, d) * (1.0f - c));
+                const V3 q = p + d * lengths[j];
+                const float r0 = radius * (1.0f - 0.12f * float(j)), r1 = radius * (1.0f - 0.12f * float(j + 1));
+                appendSegment(out, frame, p, q, r0, r1);
+                p = q;
+            }
+        }
+
+        void drawGlove(const M4 &viewProj, V3 eye, const M4 &aimPose, bool left, float trigger, float grip, bool grabbing,
+                       float strength)
+        {
+            // The aim pose sits at the controller's tip: the knuckles 9 cm behind it, so the pointing index finger
+            // ends about there (where the pointer is).
+            const float side = left ? 1.0f : -1.0f; // the palm side along x
+            const V3 axis{0, side > 0 ? -1.0f : 1.0f, 0}; // curling turns -z toward the palm side
+            const V3 fwd{0, 0, -1};
+            const float point = std::clamp((trigger - 0.1f) / 0.6f, 0.0f, 1.0f);
+            const float fist = std::clamp((grip - 0.1f) / 0.6f, 0.0f, 1.0f);
+            // Rest: a relaxed open hand; trigger: point (index straight, the rest curled); grip: a fist.
+            auto mix = [](float a, float b, float t) { return a + (b - a) * t; };
+            const float relaxed = 0.22f, curled = 0.62f;
+            float curlIndex = mix(relaxed, 0.04f, point), curlOthers = mix(relaxed, curled, point);
+            curlIndex = mix(curlIndex, curled, fist);
+            curlOthers = mix(curlOthers, curled + 0.05f, fist);
+            const float curlThumb = mix(mix(0.25f, 0.55f, point), 0.6f, fist);
+            std::vector<float> mesh;
+            mesh.reserve(6 * 8 * 12 * 18);
+            const float k = -0.09f; // knuckle row z (behind the aim point)
+            // Palm: from the wrist to the knuckles, as two broad segments.
+            // Palm: a flat hand is three slim bones side by side from the wrist to the knuckles.
+            for (int b = 0; b < 3; ++b)
+            {
+                const float y0 = -0.006f - 0.016f * float(b), y1 = 0.012f - 0.022f * float(b);
+                appendSegment(mesh, aimPose, V3{side * 0.004f, y0, k + 0.078f}, V3{side * 0.002f, y1, k + 0.006f}, 0.0125f, 0.0135f);
+            }
+            appendSegment(mesh, aimPose, V3{side * 0.004f, -0.020f, k + 0.090f}, V3{side * 0.004f, -0.020f, k + 0.070f}, 0.016f, 0.017f); // wrist
+            const float lengths[4][3] = {{0.040f, 0.024f, 0.020f}, {0.044f, 0.027f, 0.021f}, {0.041f, 0.025f, 0.020f}, {0.032f, 0.019f, 0.018f}};
+            for (int f = 0; f < 4; ++f)
+            {
+                const V3 base{0.0f, 0.020f - 0.017f * float(f), k - 0.004f * float(f == 1)};
+                appendFinger(mesh, aimPose, base, fwd, axis, lengths[f], f == 3 ? 0.0075f : 0.0088f, f == 0 ? curlIndex : curlOthers);
+            }
+            // Thumb: from the palm's top, toward the front and the palm side.
+            {
+                const V3 base{side * 0.016f, 0.024f, k + 0.045f};
+                const V3 straight = normalize(V3{side * 0.45f, 0.35f, -0.82f});
+                const float tl[3] = {0.034f, 0.026f, 0.020f};
+                appendFinger(mesh, aimPose, base, straight, normalize(V3{0, 1, 0.3f}) * (side > 0 ? -1.0f : 1.0f), tl, 0.0095f,
+                             curlThumb);
+            }
+            glUseProgram(g_tableGl.hand);
+            setMatrix(g_tableGl.hand, "mvp", viewProj);
+            glUniform3f(glGetUniformLocation(g_tableGl.hand, "eye"), eye.x, eye.y, eye.z);
+            // Blue gloves, orange while grabbing (BattleGroupVR's colours).
+            if (grabbing)
+                glUniform3f(glGetUniformLocation(g_tableGl.hand, "color"), 1.0f, 0.55f, 0.15f);
+            else
+                glUniform3f(glGetUniformLocation(g_tableGl.hand, "color"), 0.30f, 0.65f, 1.0f);
+            glUniform1f(glGetUniformLocation(g_tableGl.hand, "strength"), strength);
+            drawArrays(g_tableGl.vao6, g_tableGl.vbo6, mesh, 6);
+        }
+
+        struct TableView
+        {
+            bool active = false;
+            ga2_battletable::State state;
+            ga2_battletable::Pose pose;
+            M4 aim[2];
+            bool aimValid[2] = {false, false};
+            float trigger[2] = {0, 0}, grip[2] = {0, 0};
+            bool grabbing[2] = {false, false};
+        } g_tableView;
+
+        // The HUD of the battle map in the 2D layer (picture uv): the radar, the clock, the unit panel, the pilot's
+        // portrait and the angel list; they stay on the screen beyond the table.
+        void tableMasks(bool wide, float out[20])
+        {
+            (void)wide;
+            const float r[5][4] = {{0.00f, 0.00f, 0.20f, 0.33f}, {0.79f, 0.00f, 1.00f, 0.10f}, {0.70f, 0.78f, 1.00f, 1.00f},
+                                   {0.00f, 0.74f, 0.16f, 1.00f}, {-1.0f, -1.0f, -1.0f, -1.0f}};
+            std::memcpy(out, r, sizeof(r));
+        }
+
+        // The guide's panel and the table's "?" (with the guide's code below).
+        constexpr int kGuideWidth = 1024, kGuideHeight = 448;
+        void drawGuide(const M4 &viewProj, V3 eye, V3 centre, V3 right, V3 up, float time);
+        V3 tableHelpPoint(const ga2_battletable::Pose &pose);
+
+        void drawTable(const M4 &viewProj, V3 eye, GLuint picture, float extentX, float extentY, bool wide, float time)
+        {
+            initTableGl();
+            const TableView &tv = g_tableView;
+            const ga2_battletable::State &st = tv.state;
+            const ga2_battletable::Pose &pose = tv.pose;
+
+            // The full picture on a screen beyond the table (HUD, dialogue, the game's menus).
+            {
+                const ScreenGeometry s = screenGeometry(wide);
+                const float scale = 0.55f;
+                const V3 c = playPoint(pose, 0.0f, pose.halfDepth + 1.6f, 0.75f);
+                const V3 right = playPoint(pose, 1.0f, pose.halfDepth + 1.6f, 0.75f) - c;
+                glUseProgram(g_gl.quad);
+                setMatrix(g_gl.quad, "mvp", viewProj);
+                glBindTexture(GL_TEXTURE_2D, picture);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+                glUniform1i(glGetUniformLocation(g_gl.quad, "tex"), 0);
+                glUniform2f(glGetUniformLocation(g_gl.quad, "extent"), extentX, extentY);
+                rect(c, right * (s.halfWidth * scale), V3{0, s.halfHeight * scale, 0}, false);
+            }
+
+            // The table: a grid of vertices over it, each with its map point's place in the picture.
+            constexpr int kU = 48, kV = 32;
+            std::vector<float> mesh;
+            mesh.reserve(size_t(kU) * kV * 6 * 7);
+            auto vertex = [&](int i, int j) {
+                const float a = -1.0f + 2.0f * float(i) / kU, b = -1.0f + 2.0f * float(j) / kV;
+                const float u = a * pose.halfWidth, v = b * pose.halfDepth;
+                const V3 p = playPoint(pose, u, v, 0.0f);
+                float x = 0, z = 0, pu = -1, pv = -1;
+                ga2_battletable::tableToMap(st, u, v, x, z);
+                if (!ga2_battletable::mapToPicture(st, x, z, pu, pv))
+                    pu = pv = -1.0f;
+                mesh.insert(mesh.end(), {p.x, p.y, p.z, pu, pv, a, b});
+            };
+            for (int j = 0; j < kV; ++j)
+                for (int i = 0; i < kU; ++i)
+                {
+                    vertex(i, j), vertex(i + 1, j), vertex(i + 1, j + 1);
+                    vertex(i, j), vertex(i + 1, j + 1), vertex(i, j + 1);
+                }
+            glEnable(GL_BLEND);
+            glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+            glDepthMask(GL_FALSE);
+            glUseProgram(g_tableGl.table);
+            setMatrix(g_tableGl.table, "mvp", viewProj);
+            glBindTexture(GL_TEXTURE_2D, picture);
+            glUniform1i(glGetUniformLocation(g_tableGl.table, "tex"), 0);
+            glUniform2f(glGetUniformLocation(g_tableGl.table, "extent"), extentX, extentY);
+            glUniform1f(glGetUniformLocation(g_tableGl.table, "time"), time);
+            float masks[20];
+            tableMasks(wide, masks);
+            glUniform4fv(glGetUniformLocation(g_tableGl.table, "masks"), 5, masks);
+            drawArrays(g_tableGl.vao7, g_tableGl.vbo7, mesh, 7);
+
+            // The units: a ring on the table, a stalk and the icon as a disc over it (facing the player).
+            glBlendFunc(GL_ONE, GL_ONE);
+            for (int n = 0; n < st.unitCount; ++n)
+            {
+                const ga2_battletable::Unit &unit = st.units[n];
+                float u = 0, v = 0;
+                ga2_battletable::mapToTable(st, unit.x, unit.z, u, v);
+                if (std::fabs(u) > pose.halfWidth * 0.97f || std::fabs(v) > pose.halfDepth * 0.97f)
+                    continue;
+                const float lift = unit.hovered ? 0.075f : 0.06f;
+                const V3 foot = playPoint(pose, u, v, 0.002f), head = playPoint(pose, u, v, lift);
+                const V3 tint = unit.focused ? V3{1.0f, 0.6f, 0.2f} : V3{0.3f, 0.7f, 1.0f};
+                drawLine(viewProj, eye, foot, head, 0.003f, tint, unit.hovered ? 0.9f : 0.45f);
+                drawTableRing(viewProj, pose, u, v, unit.hovered ? 0.028f : 0.018f, unit.hovered ? 1.0f : 0.5f, time);
+                // The icon disc, a billboard turned toward the eye about the vertical.
+                glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+                glUseProgram(g_tableGl.icon);
+                setMatrix(g_tableGl.icon, "mvp", viewProj);
+                glUniform2f(glGetUniformLocation(g_tableGl.icon, "extent"), extentX, extentY);
+                const float iconHalf = 24.0f;
+                glUniform4f(glGetUniformLocation(g_tableGl.icon, "src"), unit.sx / 640.0f, unit.sy / 480.0f, iconHalf / 640.0f,
+                            iconHalf / 480.0f);
+                glUniform3f(glGetUniformLocation(g_tableGl.icon, "tint"), tint.x, tint.y, tint.z);
+                glUniform1f(glGetUniformLocation(g_tableGl.icon, "glow"), unit.hovered ? 1.0f : 0.0f);
+                const V3 toEye = eye - head;
+                const V3 flat = normalize(V3{toEye.x, 0.0f, toEye.z});
+                const V3 right = normalize(cross(V3{0, 1, 0}, flat));
+                const float size = unit.hovered ? 0.030f : 0.022f;
+                rect(head + V3{0, size, 0}, right * size, V3{0, size, 0}, false);
+                glBlendFunc(GL_ONE, GL_ONE);
+            }
+
+            // The order being dragged: a beam from the hand's fingertip to the target, a ring there.
+            if (st.drag)
+            {
+                const int h = std::clamp(st.dragHand, 0, 1);
+                float u = 0, v = 0;
+                ga2_battletable::mapToTable(st, st.dragX, st.dragZ, u, v);
+                const V3 target = playPoint(pose, u, v, 0.003f);
+                const ga2_battletable::Hand &hand = pose.hands[h];
+                if (hand.valid)
+                    drawLine(viewProj, eye, V3{hand.tip[0], hand.tip[1], hand.tip[2]}, target, 0.006f, V3{0.35f, 0.75f, 1.0f},
+                             0.9f);
+                drawTableRing(viewProj, pose, u, v, 0.03f + 0.006f * std::sin(time * 8.0f), 1.0f, time);
+            }
+
+            // The "?" that replays the battle part of the guide.
+            {
+                const V3 q = tableHelpPoint(pose);
+                const V3 toEye = normalize(eye - q);
+                const V3 u = normalize(cross(V3{0, 1, 0}, toEye)), v = normalize(cross(toEye, u));
+                glUseProgram(g_gl.cursor);
+                setMatrix(g_gl.cursor, "mvp", viewProj);
+                glUniform1f(glGetUniformLocation(g_gl.cursor, "time"), time);
+                glUniform1f(glGetUniformLocation(g_gl.cursor, "strength"), 0.8f);
+                rect(q, u * 0.022f, v * 0.022f, false);
+                drawLine(viewProj, eye, q + V3{0, -0.006f, 0}, q + V3{0, 0.004f, 0}, 0.003f, V3{0.5f, 0.85f, 1.0f}, 1.0f);
+                drawLine(viewProj, eye, q + V3{0, 0.008f, 0}, q + V3{0, 0.010f, 0}, 0.003f, V3{0.5f, 0.85f, 1.0f}, 1.0f);
+            }
+            {
+                const V3 c = playPoint(pose, -pose.halfWidth * 0.55f, pose.halfDepth + 0.05f, 0.32f);
+                const V3 toEye = eye - c;
+                const V3 flat = normalize(V3{toEye.x, 0.0f, toEye.z});
+                const V3 right = normalize(cross(V3{0, 1, 0}, flat));
+                const float h = 0.16f, w = h * float(kGuideWidth) / float(kGuideHeight);
+                drawGuide(viewProj, eye, c, right * w, V3{0, h, 0}, time);
+                glEnable(GL_BLEND);
+                glBlendFunc(GL_ONE, GL_ONE);
+                glDepthMask(GL_FALSE);
+            }
+            // The gloves.
+            for (int h = 0; h < 2; ++h)
+                if (tv.aimValid[h])
+                    drawGlove(viewProj, eye, tv.aim[h], h == 0, tv.trigger[h], tv.grip[h], tv.grabbing[h], 1.0f);
+            glDepthMask(GL_TRUE);
+            glDisable(GL_BLEND);
+        }
+
+        // ---- the VR guide (ga2_vrguide.h) -------------------------------------------------------
+        ga2_vrguide::Guide g_guide;
+        ga2_vrguide::Card g_guideCard;
+        struct GuideFrame
+        {
+            ga2_vr_input::Inputs in; // this frame's sampled controls
+            bool recentered = false, pointerHit = false;
+            float grabMoved = 0.0f, zoomChange = 0.0f, twist = 0.0f;
+            bool replayBattle = false;
+        } g_guideFrame;
+        GLuint g_guideTexture = 0;
+
+        // The card as an image (raylib, the UI font): a holographic panel with the title, the step and its dots.
+        GLuint renderGuide(const ga2_vrguide::Card &card, bool japanese)
+        {
+            static RenderTexture2D target{};
+            if (!target.id)
+            {
+                target = LoadRenderTexture(kGuideWidth, kGuideHeight);
+                SetTextureFilter(target.texture, TEXTURE_FILTER_BILINEAR);
+            }
+            if (!target.id)
+                return 0;
+            rlDrawRenderBatchActive();
+            BeginTextureMode(target);
+            rlEnableColorBlend();
+            ClearBackground(BLANK);
+            rlSetBlendFactorsSeparate(RL_SRC_ALPHA, RL_ONE_MINUS_SRC_ALPHA, RL_ONE, RL_ONE_MINUS_SRC_ALPHA, RL_FUNC_ADD, RL_FUNC_ADD);
+            BeginBlendMode(BLEND_CUSTOM_SEPARATE);
+            const Rectangle panel{8, 8, float(kGuideWidth - 16), float(kGuideHeight - 16)};
+            DrawRectangleRounded(panel, 0.08f, 12, Color{8, 22, 48, 240});
+            DrawRectangleRoundedLinesEx(panel, 0.08f, 12, 4.0f, Color{90, 180, 255, 255});
+            const Color cyan{120, 200, 255, 255}, white{235, 242, 255, 255}, dim{150, 170, 200, 255};
+            ga2_ui_font::draw(card.title, 40.0f, 28.0f, 46.0f, cyan);
+            // The body, wrapped to the panel (at spaces; anywhere in Japanese).
+            const float size = 34.0f, width = float(kGuideWidth) - 80.0f;
+            float y = 96.0f;
+            std::string line, word;
+            auto flush = [&] {
+                if (!line.empty())
+                    ga2_ui_font::draw(line, 40.0f, y, size, white);
+                y += size * 1.3f;
+                line.clear();
+            };
+            const std::string &body = card.body;
+            for (size_t i = 0; i <= body.size(); ++i)
+            {
+                const bool end = i == body.size();
+                const unsigned char c = end ? 0 : static_cast<unsigned char>(body[i]);
+                if (end || c == ' ' || c == '\n' || (c >= 0xE0 && japanese))
+                {
+                    // A word ends here (a Japanese character is a word of its own).
+                    std::string next = line.empty() ? word : line + (line.back() == ' ' || japanese ? "" : " ") + word;
+                    if (!word.empty() && ga2_ui_font::measure(next, size) > width)
+                    {
+                        flush();
+                        next = word;
+                    }
+                    line = next;
+                    word.clear();
+                    if (c == '\n')
+                        flush();
+                    if (!end && c >= 0xE0 && japanese)
+                    {
+                        // Take the whole UTF-8 character as the next word.
+                        const size_t n = c >= 0xF0 ? 4 : 3;
+                        word = body.substr(i, n);
+                        i += n - 1;
+                    }
+                }
+                else
+                    word += char(c);
