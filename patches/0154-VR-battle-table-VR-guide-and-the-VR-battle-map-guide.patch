+        // The card's panel (corners a..d from its centre and half axes) and the markers on the gloves.
+        void drawGuide(const M4 &viewProj, V3 eye, V3 centre, V3 right, V3 up, float time)
+        {
+            if (!g_guideCard.visible || !g_guideTexture)
+                return;
+            initTableGl();
+            glEnable(GL_BLEND);
+            glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+            glDepthMask(GL_FALSE);
+            glUseProgram(g_gl.menu); // straight alpha image, premultiplied in the shader
+            setMatrix(g_gl.menu, "mvp", viewProj);
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, g_guideTexture);
+            glUniform1i(glGetUniformLocation(g_gl.menu, "tex"), 0);
+            rect(centre, right, up, true);
+            // Markers: a pulsing ring on the control, and a guide line from the panel to it.
+            glBlendFunc(GL_ONE, GL_ONE);
+            for (int h = 0; h < 2; ++h)
+            {
+                V3 local;
+                if (!g_tableView.aimValid[h] || !guideMarker(g_guideCard.target, h, local))
+                    continue;
+                const M4 &a = g_tableView.aim[h];
+                const V3 p{a.m[0] * local.x + a.m[4] * local.y + a.m[8] * local.z + a.m[12],
+                           a.m[1] * local.x + a.m[5] * local.y + a.m[9] * local.z + a.m[13],
+                           a.m[2] * local.x + a.m[6] * local.y + a.m[10] * local.z + a.m[14]};
+                const V3 toEye = normalize(eye - p);
+                const V3 u = normalize(cross(V3{0, 1, 0}, toEye)), v = normalize(cross(toEye, u));
+                const float r = 0.016f * (1.0f + 0.25f * std::sin(time * 6.0f));
+                glUseProgram(g_gl.cursor);
+                setMatrix(g_gl.cursor, "mvp", viewProj);
+                glUniform1f(glGetUniformLocation(g_gl.cursor, "time"), time);
+                glUniform1f(glGetUniformLocation(g_gl.cursor, "strength"), 1.0f);
+                rect(p + toEye * 0.01f, u * r, v * r, false);
+                drawLine(viewProj, eye, centre - up * 0.9f, p, 0.002f, V3{0.4f, 0.8f, 1.0f}, 0.5f);
+            }
+            glDepthMask(GL_TRUE);
+            glDisable(GL_BLEND);
+        }
