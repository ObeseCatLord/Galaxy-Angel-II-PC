+        // Once per headset frame: feed the guide, re-render its card when it changes, keep the option current.
+        void updateGuide(bool stereo)
+        {
+            const ga2_battletable::State &st = g_tableView.state;
+            ga2_vrguide::Inputs gi;
+            gi.table = g_tableView.active;
+            gi.theater = !g_tableView.active && !stereo;
+            gi.pointerOnScreen = g_guideFrame.pointerHit;
+            gi.trigger = std::max(g_tableView.trigger[0], g_tableView.trigger[1]) > 0.6f;
+            const ga2_vr_input::Inputs &in = g_guideFrame.in;
+            gi.a = in.circle, gi.b = in.cross, gi.x = in.square, gi.y = in.triangle, gi.menu = in.menu;
+            gi.recentered = g_guideFrame.recentered;
+            gi.grabMoved = g_guideFrame.grabMoved;
+            gi.zoomChange = g_guideFrame.zoomChange;
+            gi.twist = g_guideFrame.twist;
+            for (int n = 0; gi.table && n < st.unitCount; ++n)
+                gi.hover = gi.hover || st.units[n].hovered;
+            gi.presses = st.presses;
+            gi.orders = st.orders;
+            gi.gates = gi.table ? st.gates : uint32_t(ga2_vrguide::GateAllActions);
+            gi.state = ga2_settings::get(ga2_options::VrGuide);
+            gi.replayBattle = g_guideFrame.replayBattle;
+            g_guideFrame.replayBattle = false;
+            const bool japanese = std::strcmp(ga2_settings::value(ga2_options::Language), "ja") == 0;
+            const ga2_vrguide::Card card = g_guide.step(gi, GetTime(), japanese);
+            if (g_guide.state() != gi.state)
+                ga2_settings::set(ga2_options::VrGuide, g_guide.state());
+            static std::string shown;
+            const std::string key = card.visible ? card.title + "\n" + card.body + "\n" + std::to_string(card.step) : std::string();
+            if (!card.visible)
+                g_guideTexture = 0;
+            else if (key != shown || !g_guideTexture)
+            {
+                g_guideTexture = renderGuide(card, japanese);
+                if (g_guideTexture)
+                {
+                    glBindTexture(GL_TEXTURE_2D, g_guideTexture);
+                    glGenerateMipmap(GL_TEXTURE_2D);
+                    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+                }
+            }
+            shown = key;
+            g_guideCard = card;
+        }
