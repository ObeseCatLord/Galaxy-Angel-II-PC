diff --git a/ps2xRuntime/src/lib/ga2_vrguide.h b/ps2xRuntime/src/lib/ga2_vrguide.h
new file mode 100644
index 0000000..44b207c
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_vrguide.h
@@ -0,0 +1,325 @@
+#pragma once
+
+// The VR guide (pure: no OpenXR, no GL; ga2_vr feeds it and draws its card). An interactive guide to the VR
+// controls in two parts, each step done by doing it (after BattleGroupVR's tutorial: a card with the step and a
+// pulsing marker on the control to use):
+//   - Basics, on the theater screen: pointing, clicking, the face and menu buttons, recentring;
+//   - Battle, at the battle table: grabbing, zooming and turning the map, hovering, selecting, drag orders and
+//     the other battle buttons.
+// While the game's own battle tutorial runs (it enables only the buttons it teaches, its "gates"), a card says
+// how to do in VR what it asks for, in place of its pad buttons. Holding B skips the current part. Where each part
+// stands is the option "VR guide" (vr_guide: show / battle / basics / done); "Show again" replays both.
+#include <cstdint>
+#include <string>
+
+namespace ga2_vrguide
+{
+    // What the marker points at.
+    enum class Target : uint8_t
+    {
+        None,
+        Trigger,
+        Grip,
+        BothGrips,
+        A,
+        B,
+        X,
+        Y,
+        Menu,
+        Sticks,
+        Screen,
+    };
+
+    enum class Part : uint8_t
+    {
+        None,
+        Basics,
+        Battle,
+        GameTutorial,
+    };
+
+    // The game's tutorial gates as actions (ga2_battletable::State::gates).
+    enum Gate : uint32_t
+    {
+        GateSelect = 1u << 0,    // Circle
+        GateCancel = 1u << 1,    // Cross
+        GatePan = 1u << 2,       // the D-pad scroll
+        GateZoom = 1u << 3,      // R1 / R2 camera height
+        GateAll = 1u << 4,       // Square (order all angels)
+        GateHWeapon = 1u << 5,   // Triangle
+        GateCockpit = 1u << 6,   // L3
+        GateUnitCam = 1u << 7,   // R3
+        GateStart = 1u << 8,     // Start
+        GateAngelList = 1u << 9, // L2
+        GateAllActions = (1u << 10) - 1u,
+    };
+
+    // Option vr_guide's choices.
+    enum State : int
+    {
+        Show = 0,   // both parts to come
+        Battle = 1, // the battle part to come
+        Basics = 2, // the basics to come
+        Done = 3,
+    };
+
+    struct Inputs
+    {
+        bool theater = false, table = false; // where the player is
+        bool pointerOnScreen = false;
+        bool trigger = false;                           // either trigger held
+        bool a = false, b = false, x = false, y = false; // held
+        bool menu = false;
+        bool recentered = false;  // this frame
+        float grabMoved = 0.0f;   // metres a grabbing palm moved this frame
+        float zoomChange = 0.0f;  // |log| of the distance ratio of the two grabbing hands this frame
+        float twist = 0.0f;       // |radians| the table turned this frame
+        bool hover = false;       // a unit is hovered
+        uint32_t presses = 0, orders = 0; // the table's counters (press on a unit, order given)
+        uint32_t gates = GateAllActions;  // what the game allows now
+        int state = Show;
+        bool replayBattle = false; // the table's "?" was touched
+    };
+
+    struct Card
+    {
+        bool visible = false;
+        Part part = Part::None;
+        int step = 0, steps = 0;
+        std::string title, body;
+        Target target = Target::None;
+        int hand = -1; // -1: both / either
+    };
+
+    class Guide
+    {
+    public:
+        // One headset frame. state(): the option's new value (write it back when it changed).
+        Card step(const Inputs &in, double now, bool japanese)
+        {
+            state_ = in.state;
+            if (in.replayBattle)
+            {
+                state_ = state_ == Done ? Battle : state_ == Basics ? Show : state_;
+                beginPart(Part::Battle, now);
+            }
+            // The game's own tutorial wins at the table: say how to do what it asks for.
+            if (in.table && (in.gates & GateAllActions) != GateAllActions && (in.gates & GateAllActions) != 0)
+                return gameTutorial(in.gates, japanese);
+            Part want = Part::None;
+            if (in.theater && (state_ == Show || state_ == Basics))
+                want = Part::Basics;
+            else if (in.table && (state_ == Show || state_ == Battle))
+                want = Part::Battle;
+            if (want == Part::None)
+            {
+                part_ = Part::None;
+                return Card{};
+            }
+            if (want != part_)
+                beginPart(want, now);
+
+            // Hold B to skip the part.
+            if (in.b)
+            {
+                if (bSince_ < 0.0)
+                    bSince_ = now;
+                else if (now - bSince_ > kSkipHold)
+                {
+                    finishPart();
+                    bSince_ = -1.0;
+                    return Card{};
+                }
+            }
+            else
+                bSince_ = -1.0;
+
+            const bool pressA = in.a && !lastA_, pressTrigger = in.trigger && !lastTrigger_;
+            const bool pressAny = pressA || (in.b && !lastB_) || (in.x && !lastX_) || (in.y && !lastY_);
+            lastA_ = in.a, lastB_ = in.b, lastX_ = in.x, lastY_ = in.y, lastTrigger_ = in.trigger;
+            const bool pressMenu = in.menu && !lastMenu_;
+            lastMenu_ = in.menu;
+            const double inStep = now - stepAt_;
+            bool done = false;
+            if (part_ == Part::Basics)
+            {
+                switch (step_)
+                {
+                case 0: // point at the screen
+                    onScreenFor_ = in.pointerOnScreen ? onScreenFor_ + (now - last_) : 0.0;
+                    done = onScreenFor_ > 0.5;
+                    break;
+                case 1: done = pressTrigger && in.pointerOnScreen; break;
+                case 2: done = pressAny && inStep > 0.4; break;
+                case 3: done = pressMenu; break;
+                case 4: done = in.recentered; break;
+                default: done = (pressA && inStep > 0.6) || inStep > 10.0; break;
+                }
+            }
+            else if (part_ == Part::Battle)
+            {
+                switch (step_)
+                {
+                case 0:
+                    moved_ += in.grabMoved;
+                    done = moved_ > 0.12f;
+                    break;
+                case 1:
+                    zoomed_ += in.zoomChange + in.twist;
+                    done = zoomed_ > 0.35f;
+                    break;
+                case 2: done = in.hover; break;
+                case 3: done = in.presses != presses_; break;
+                case 4: done = in.orders != orders_; break;
+                default: done = (pressA && inStep > 0.6) || inStep > 14.0; break;
+                }
+            }
+            last_ = now;
+            presses_ = in.presses;
+            if (step_ != 4 || done)
+                orders_ = in.orders;
+            if (done)
+            {
+                ++step_;
+                stepAt_ = now;
+                if (step_ >= steps())
+                {
+                    finishPart();
+                    return Card{};
+                }
+            }
+            return card(japanese);
+        }
+
+        int state() const { return state_; }
+
+        static constexpr double kSkipHold = 1.5;
+
+    private:
+        int steps() const { return part_ == Part::Basics ? 6 : part_ == Part::Battle ? 7 : 0; }
+
+        void beginPart(Part p, double now)
+        {
+            part_ = p;
+            step_ = 0;
+            stepAt_ = now;
+            last_ = now;
+            onScreenFor_ = 0.0;
+            moved_ = zoomed_ = 0.0f;
+        }
+
+        void finishPart()
+        {
+            if (part_ == Part::Basics)
+                state_ = state_ == Show ? Battle : Done;
+            else if (part_ == Part::Battle)
+                state_ = state_ == Show ? Basics : Done;
+            part_ = Part::None;
+        }
+
+        struct Text
+        {
+            const char *en, *ja;
+            Target target;
+        };
+
+        Card card(bool japanese) const
+        {
+            static const Text basicsTitle{"VR controls", "VR の操作", Target::None};
+            static const Text basics[6] = {
+                {"Point a controller at the screen: a laser shows where you point.",
+                 "コントローラーを画面に向けてください。レーザーが指している場所を示します。", Target::Screen},
+                {"Pull the trigger to click where the laser points: menus, choices, the messages.",
+                 "トリガーを引くと、レーザーの先をクリックします（メニュー、選択肢、メッセージ）。", Target::Trigger},
+                {"A is Circle (confirm, next message), B is Cross (cancel), X is Square, Y is Triangle. Press one.",
+                 "A は○（決定・次のメッセージ）、B は×（キャンセル）、X は□、Y は△です。どれかを押してください。", Target::A},
+                {"The menu button: tap it for Start, hold it for Select (the system menu). Tap it now.",
+                 "メニューボタン：短く押すとスタート、長押しでセレクト（システムメニュー）です。押してみてください。", Target::Menu},
+                {"Lost the screen? Hold both grips for a second: it comes back in front of you.",
+                 "画面を見失ったら、両手のグリップを 1 秒握ると正面に戻ります。", Target::BothGrips},
+                {"In battles the map becomes a table in front of you; this guide goes on there. Replay it any time: Settings > VR guide. (A: done)",
+                 "戦闘ではマップが目の前のテーブルになり、このガイドはそこで続きます。設定の「VR guide」でいつでも再表示できます。（A：完了）", Target::A},
+            };
+            static const Text battleTitle{"The battle table", "バトルテーブル", Target::None};
+            static const Text battle[7] = {
+                {"Hold a grip and drag: the map follows your hand. Let go and it drifts on a little.",
+                 "グリップを握ってドラッグすると、マップが手について動きます。離すと少し滑ります。", Target::Grip},
+                {"Hold both grips: pull your hands apart to zoom in, together to zoom out, twist to turn the table.",
+                 "両手のグリップを握り、手を広げるとズームイン、近づけるとズームアウト、ひねるとテーブルが回ります。", Target::BothGrips},
+                {"Look at a unit and hold your fingertip over it, or touch its disc: it lights up.",
+                 "ユニットを見て指先を重ねるか、円盤に触れてください。ユニットが光ります。", Target::None},
+                {"Pull the trigger on one of your angels to select it.",
+                 "味方のエンジェルにトリガーを引いて選択してください。", Target::Trigger},
+                {"Keep holding, point at a spot on the map and let go: the angel goes there. Let go on an enemy to attack it.",
+                 "トリガーを押したままマップ上の場所を指して離すと、そこへ移動します。敵の上で離すと攻撃します。", Target::Trigger},
+                {"X: order all angels. Y: H-Weapon. B: cancel. Left stick click: cockpit (the triggers fire). Right stick click: the camera of the unit under your hand. (A: next)",
+                 "X：全エンジェルに命令、Y：H-Weapon、B：キャンセル。左スティック押し込み：コックピット（トリガーで射撃）、右スティック押し込み：手の下のユニットのカメラ。（A：次へ）",
+                 Target::X},
+                {"Prefer a laser and the map all around you? Settings > VR battle map > Surround. The ? at the table's corner replays this guide. (A: done)",
+                 "レーザーで周囲に広がるマップを使いたい場合は、設定の「VR battle map」で Surround を選んでください。テーブルの角の ? でこのガイドを再表示できます。（A：完了）",
+                 Target::A},
+            };
+            Card c;
+            c.visible = true;
+            c.part = part_;
+            c.step = step_;
+            c.steps = steps();
+            const Text &title = part_ == Part::Basics ? basicsTitle : battleTitle;
+            const Text &t = part_ == Part::Basics ? basics[step_] : battle[step_];
+            c.title = japanese ? title.ja : title.en;
+            c.body = japanese ? t.ja : t.en;
+            c.target = t.target;
+            return c;
+        }
+
+        static Card gameTutorial(uint32_t gates, bool japanese)
+        {
+            struct Line
+            {
+                uint32_t gate;
+                const char *en, *ja;
+                Target target;
+            };
+            static const Line lines[] = {
+                {GateSelect, "Trigger on a unit: select it; on the map: move there (the tutorial's Circle).",
+                 "ユニットにトリガー：選択、マップにトリガー：移動（チュートリアルの○）。", Target::Trigger},
+                {GateCancel, "B: cancel (Cross).", "B：キャンセル（×）。", Target::B},
+                {GatePan, "Grab the map with a grip and drag it (the D-pad scroll).", "グリップでマップをつかんでドラッグ（方向キーのスクロール）。",
+                 Target::Grip},
+                {GateZoom, "Both grips, hands apart / together: zoom (R1 / R2).", "両手のグリップで手を広げる／近づける：ズーム（R1／R2）。",
+                 Target::BothGrips},
+                {GateAll, "X: order all angels (Square).", "X：全エンジェルに命令（□）。", Target::X},
+                {GateHWeapon, "Y: H-Weapon (Triangle).", "Y：H-Weapon（△）。", Target::Y},
+                {GateCockpit, "Left stick click: cockpit view (L3).", "左スティック押し込み：コックピット（L3）。", Target::Sticks},
+                {GateUnitCam, "Right stick click: the unit's camera (R3).", "右スティック押し込み：ユニットのカメラ（R3）。", Target::Sticks},
+                {GateStart, "Menu button: Start.", "メニューボタン：スタート。", Target::Menu},
+                {GateAngelList, "Right stick to the left: the angel list (L2).", "右スティックを左へ：エンジェル一覧（L2）。", Target::Sticks},
+            };
+            Card c;
+            c.visible = true;
+            c.part = Part::GameTutorial;
+            c.title = japanese ? "チュートリアル（VR の操作）" : "Tutorial in VR";
+            int shown = 0;
+            for (const Line &l : lines)
+                if (gates & l.gate)
+                {
+                    if (!c.body.empty())
+                        c.body += "\n";
+                    c.body += japanese ? l.ja : l.en;
+                    if (c.target == Target::None)
+                        c.target = l.target;
+                    ++shown;
+                }
+            c.steps = shown;
+            return c;
+        }
+
+        Part part_ = Part::None;
+        int step_ = 0;
+        int state_ = Show;
+        double stepAt_ = 0.0, last_ = 0.0, bSince_ = -1.0, onScreenFor_ = 0.0;
+        float moved_ = 0.0f, zoomed_ = 0.0f;
+        uint32_t presses_ = 0, orders_ = 0;
+        bool lastA_ = false, lastB_ = false, lastX_ = false, lastY_ = false, lastTrigger_ = false, lastMenu_ = false;
+    };
+}
