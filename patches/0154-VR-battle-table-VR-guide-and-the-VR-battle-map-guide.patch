+            case T::Trigger: out = V3{0.0f, -0.012f, -0.055f}; return true;
+            case T::Grip: case T::BothGrips: out = V3{side * 0.03f, -0.04f, -0.03f}; return true;
+            case T::A: case T::B: out = V3{0.0f, 0.032f, -0.04f}; return hand == 1;
+            case T::X: case T::Y: out = V3{0.0f, 0.032f, -0.04f}; return hand == 0;
+            case T::Menu: out = V3{0.0f, 0.032f, -0.02f}; return hand == 0;
+            case T::Sticks: out = V3{0.0f, 0.034f, -0.058f}; return true;
+            default: return false;
