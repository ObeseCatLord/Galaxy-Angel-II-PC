diff --git a/ps2xRuntime/include/runtime/ga2_battletable.h b/ps2xRuntime/include/runtime/ga2_battletable.h
new file mode 100644
index 0000000..7982a2a
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_battletable.h
@@ -0,0 +1,91 @@
+#pragma once
+
+#include <cstdint>
+
+// The battle table: in VR with "VR battle selection" Hand, the battle's tactical map hovers flat in front of the
+// player as a holographic table (after BattleGroupVR's radar). Both sides of it:
+//   - the game (native/compat/ga2_battlepointer.cpp, game thread) knows the map: the camera's projection of the
+//     ground, the units, what is hovered and targeted; it publishes a State once per map update and turns the
+//     hands into the game's own picks, orders, pans and zooms;
+//   - ga2_vr (main thread) knows the headset: it places the table in the play space, publishes it with the
+//     hands and the head (Pose) once per headset frame, draws the table (the game's own picture reprojected onto
+//     it), the units' markers, the order line and the hands, and plays the haptic pulses the game asks for.
+// The table shows the ground: table point (u, v) (metres from its centre, u to the right, v away from the
+// player) is the map point (cx, cz) + s (u r + v f) (r, f: the camera's right and forward on the ground), and
+// the game's picture of that point is at project(M, point) in the 2D layer's 640 x 480 space.
+namespace ga2_battletable
+{
+    constexpr int kMaxUnits = 96;
+
+    struct Unit
+    {
+        float x = 0.0f, z = 0.0f;   // map position (map units)
+        float sx = 0.0f, sy = 0.0f; // its icon in the 2D layer's 640 x 480 space (centre)
+        bool hovered = false;       // under a hand
+        bool focused = false;       // the game's cursor unit (the one an order goes to)
+    };
+
+    struct State
+    {
+        bool active = false; // the tactical map is shown in table mode
+        // Ground -> 2D layer: (sx, sy) = (c.x / c.w - originX, c.y / c.w - originY), c = (X, 0, Z, 1) M (row vector).
+        float M[16] = {};
+        float originX = 0.0f, originY = 0.0f;
+        // The 2D layer is 640 x 480 over the 640 x 448 picture; a hor+ frame squeezes the 3D picture by k.
+        float k = 1.0f;
+        bool wide = false;
+        // Table point (u, v) metres -> map point.
+        float cx = 0.0f, cz = 0.0f, rx = 1.0f, rz = 0.0f, fx = 0.0f, fz = 1.0f, s = 100.0f;
+        Unit units[kMaxUnits];
+        int unitCount = 0;
+        // The order being dragged: from the hand to this map point (a unit's or the ground's).
+        bool drag = false;
+        int dragHand = 1;
+        float dragX = 0.0f, dragZ = 0.0f;
+        bool orderOnRelease = false; // releasing the trigger now gives the order (Circle again)
+        uint32_t hapticSmall[2] = {0, 0}, hapticBig[2] = {0, 0}; // pulse counters per hand (left, right)
+        uint32_t presses = 0, orders = 0; // counters: trigger pressed on a unit, an order given by a release
+        // The game's tutorial gates as actions (ga2_vrguide.h Gate bits; all set when nothing is gated).
+        uint32_t gates = 0x3FFu;
+        uint64_t serial = 0;
+    };
+
+    struct Hand
+    {
+        bool valid = false;
+        float tip[3] = {0, 0, 0};    // the index fingertip (the pointer)
+        float aim[3] = {0, 0, -1};   // the fingertip's forward direction (unit)
+        float palm[3] = {0, 0, 0};   // the palm (grabbing)
+        float trigger = 0.0f, grip = 0.0f;
+    };
+
+    // Everything in the recentred play space (metres, OpenXR axes: x right, y up, -z forward).
+    struct Pose
+    {
+        bool valid = false;
+        float center[3] = {0, -0.45f, -0.55f};
+        float yaw = 0.0f;        // the table's turn about y (radians, + = counter-clockwise seen from above)
+        float halfWidth = 0.6f;  // along u
+        float halfDepth = 0.4f;  // along v
+        Hand hands[2];           // left, right
+        float head[3] = {0, 0, 0};
+        float gaze[3] = {0, 0, -1};
+        uint64_t serial = 0;
+    };
+
+    // Table point (u, v, height) <-> play space, for a pose.
+    void toPlay(const Pose &pose, float u, float v, float h, float out[3]);
+    void toTable(const Pose &pose, const float p[3], float &u, float &v, float &h);
+    // Table point <-> map point, for a state.
+    void tableToMap(const State &s, float u, float v, float &x, float &z);
+    void mapToTable(const State &s, float x, float z, float &u, float &v);
+    // A map point's position in the game's picture (u, v in 0..1 of the 640 x 448 picture); false behind the camera.
+    bool mapToPicture(const State &s, float x, float z, float &pu, float &pv);
+
+    // Game thread.
+    void publish(const State &state);
+    Pose pose();
+    // ga2_vr.
+    State latest(); // inactive when the game has not published for a while
+    void publishPose(const Pose &pose);
+}
