From 9f740cd6eaba0a263547fb69a4d215e9d57214f7 Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:50:17 -0600
Subject: [PATCH] Automatic resolution decided once, wherever it is read first

VR starts the GS before the window: it read GA2_PGS_SSAA=auto as 0 and ran
native while the engine then chose 2x (seen on a Steam Frame in SteamVR).
ga2_display::internalSamples() decides "auto" once (VR and ARM 2x, else from
the display, 2x before the window exists) for the GS, sharp text and the
engine's log alike.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/include/runtime/ga2_display.h |  5 ++++
 ps2xRuntime/include/runtime/ga2_options.h |  2 +-
 ps2xRuntime/src/lib/ga2_present.cpp       | 31 +++++++++++++++++++++++
 ps2xRuntime/src/lib/gs/gs_hitext.cpp      |  5 ++--
 ps2xRuntime/src/lib/gs/gs_pgs.cpp         |  3 ++-
 ps2xRuntime/src/lib/ps2_runtime.cpp       | 10 +++-----
 6 files changed, 45 insertions(+), 11 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ga2_display.h b/ps2xRuntime/include/runtime/ga2_display.h
index cacf5d4..5b76024 100644
--- a/ps2xRuntime/include/runtime/ga2_display.h
+++ b/ps2xRuntime/include/runtime/ga2_display.h
@@ -10,4 +10,9 @@ namespace ga2_display
     float wideAspect();
     // Width / height for an explicit GA2_ASPECT value; 0 for "fit".
     float parseAspect(const char *value);
+    // The GS's samples per pixel (GA2_PGS_SSAA: 1, 4 = 2x, 16 = 4x). "auto" (the default "Automatic" resolution) is
+    // decided once, from the display, as a PC game picks its detail: 16 (4x) from 1200 display lines up, 4 (2x)
+    // below, 1 (native) under 700; 4 in VR; 1 on ARM (the Steam Frame). Before the window exists (VR starts the GS
+    // first) the display is asked as soon as it is up, else 2x.
+    int internalSamples();
 }
diff --git a/ps2xRuntime/include/runtime/ga2_options.h b/ps2xRuntime/include/runtime/ga2_options.h
index efeb53f..c20bc66 100644
--- a/ps2xRuntime/include/runtime/ga2_options.h
+++ b/ps2xRuntime/include/runtime/ga2_options.h
@@ -81,7 +81,7 @@ namespace ga2_options
              Apply::Restart, {{"ja", "Japanese"}, {"en", "English"}}},
             {"resolution", "Internal resolution",
              "3D detail (the 2D art is drawn at its native 640x448 size; 4x needs a fast GPU). Automatic: from the display "
-             "(4x from 1440p up, 2x on 1080p; 2x in VR and on ARM).",
+             "(4x from 1440p up, 2x on 1080p; 2x in VR; native on ARM, the Steam Frame).",
              "GA2_PGS_SSAA", Apply::Restart,
              {{"auto", "Automatic"}, {"0", "Native (640x448)"}, {"1", "2x (1280x896)"}, {"2", "4x (2560x1792)"}}},
             {"fullscreen", "Display",
diff --git a/ps2xRuntime/src/lib/ga2_present.cpp b/ps2xRuntime/src/lib/ga2_present.cpp
index 200ee8d..3e54a8c 100644
--- a/ps2xRuntime/src/lib/ga2_present.cpp
+++ b/ps2xRuntime/src/lib/ga2_present.cpp
@@ -10,6 +10,7 @@
 #include "rlgl.h"
 #include "external/glad.h"
 
+#include <mutex>
 #include <algorithm>
 #include <atomic>
 #include <chrono>
@@ -1040,6 +1041,36 @@ vec4 hook() {
 
 namespace ga2_display
 {
+    int internalSamples()
+    {
+        static std::mutex mutex;
+        static int decided = 0;
+        std::lock_guard<std::mutex> lock(mutex);
+        if (decided)
+            return decided;
+        const char *v = std::getenv("GA2_PGS_SSAA");
+        if (v && *v && std::string(v) != "auto")
+            return decided = std::max(1, std::atoi(v));
+        const char *vr = std::getenv("GA2_VR");
+#if defined(__aarch64__) || defined(_M_ARM64)
+        const bool arm = true;
+#else
+        const bool arm = false;
+#endif
+        if (arm)
+            decided = 1; // the Steam Frame's GPU: 2x stereo battles ran at 13 fps of 72 (measured)
+        else if (vr && std::string(vr) == "1")
+            decided = 4;
+        else if (IsWindowReady())
+        {
+            const int height = GetMonitorHeight(GetCurrentMonitor());
+            decided = height >= 1200 ? 16 : height >= 700 ? 4 : height > 0 ? 1 : 4;
+        }
+        else
+            decided = 4;
+        return decided;
+    }
+
     float parseAspect(const char *value)
     {
         const std::string a = value ? value : "16:9";
diff --git a/ps2xRuntime/src/lib/gs/gs_hitext.cpp b/ps2xRuntime/src/lib/gs/gs_hitext.cpp
index b6b587d..eb14b59 100644
--- a/ps2xRuntime/src/lib/gs/gs_hitext.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_hitext.cpp
@@ -10,6 +10,7 @@
 // squeezed to the original ink box) and with one vertical transform (em 17.1 px, baseline row 15.75 of the 18 px
 // cell); descenders longer than the game's are compressed below the baseline, glyphs the game draws away from
 // where the font does (~ ^ `) are moved to the game's height.
+#include "runtime/ga2_display.h"
 #include "runtime/ga2_hitext.h"
 #include "runtime/ga2_activity.h"
 #include "runtime/ga2_sjis_table.h"
@@ -525,7 +526,7 @@ namespace ga2_hitext
         {
             const char *gs = std::getenv("GA2_GS");
             const bool cpu = gs && std::string(gs) == "cpu";
-            on = !cpu && envInt("GA2_PGS_SSAA", 1) >= 4 ? 1 : 0;
+            on = !cpu && ga2_display::internalSamples() >= 4 ? 1 : 0;
             g_autoOn.store(on);
         }
         return on == 1;
@@ -575,7 +576,7 @@ namespace ga2_hitext
     int renderScale()
     {
         static const int k = [] {
-            const int ssaa = envInt("GA2_PGS_SSAA", 1);
+            const int ssaa = ga2_display::internalSamples();
             return ssaa >= 16 ? 4 : 2;
         }();
         return k;
diff --git a/ps2xRuntime/src/lib/gs/gs_pgs.cpp b/ps2xRuntime/src/lib/gs/gs_pgs.cpp
index 822edad..2cb47f1 100644
--- a/ps2xRuntime/src/lib/gs/gs_pgs.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_pgs.cpp
@@ -1,5 +1,6 @@
 // paraLLEl-GS bridge. See runtime/gs/gs_pgs.h. Structure follows BT3-Recomp's
 // ps2_gs_pgs.cpp (GPL-3.0) without its game-specific seams.
+#include "runtime/ga2_display.h"
 #include "runtime/gs/gs_pgs.h"
 
 #if defined(PS2X_HAVE_PGS)
@@ -585,7 +586,7 @@ namespace
                             savePipelineCache(st.eyes[0].device); });
 
         GSOptions options = {};
-        const int r = envInt("GA2_PGS_SSAA", 1);
+        const int r = ga2_display::internalSamples();
         options.super_sampling = r >= 16 ? SuperSampling::X16 : r >= 8 ? SuperSampling::X8
                                  : r >= 4 ? SuperSampling::X4 : r >= 2 ? SuperSampling::X2 : SuperSampling::X1;
         s.ssaa = static_cast<uint32_t>(options.super_sampling);
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index b4b38ba..697e041 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1406,17 +1406,13 @@ bool PS2Runtime::initialize(const char *title)
             ToggleBorderlessWindowed();
         // Internal resolution "auto" (the default): from the display the window is on, as a PC game picks its
         // detail: at least the display's own height where it can, 4x (2560x1792, 1792 lines) on displays of 1200
-        // lines and up (1440p, ultrawide 1440p, 4K), 2x (1280x896) on 1080p and the like, native on very small ones; 2x in VR (the headset's eyes are their own displays) and on ARM (the Steam Frame's mobile GPU).
+        // lines and up (1440p, ultrawide 1440p, 4K), 2x (1280x896) on 1080p and the like, native on very small ones; 2x in VR (the headset's eyes are their own displays), native on ARM (the Steam Frame's mobile GPU).
         if (const char *ssaa = std::getenv("GA2_PGS_SSAA"); !ssaa || std::string(ssaa) == "auto")
         {
             const int monitor = GetCurrentMonitor();
             const int height = std::max(GetMonitorHeight(monitor), 1);
-#if defined(__aarch64__) || defined(_M_ARM64)
-            const bool arm = true;
-#else
-            const bool arm = false;
-#endif
-            const char *pick = vrMode || arm ? "4" : height >= 1200 ? "16" : height >= 700 ? "4" : "1";
+            const int samples = ga2_display::internalSamples(); // decided once, also for a GS started before the window
+            const char *pick = samples >= 16 ? "16" : samples >= 4 ? "4" : "1";
 #if defined(_WIN32)
             _putenv_s("GA2_PGS_SSAA", pick);
 #else
-- 
