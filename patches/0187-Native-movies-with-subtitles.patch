--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_movie.h
@@ -0,0 +1,42 @@
+// Native movie playback: the games' movies (PSS: MPEG-2 640x480 video, 16-bit 48 kHz stereo PCM in private stream 1,
+// research/native-movies/report.txt) decoded by FFmpeg on a thread of their own and shown by the presenter instead of
+// the emulated IPU/IOP/SPU2 path. The game keeps its movie manager, script command, skip button and "seen" flag: the
+// port's hooks (native/compat/ga2_movie.cpp) replace only the low-level player (open, decode step, draw, finished
+// test, close) and call this.
+//
+//   GA2_MOVIES=original      the emulated player (the setting "Movies")
+//   GA2_MOVIE_SUBTITLES=0    no subtitles (the setting "Movie subtitles")
+//   GA2_MOVIE_TRACE=1        open/close/end lines and per-second frame/audio counts
+//
+// Subtitles: <pack>/subtitles/<program>/<file>.srt in each language pack (the parent of every GA2_MODS root), first
+// found wins; or GA2_SUBTITLE_DIR/<program>/<file>.srt. SRT timing, UTF-8 text, drawn under the picture's centre.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <string>
+
+namespace ga2_movie
+{
+    // Native playback chosen (the setting, read at each open).
+    bool enabled();
+
+    // Game thread. program: the disc's program ("SLPM_662.43"); file: the guest path the game opened ("movie/8004.pss");
+    // the movie's bytes are `size` bytes from disc sector `lsn` (0 size: look the file up by its path); volume 0..1.
+    // False when it cannot be played natively (the caller then runs the game's own player).
+    bool open(const std::string &program, const std::string &file, uint32_t lsn, uint32_t size, float volume);
+    // A movie is open (until close).
+    bool active();
+    // The movie has shown its last picture (the game then stops it).
+    bool finished();
+    // Game thread: stop and free (the end or a skip).
+    void close();
+
+    // Present thread (GL current): the picture to show while a movie is open, subtitles drawn in; false while none is
+    // ready yet (show the game's own picture). Rows top first.
+    bool frame(unsigned &texture, int &width, int &height);
+
+    // Audio callback: adds the movie's sound (48 kHz stereo, interleaved) into `output`; its position is the clock.
+    void mixAudio(std::span<int16_t> output);
+}
