+    const PS2Memory *g_gifStatOwner = nullptr;
+    uint32_t *g_gifStatSlot = nullptr;
     constexpr uint64_t kEeClockHz = 294912000ull;
     constexpr std::array<uint64_t, 4> kEeTimerClockHz = {
         147456000ull,
@@ -245,6 +251,182 @@ static inline uint32_t gs_vram_offset(uint32_t basePage, uint32_t x, uint32_t y,
 }
 
 
+namespace
+{
+    // The four timers over `eeCycles` (PS2Memory::m_eeTimers; a template because the timer type is private to the
+    // class and this lives outside it, see g_eeTimerDeferral). Returns the timers whose interrupt was raised.
+    template <class Timers>
+    uint32_t advanceEeTimerArray(Timers &timers, uint64_t eeCycles) noexcept
+    {
+    uint32_t interruptMask = 0u;
+    for (size_t index = 0; index < timers.size(); ++index)
+    {
+        auto &timer = timers[index];
+        if ((timer.mode & kEeTimerModeCue) == 0u)
+        {
+            continue;
+        }
+
+        const uint64_t clockHz = kEeTimerClockHz[timer.mode & kEeTimerModeClksMask];
+        const uint64_t wholeSeconds = eeCycles / kEeClockHz;
+        const uint64_t remainingCycles = eeCycles % kEeClockHz;
+        const uint64_t scaled = remainingCycles * clockHz + timer.clockRemainder;
+        const uint64_t ticks = wholeSeconds * clockHz + scaled / kEeClockHz;
+        timer.clockRemainder = scaled % kEeClockHz;
+        if (ticks == 0u)
+        {
+            continue;
+        }
+
+        const uint32_t oldCount = timer.count & 0xFFFFu;
+        const uint32_t compare = timer.compare & 0xFFFFu;
+        const uint64_t compareDistance = ticksUntilMatch(oldCount, compare);
+        const uint64_t overflowDistance = 0x10000ull - oldCount;
+        const bool zeroReturn = (timer.mode & kEeTimerModeZret) != 0u;
+        const bool compareReached = ticks >= compareDistance;
+        bool overflowReached = false;
+
+        if (zeroReturn)
+        {
+            overflowReached = ticks >= overflowDistance && overflowDistance <= compareDistance;
+            if (compareReached)
+            {
+                const uint64_t remaining = ticks - compareDistance;
+                timer.count = compare == 0u
+                                  ? static_cast<uint32_t>(remaining & 0xFFFFu)
+                                  : static_cast<uint32_t>(remaining % compare);
+            }
+            else
+            {
+                timer.count = static_cast<uint32_t>((oldCount + ticks) & 0xFFFFu);
+            }
+        }
+        else
+        {
+            overflowReached = ticks >= overflowDistance;
+            timer.count = static_cast<uint32_t>((oldCount + ticks) & 0xFFFFu);
+        }
+
+        if (compareReached && (timer.mode & kEeTimerModeCmpe) != 0u && (timer.mode & kEeTimerModeEquf) == 0u)
+        {
+            timer.mode |= kEeTimerModeEquf;
+            interruptMask |= 1u << index;
+        }
+        if (overflowReached && (timer.mode & kEeTimerModeOvfe) != 0u && (timer.mode & kEeTimerModeOvff) == 0u)
+        {
+            timer.mode |= kEeTimerModeOvff;
+            interruptMask |= 1u << index;
+        }
+    }
+    return interruptMask;
+}
+
+    // EE cycles until the first timer interrupt (compare or overflow, enabled and not already flagged); max: none.
+    // Exact: the smallest advance whose tick count reaches the event.
+    template <class Timers>
+    uint64_t eeTimerInterruptHorizon(const Timers &timers) noexcept
+    {
+    uint64_t nearest = std::numeric_limits<uint64_t>::max();
+    for (const auto &timer : timers)
+    {
+        if ((timer.mode & kEeTimerModeCue) == 0u)
+        {
+            continue;
+        }
+
+        const uint32_t count = timer.count & 0xFFFFu;
+        const uint32_t compare = timer.compare & 0xFFFFu;
+        const uint64_t compareDistance = ticksUntilMatch(count, compare);
+        const uint64_t overflowDistance = 0x10000ull - count;
+        uint64_t eventTicks = std::numeric_limits<uint64_t>::max();
+
+        if ((timer.mode & kEeTimerModeCmpe) != 0u &&
+            (timer.mode & kEeTimerModeEquf) == 0u)
+        {
+            eventTicks = compareDistance;
+        }
+        const bool overflowCanOccur = (timer.mode & kEeTimerModeZret) == 0u ||
+                                      overflowDistance <= compareDistance;
+        if (overflowCanOccur &&
+            (timer.mode & kEeTimerModeOvfe) != 0u &&
+            (timer.mode & kEeTimerModeOvff) == 0u)
+        {
+            eventTicks = std::min(eventTicks, overflowDistance);
+        }
+        if (eventTicks == std::numeric_limits<uint64_t>::max())
+        {
+            continue;
+        }
+
+        const uint64_t clockHz = kEeTimerClockHz[timer.mode & kEeTimerModeClksMask];
+        const uint64_t numerator = eventTicks * kEeClockHz - timer.clockRemainder;
+        const uint64_t cycles = (numerator + clockHz - 1u) / clockHz;
+        nearest = std::min(nearest, std::max<uint64_t>(1u, cycles));
+    }
+    return nearest;
+}
+
+    // Timer deferral (GA2_EE_TIMER_DEFER=0: off; =check: a shadow copy is advanced call by call and compared).
+    // advanceEeTimers runs at every branch the EE takes (8 or 32 cycles at a time) and each running timer costs two
+    // 64-bit multiply-divides per call. A timer's count is a pure function of the cycles since it was last written,
+    // so the calls are summed and applied in one piece: when the sum reaches the first cycle at which a timer
+    // interrupt is raised (the same call that raised it before), and before any timer register is read or written.
+    // State of one PS2Memory, kept here so the header the game code precompiles is untouched.
+    struct EeTimerDeferral
+    {
+        const PS2Memory *owner = nullptr;
+        uint64_t deferred = 0; // cycles counted but not applied
+        uint64_t quiet = 0;    // further cycles that may be counted before a timer interrupt is due
+        unsigned char shadow[128] = {}; // check mode: the timers advanced call by call
+        bool shadowValid = false;
+    };
+    EeTimerDeferral g_eeTimerDeferral;
+
+    enum class EeTimerDeferMode { Off, On, Check };
+    EeTimerDeferMode eeTimerDeferMode() noexcept
+    {
+        static const EeTimerDeferMode mode = [] {
+            const char *v = std::getenv("GA2_EE_TIMER_DEFER");
+            if (!v || !*v) return EeTimerDeferMode::On;
+            if (std::strcmp(v, "check") == 0) return EeTimerDeferMode::Check;
+            return *v == '0' ? EeTimerDeferMode::Off : EeTimerDeferMode::On;
+        }();
+        return mode;
+    }
+
+    // Applies the deferred cycles of `timers` (the timers of `self`) and ends the deferral. By construction no
+    // interrupt is due inside the deferred span; one that were would be a bug and is reported.
+    template <class Timers>
+    void settleEeTimerDeferral(const PS2Memory *self, Timers &timers) noexcept
+    {
+        EeTimerDeferral &d = g_eeTimerDeferral;
+        if (d.owner != self)
+            return;
+        d.quiet = 0;
+        if (d.deferred == 0u)
+            return;
+        const uint64_t pending = d.deferred;
+        d.deferred = 0;
+        const uint32_t raised = advanceEeTimerArray(timers, pending);
+        if (raised != 0u)
+        {
+            std::fprintf(stderr, "[ee timers] deferral applied %llu cycles and raised interrupts 0x%x inside its horizon\n",
+                         static_cast<unsigned long long>(pending), raised);
+            std::abort();
+        }
+        if (d.shadowValid)
+        {
+            static_assert(sizeof(Timers) <= sizeof(d.shadow));
+            if (std::memcmp(d.shadow, &timers, sizeof(Timers)) != 0)
+            {
+                std::fprintf(stderr, "[ee timers] deferral check failed: %llu cycles in one piece differ from the same cycles call by call\n",
+                             static_cast<unsigned long long>(pending));
+                std::abort();
+            }
+        }
+    }
+}
