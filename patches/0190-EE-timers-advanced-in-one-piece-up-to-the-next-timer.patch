     constexpr uint32_t kEeTimerModeEquf = 1u << 10;
     constexpr uint32_t kEeTimerModeOvff = 1u << 11;
+    // GIF_STAT's slot in the m_ioRegisters of one PS2Memory (the one that advanced its timers last), so
