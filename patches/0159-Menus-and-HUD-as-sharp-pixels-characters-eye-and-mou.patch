diff --git a/ps2xRuntime/src/lib/gs/ga2_uiart.h b/ps2xRuntime/src/lib/gs/ga2_uiart.h
new file mode 100644
index 0000000..d1a63e3
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/ga2_uiart.h
@@ -0,0 +1,59 @@
+// Which 2D textures are pictures (character sprites and their eye and mouth frames, portraits, backgrounds, event
+// pictures) and which are the interface (panels, frames, window pieces, buttons, ornaments, the battle HUD).
+// Per-layer upscaling (gs_texpacks.cpp) gives pictures to Anime4K and draws the interface as sharp pixels.
+//
+// The rule, measured on the story scenes' textures (Eigou 1): every piece of a character carries skin (5 to 80 % of
+// its opaque pixels: a body sprite at least 5 %, an eye or mouth frame 30 % and more); no interface piece does (at
+// most 2 %: blue panels, grey window parts, white wings). Full-screen pictures (backgrounds and event pictures, some
+// without anyone in them) count as pictures by their size.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ga2_uiart
+{
+    // A warm, moderately saturated, bright colour with red > green > blue (hue under 50 degrees).
+    inline bool skin(uint32_t c)
+    {
+        const int r = int(c & 0xFFu), g = int((c >> 8) & 0xFFu), b = int((c >> 16) & 0xFFu);
+        if (!(r > g && g > b))
+            return false;
+        const int range = r - b; // max - min
+        // saturation range / r in (0.12, 0.6), value r / 255 > 0.55, hue 60 * (g - b) / range < 50
+        return range * 100 > r * 12 && range * 10 < r * 6 && r * 100 > 255 * 55 && (g - b) * 60 < range * 50;
+    }
+
+    // rgba: w x h texels 0xAABBGGRR, alpha 255 = opaque.
+    inline bool isPicture(const uint32_t *rgba, int w, int h)
+    {
+        if (w >= 512 && h >= 400)
+            return true;
+        size_t opaque = 0, warm = 0;
+        const size_t n = size_t(w) * size_t(h);
+        for (size_t i = 0; i < n; ++i)
+        {
+            if ((rgba[i] >> 24) < 128u)
+                continue;
+            ++opaque;
+            warm += skin(rgba[i]) ? 1u : 0u;
+        }
+        return opaque >= 16 && warm * 100 >= opaque * 3;
+    }
+
+    // Each texel repeated scale x scale times (the interface's own pixels at the internal resolution).
+    inline void sharpPixels(const uint32_t *rgba, int w, int h, int scale, uint32_t *out)
+    {
+        const size_t outW = size_t(w) * size_t(scale);
+        for (int y = 0; y < h; ++y)
+        {
+            uint32_t *row = out + size_t(y) * size_t(scale) * outW;
+            for (int x = 0; x < w; ++x)
+                for (int k = 0; k < scale; ++k)
+                    row[size_t(x) * size_t(scale) + size_t(k)] = rgba[size_t(y) * size_t(w) + size_t(x)];
+            for (int k = 1; k < scale; ++k)
+                for (size_t i = 0; i < outW; ++i)
+                    row[size_t(k) * outW + i] = row[i];
+        }
+    }
+}
