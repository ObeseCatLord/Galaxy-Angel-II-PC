From a84c39bfa26f710dc29220bb2e808807da6ddf23 Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Thu, 19 Nov 2026 16:39:30 -0600
Subject: [PATCH] VR battle table: the map's background keyed out of the plate
 by brightness (clear glass over the stage's sky)

---
 ps2xRuntime/src/lib/ga2_vr.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/ps2xRuntime/src/lib/ga2_vr.cpp b/ps2xRuntime/src/lib/ga2_vr.cpp
index 0217b44..65e3193 100644
--- a/ps2xRuntime/src/lib/ga2_vr.cpp
+++ b/ps2xRuntime/src/lib/ga2_vr.cpp
@@ -616,10 +616,13 @@ void main()
     float fade = 1.0 - smoothstep(0.70, 1.0, edge);
     float scan = 0.5 + 0.5 * sin((v_aux.y * 0.5 + 0.5 - fract(time * 0.12)) * 60.0);
     float scanLine = smoothstep(0.985, 1.0, scan) * 0.05;
-    vec3 holo = max(map - vec3(0.07), vec3(0.0)) * 1.3;
+    // Keyed by brightness: the game's dim nebula background goes (the real sky is around the table), the grid,
+    // zones, order lines and objects stay.
+    float luma = dot(map, vec3(0.299, 0.587, 0.114));
+    vec3 holo = map * smoothstep(0.22, 0.45, luma) * 1.2;
     float ring = smoothstep(0.80, 0.86, edge) * (1.0 - smoothstep(0.86, 0.95, edge)) * 0.25;
-    vec3 col = (holo * pic + vec3(0.05, 0.12, 0.22) * 0.35 + vec3(0.25, 0.6, 1.0) * (scanLine + ring)) * fade;
-    float a = 0.18 * fade; // the glass dims what is behind it a little
+    vec3 col = (holo * pic + vec3(0.05, 0.12, 0.22) * 0.2 + vec3(0.25, 0.6, 1.0) * (scanLine + ring)) * fade;
+    float a = 0.12 * fade; // the glass dims what is behind it a little
     o = vec4(col, a);
 })";
 
