diff --git a/ps2xRuntime/include/runtime/ga2_affinity.h b/ps2xRuntime/include/runtime/ga2_affinity.h
new file mode 100644
index 0000000..b00b220
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_affinity.h
@@ -0,0 +1,29 @@
+// The game thread may be pinned to the largest cores of a big.LITTLE CPU (ps2_runtime.cpp, pinToFastestCores). Threads
+// it starts afterwards inherit that mask; helper threads that should not share the game thread's cores call
+// unpinThisThread() first, which gives them the process's original mask back (nothing happens when nothing was pinned).
+#pragma once
+
+#if defined(__linux__)
+#include <sched.h>
+#endif
+
+namespace ga2_affinity
+{
+#if defined(__linux__)
+    inline cpu_set_t g_original;
+    inline bool g_saved = false;
+    // The mask before pinning (called once, by the pinning thread, before it pins).
+    inline void saveOriginal(const cpu_set_t &mask)
+    {
+        g_original = mask;
+        g_saved = true;
+    }
+    inline void unpinThisThread()
+    {
+        if (g_saved)
+            sched_setaffinity(0, sizeof(g_original), &g_original);
+    }
+#else
+    inline void unpinThisThread() {}
+#endif
+}
