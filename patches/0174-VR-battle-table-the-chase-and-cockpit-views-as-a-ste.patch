+            // The hologram's scale: both grips, apart = larger (fewer game units per metre).
+            {
+                static bool stretching = false;
+                static float d0 = 0.0f, s0 = 1.0f;
+                const bool both = g_battleHolo && table.hands[0].valid && table.hands[1].valid && tv.grip[0] > 0.6f && tv.grip[1] > 0.6f;
+                const float dx = table.hands[1].palm[0] - table.hands[0].palm[0], dy = table.hands[1].palm[1] - table.hands[0].palm[1],
+                            dz = table.hands[1].palm[2] - table.hands[0].palm[2];
+                const float d = std::sqrt(dx * dx + dy * dy + dz * dz);
+                if (both && d > 0.05f)
+                {
+                    if (!stretching)
+                        stretching = true, d0 = d, s0 = g_holoScale;
+                    else
+                        g_holoScale = std::clamp(s0 * d0 / d, 0.1f, 10.0f);
+                }
+                else
+                    stretching = false;
+            }
             ga2_battletable::publishPose(table);
             tv.pose = table;
 
