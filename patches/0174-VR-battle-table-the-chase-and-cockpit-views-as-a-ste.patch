+        // The chase and cockpit views as a hologram (g_battleHolo): this eye's stereo frame of the game's 3D shown only
+        // inside a glowing column standing on the table's plate (radius of the plate, 0.75 m tall), fading at its
+        // side and top, with faint scan lines; around it the stage's sky, the plate's rim, the palms and the hands.
+        const char *kHoloEyeFs = R"(#version 330
+in vec2 v_uv;
+uniform sampler2D tex;
+uniform vec2 extent;
+uniform mat4 invViewProj;
+uniform vec3 eye;
+uniform vec3 centre; // the plate's centre
+uniform float radius, height, time;
+out vec4 o;
+void main()
+{
+    vec2 ndc = vec2(v_uv.x * 2.0 - 1.0, 1.0 - v_uv.y * 2.0); // the quad's uv runs down from its top
+    vec4 far = invViewProj * vec4(ndc, 1.0, 1.0);
+    vec3 dir = normalize(far.xyz / far.w - eye);
+    // The ray's nearest approach to the column's axis (horizontally) and its height there.
+    vec2 e = eye.xz - centre.xz, d = dir.xz;
+    float dd = max(dot(d, d), 1e-6);
+    float t = max(-dot(e, d) / dd, 0.0);
+    float r = length(e + d * t);
+    float y = eye.y + dir.y * t - centre.y;
+    if (t <= 0.0 && length(e) > radius) discard;
+    float side = 1.0 - smoothstep(radius * 0.82, radius, r);
+    float band = smoothstep(-0.03, 0.03, y) * (1.0 - smoothstep(height * 0.85, height, y));
+    float a = side * band;
+    if (a <= 0.003) discard;
+    vec3 c = texture(tex, v_uv * extent).rgb;
+    float scan = 0.94 + 0.06 * sin(gl_FragCoord.y * 1.4 + time * 6.0);
+    float rim = smoothstep(radius * 0.80, radius * 0.95, r) * (1.0 - smoothstep(radius * 0.95, radius, r));
+    vec3 col = c * scan + vec3(0.25, 0.6, 1.0) * rim * 0.35;
+    o = vec4(col * a, a);
+})";
+        GLuint g_holoEyeProgram = 0;
+
+        void drawHologramView(GLuint picture, float extentX, float extentY, const M4 &view, const M4 &proj, V3 eye)
+        {
+            const float time = float(GetTime());
+            glDisable(GL_CULL_FACE);
+            glDisable(GL_BLEND);
+            glEnable(GL_DEPTH_TEST);
+            glDepthMask(GL_TRUE);
+            glClearColor(0, 0, 0, 1);
+            glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+            M4 rotationOnly = view;
+            rotationOnly.m[12] = rotationOnly.m[13] = rotationOnly.m[14] = 0.0f;
+            drawStageSky(rotationOnly, proj);
+            if (!g_holoEyeProgram)
+                g_holoEyeProgram = compile(kMeshVs, kHoloEyeFs, "hologram view");
+            const ga2_battletable::Pose &pose = g_tableView.pose;
+            const V3 centre = playPoint(pose, 0.0f, 0.0f, 0.0f);
+            glDisable(GL_DEPTH_TEST);
+            glDepthMask(GL_FALSE);
+            glEnable(GL_BLEND);
+            glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+            glUseProgram(g_holoEyeProgram);
+            M4 identity{};
+            identity.m[0] = identity.m[5] = identity.m[10] = identity.m[15] = 1.0f;
+            setMatrix(g_holoEyeProgram, "mvp", identity);
+            setMatrix(g_holoEyeProgram, "invViewProj", inverse(mul(proj, view)));
+            glUniform3f(glGetUniformLocation(g_holoEyeProgram, "eye"), eye.x, eye.y, eye.z);
+            glUniform3f(glGetUniformLocation(g_holoEyeProgram, "centre"), centre.x, centre.y, centre.z);
+            glUniform1f(glGetUniformLocation(g_holoEyeProgram, "radius"), pose.halfWidth);
+            glUniform1f(glGetUniformLocation(g_holoEyeProgram, "height"), 0.75f);
+            glUniform1f(glGetUniformLocation(g_holoEyeProgram, "time"), time);
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, picture);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glUniform1i(glGetUniformLocation(g_holoEyeProgram, "tex"), 0);
+            glUniform2f(glGetUniformLocation(g_holoEyeProgram, "extent"), extentX, extentY);
+            rect(V3{0, 0, 0}, V3{1, 0, 0}, V3{0, 1, 0}, false);
+            // The plate under it (rim and glass, no map), the palms and the gloves.
+            glEnable(GL_DEPTH_TEST);
+            drawTable(mul(proj, view), eye, picture, extentX, extentY, false, time, false);
+            glUseProgram(0);
+            glBindVertexArray(0);
+            glEnable(GL_DEPTH_TEST);
+            glDepthMask(GL_TRUE);
+            glDisable(GL_BLEND);
+        }
+
         void drawScene(const M4 &view, const M4 &proj, V3 eye, GLuint picture, float extentX, float extentY, bool wide,
