+    RecentImage &slot = m_recentImages[m_recentNext++ % m_recentImages.size()];
+    slot.bytes.assign(vuCode, vuCode + codeSize);
+    slot.hash = digestBytes(vuCode, codeSize);
+    return slot.hash;
+}
