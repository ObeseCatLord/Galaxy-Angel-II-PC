+namespace
+{
+    // On a CPU with cores of different sizes (ARM big.LITTLE, such as the Steam Frame's one Cortex-X4 among A720s
+    // and A520s), the game thread is pinned to the largest cores (kernel cpu_capacity within 5 % of the highest):
+    // the scheduler otherwise moves it among the medium cores, and the emulated machine runs 20-30 % slower there
+    // (measured in a Frame battle, 2026-11-19). Equal cores or no capacity data: nothing changes. GA2_PIN_GAME=0 off.
+    void pinToFastestCores()
+    {
+#if defined(__linux__)
+        if (const char *v = std::getenv("GA2_PIN_GAME"); v && std::strcmp(v, "0") == 0)
+            return;
+        cpu_set_t allowed;
+        CPU_ZERO(&allowed);
+        if (sched_getaffinity(0, sizeof(allowed), &allowed) != 0)
+            return;
+        std::vector<std::pair<int, int>> capacity; // cpu, capacity
+        int best = 0, least = 1 << 30;
+        for (int cpu = 0; cpu < CPU_SETSIZE && cpu < 256; ++cpu)
+        {
+            if (!CPU_ISSET(cpu, &allowed))
+                continue;
+            std::ifstream in("/sys/devices/system/cpu/cpu" + std::to_string(cpu) + "/cpu_capacity");
+            int c = 0;
+            if (!(in >> c) || c <= 0)
+                return;
+            capacity.emplace_back(cpu, c);
+            best = std::max(best, c);
+            least = std::min(least, c);
+        }
+        if (capacity.size() < 2 || least * 100 >= best * 95)
+            return;
+        cpu_set_t fast;
+        CPU_ZERO(&fast);
+        std::string list;
+        for (const auto &[cpu, c] : capacity)
+            if (c * 100 >= best * 95)
+            {
+                CPU_SET(cpu, &fast);
+                list += (list.empty() ? "" : ",") + std::to_string(cpu);
+            }
+        if (sched_setaffinity(0, sizeof(fast), &fast) == 0)
+            std::cerr << "[ga2] game thread pinned to the largest cores (" << list << ")" << std::endl;
+#endif
+    }
+}
