+    void IopKernel::setState(IopThread &thread, IopThreadState state) noexcept
+    {
+        const IopThreadState old = thread.state;
+        if (old == state)
+            return;
+        // Only threads in the list are counted (a thread is listed from its creation; see rebuildThreadList).
+        const bool listed = m_threads.count(thread.id) && &m_threads.at(thread.id) == &thread;
+        if (listed)
+        {
+            if (old == IopThreadState::Ready)
+                --m_readyCount;
