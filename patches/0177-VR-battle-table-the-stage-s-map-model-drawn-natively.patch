diff --git a/ps2xRuntime/src/lib/ga2_vr.cpp b/ps2xRuntime/src/lib/ga2_vr.cpp
index cb21aac..14ab335 100644
--- a/ps2xRuntime/src/lib/ga2_vr.cpp
+++ b/ps2xRuntime/src/lib/ga2_vr.cpp
@@ -1545,6 +1545,154 @@ void main()
             glEnable(GL_BLEND);
         }
 
+        // ---- the tactical map's own model, drawn natively ---------------------------------------------------------
+        // The stage's MAPVIEW_MAPMODELFILENAME model (its grid, the outline of the play area, obstacle solids), in map
+        // units with x/z on the map's plane and y down. While the table shows the map the game no longer draws its 3D
+        // (native/compat/ga2_battledraw.cpp), so the plate shows this instead: the lines glow, the solids are faint
+        // glass, all standing on the plate in true height, clipped to the round plate and fading at its rim.
+        const char *kMapVs = R"(#version 330
+layout(location = 0) in vec3 pos;
+layout(location = 2) in vec4 col;
+uniform mat4 mvp;
+uniform mat4 toTable; // model -> table (u, v) metres in x, y
+uniform float radius;
+out vec4 v_col;
+out vec2 v_t;
+void main()
+{
+    v_col = col;
+    v_t = (toTable * vec4(pos, 1.0)).xy / radius;
+    gl_Position = mvp * vec4(pos, 1.0);
+})";
+        const char *kMapFs = R"(#version 330
+in vec4 v_col;
+in vec2 v_t;
+uniform vec3 tint;
+uniform float alpha;
+out vec4 o;
+void main()
+{
+    float e = length(v_t);
+    if (e > 1.0) discard;
+    float fade = 1.0 - smoothstep(0.72, 1.0, e);
+    vec3 c = mix(tint, clamp(v_col.rgb * 2.0, 0.0, 1.5), 0.35);
+    o = vec4(c * alpha * fade, 0.0); // additive
+})";
+
+        struct MapGl
+        {
+            const void *mesh = nullptr;
+            GLuint program = 0, vao = 0, vbo = 0, lineEbo = 0, triEbo = 0;
+            GLsizei lines = 0, tris = 0;
+        } g_mapGl;
+
+        void drawMapModel(const M4 &viewProj, const ga2_battletable::State &st, const ga2_battletable::Pose &pose)
+        {
+            static const bool on = [] {
+                const char *v = std::getenv("GA2_NATIVE_MAP");
+                return !(v && *v == '0');
+            }();
+            if (!on || bvr_ships::stage().empty())
+                return;
+            const std::shared_ptr<const bvr_ships::Mesh> mesh = bvr_ships::mapModel();
+            if (!mesh)
+                return;
+            MapGl &g = g_mapGl;
+            if (!g.program)
+                g.program = compile(kMapVs, kMapFs, "map model");
+            if (g.mesh != mesh.get())
+            {
+                // One buffer for every part (12 floats a vertex: pos, uv, colour, normal), line and triangle indices.
+                std::vector<float> verts;
+                std::vector<uint32_t> lines, tris;
+                for (const bvr_ships::Mesh::Part &p : mesh->parts)
+                {
+                    const uint32_t base = uint32_t(verts.size() / 12);
+                    verts.insert(verts.end(), p.vertices.begin(), p.vertices.end());
+                    for (uint32_t i : p.lines)
+                        lines.push_back(base + i);
+                    for (uint32_t i : p.indices)
+                        tris.push_back(base + i);
+                }
+                if (!g.vao)
+                {
+                    glGenVertexArrays(1, &g.vao);
+                    glGenBuffers(1, &g.vbo);
+                    glGenBuffers(1, &g.lineEbo);
+                    glGenBuffers(1, &g.triEbo);
+                }
+                glBindVertexArray(g.vao);
+                glBindBuffer(GL_ARRAY_BUFFER, g.vbo);
+                glBufferData(GL_ARRAY_BUFFER, GLsizeiptr(verts.size() * sizeof(float)), verts.data(), GL_STATIC_DRAW);
+                glEnableVertexAttribArray(0);
+                glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 12 * sizeof(float), nullptr);
+                glEnableVertexAttribArray(2);
+                glVertexAttribPointer(2, 4, GL_FLOAT, GL_FALSE, 12 * sizeof(float), reinterpret_cast<void *>(5 * sizeof(float)));
+                glBindVertexArray(0);
+                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, g.lineEbo);
+                glBufferData(GL_ELEMENT_ARRAY_BUFFER, GLsizeiptr(lines.size() * sizeof(uint32_t)), lines.data(), GL_STATIC_DRAW);
+                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, g.triEbo);
+                glBufferData(GL_ELEMENT_ARRAY_BUFFER, GLsizeiptr(tris.size() * sizeof(uint32_t)), tris.data(), GL_STATIC_DRAW);
+                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+                g.lines = GLsizei(lines.size()), g.tris = GLsizei(tris.size());
+                g.mesh = mesh.get();
+                std::fprintf(stderr, "[bvr] map model on the table: %d line segments, %d triangles\n", g.lines / 2, g.tris / 3);
+            }
+            // Map (x, y down, z) -> play space: the table's own map transform (turned and scaled), 3 mm over the glass.
+            // Heights flattened (15 % by default, GA2_MAP_HEIGHT): the play area's posts and the obstacle solids span
+            // +-4 map units, a fifth of the stage's width, and at true scale stood over the units like walls.
+            static const float heightScale = [] {
+                const char *v = std::getenv("GA2_MAP_HEIGHT");
+                return v && *v ? std::clamp(float(std::atof(v)), 0.0f, 1.0f) : 0.15f;
+            }();
+            const float lift = 0.003f;
+            float u0 = 0, v0 = 0, ux = 0, vx = 0, uz = 0, vz = 0;
+            ga2_battletable::mapToTable(st, 0.0f, 0.0f, u0, v0);
+            ga2_battletable::mapToTable(st, 1.0f, 0.0f, ux, vx);
+            ga2_battletable::mapToTable(st, 0.0f, 1.0f, uz, vz);
+            const V3 o = playPoint(pose, u0, v0, lift);
+            const V3 ex = playPoint(pose, ux, vx, lift) - o, ez = playPoint(pose, uz, vz, lift) - o;
+            const V3 up = normalize(playPoint(pose, u0, v0, lift + 0.01f) - o) * (length(ex) * heightScale);
+            M4 model;
+            model.m[0] = ex.x, model.m[1] = ex.y, model.m[2] = ex.z, model.m[3] = 0;
+            model.m[4] = -up.x, model.m[5] = -up.y, model.m[6] = -up.z, model.m[7] = 0;
+            model.m[8] = ez.x, model.m[9] = ez.y, model.m[10] = ez.z, model.m[11] = 0;
+            model.m[12] = o.x, model.m[13] = o.y, model.m[14] = o.z, model.m[15] = 1;
+            M4 toTable;
+            for (float &x : toTable.m)
+                x = 0.0f;
+            toTable.m[0] = ux - u0, toTable.m[1] = vx - v0;
+            toTable.m[8] = uz - u0, toTable.m[9] = vz - v0;
+            toTable.m[12] = u0, toTable.m[13] = v0, toTable.m[15] = 1.0f;
+            glUseProgram(g.program);
+            setMatrix(g.program, "mvp", mul(viewProj, model));
+            setMatrix(g.program, "toTable", toTable);
+            glUniform1f(glGetUniformLocation(g.program, "radius"), pose.halfWidth);
+            const GLint locTint = glGetUniformLocation(g.program, "tint"), locAlpha = glGetUniformLocation(g.program, "alpha");
+            glEnable(GL_BLEND);
+            glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+            glDepthMask(GL_FALSE);
+            glEnable(GL_DEPTH_TEST);
+            glDepthFunc(GL_LEQUAL);
+            glBindVertexArray(g.vao);
+            if (g.tris)
+            {
+                glUniform3f(locTint, 0.35f, 0.75f, 1.0f);
+                glUniform1f(locAlpha, 0.10f);
+                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, g.triEbo);
+                glDrawElements(GL_TRIANGLES, g.tris, GL_UNSIGNED_INT, nullptr);
+            }
+            if (g.lines)
+            {
+                glUniform3f(locTint, 0.45f, 1.0f, 0.75f);
+                glUniform1f(locAlpha, 0.55f);
+                glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, g.lineEbo);
+                glDrawElements(GL_LINES, g.lines, GL_UNSIGNED_INT, nullptr);
+            }
+            glBindVertexArray(0);
+            glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+        }
+
         // ---- palm menus (battlevr/bvr_hands.h; after BattleGroupVR's hand menus) -----------------------------------
         // Turn a palm toward the face and its menu shows over it; the other hand's fingertip pokes its keys.
         //   left palm, "Squadron": the angels (their own icons, shield bars, the selected one lit): a poke selects one
@@ -1794,6 +1942,8 @@ void main()
             glUniform4fv(glGetUniformLocation(g_tableGl.table, "masks"), 8, masks);
             setUnitIcons(g_tableGl.table, st); // the game's flat unit icons are left off the plate
             drawArrays(g_tableGl.vao7, g_tableGl.vbo7, mesh, 7);
+            if (mapShown)
+                drawMapModel(viewProj, st, pose);
             if (mapShown)
                 drawHudPanels(viewProj, eye, picture, extentX, extentY, st, pose);
 
