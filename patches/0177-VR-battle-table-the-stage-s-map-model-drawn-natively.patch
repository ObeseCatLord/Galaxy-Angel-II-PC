                         finite3(part.vertices[base + c2].pos))
                         part.indices.insert(part.indices.end(), {base + uint32_t(a), base + uint32_t(b2), base + uint32_t(c2)});
                 };
-                if (prim == 3)
+                auto line = [&](size_t a, size_t b2) {
+                    if (finite3(part.vertices[base + a].pos) && finite3(part.vertices[base + b2].pos))
+                        part.lines.insert(part.lines.end(), {base + uint32_t(a), base + uint32_t(b2)});
+                };
+                if (prim == 1)
+                    for (size_t i = 0; i + 1 < count; i += 2)
+                        line(i, i + 1);
+                else if (prim == 2)
