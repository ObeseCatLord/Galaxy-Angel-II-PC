     void IopEmulator::runEeCycles(uint64_t eeCycles) noexcept
     {
-        const uint64_t total = m_impl->eeCycleCarry + eeCycles;
-        const uint64_t iopCycles = total / 8u;
-        m_impl->eeCycleCarry = total % 8u;
-        // IOP time is EE time / 8. Synchronous RPC waits and slice overshoot
-        // run the IOP past that (measured ~0.9% in GA2, which made the SPU
-        // produce ~48420 samples per real second); the EE clock repays that
-        // lead instead of stacking new budget on top of it. A lead beyond
-        // kMaxIopLeadCycles (e.g. a long module start) is forgiven so the IOP
-        // never stalls for long.
         Impl &impl = *m_impl;
-        impl.eeIopClock += iopCycles;
-        if (impl.totalCycles > impl.eeIopClock + kMaxIopLeadCycles)
-            impl.eeIopClock = impl.totalCycles - kMaxIopLeadCycles;
-        if (impl.eeIopClock > impl.totalCycles)
-            impl.runCycles(impl.eeIopClock - impl.totalCycles);
+        if (eeCycles < impl.quietEe && impl.kernel.stateEpoch() == impl.quietEpoch)
+        {
+            if (Impl::deferMode() != Impl::DeferMode::Check)
+            {
+                // Idle over the whole grant: count it (see Impl::deferredEe).
+                impl.quietEe -= eeCycles;
+                impl.deferredEe += eeCycles;
+                return;
+            }
+            // Check mode: apply the grant the old way and verify it only moved the clocks.
+            const uint64_t quiet = impl.quietEe - eeCycles;
+            const Impl::IdleSignature before = impl.idleSignature();
+            const uint64_t expected = std::max(impl.totalCycles, impl.eeIopClock + (impl.eeCycleCarry + eeCycles) / 8u);
+            impl.grantEeCycles(eeCycles);
+            if (!(impl.idleSignature() == before) || impl.totalCycles != expected || impl.resetRequired)
+            {
+                std::fprintf(stderr, "[IOP] idle deferral check failed: a grant of %llu EE cycles inside the quiet horizon (%llu left) "
+                                     "changed IOP state (cycle %llu, expected %llu)\n",
+                             static_cast<unsigned long long>(eeCycles), static_cast<unsigned long long>(quiet),
+                             static_cast<unsigned long long>(impl.totalCycles), static_cast<unsigned long long>(expected));
+                std::abort();
+            }
+            impl.quietEe = quiet;
+            if ((++impl.deferChecked & 0xFFFFFFu) == 0u)
+                std::fprintf(stderr, "[IOP] idle deferral check: %llu grants verified\n", static_cast<unsigned long long>(impl.deferChecked));
+            return;
+        }
+        impl.settle();
+        impl.grantEeCycles(eeCycles);
+        impl.quietEe = impl.quietEeCycles();
+        impl.quietEpoch = impl.kernel.stateEpoch();
+    }
+
+    bool IopEmulator::tryDeferEeCycles(uint64_t eeCycles) noexcept
+    {
+        Impl &impl = *m_impl;
+        if (eeCycles >= impl.quietEe || impl.kernel.stateEpoch() != impl.quietEpoch || Impl::deferMode() != Impl::DeferMode::On)
+            return false;
+        impl.quietEe -= eeCycles;
+        impl.deferredEe += eeCycles;
+        return true;
     }
 
