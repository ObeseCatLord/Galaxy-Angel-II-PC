         uint64_t totalInstructions = 0;
         uint64_t eeCycleCarry = 0;
         uint64_t eeIopClock = 0; // IOP cycles the EE clock has granted
+        // Idle deferral (GA2_IOP_DEFER=0: off; =check: every deferrable grant is applied and verified instead).
+        // While the IOP is provably idle (nothing Ready, no deadline of any kind before a known IOP cycle), a grant of
+        // EE cycles changes nothing but the clocks; such grants are summed here and applied in one piece at the first
+        // grant that reaches the horizon, or before anything else enters the emulator (settle()). The EE grants a few
+        // cycles at every branch it takes, so this is the difference between one addition and a pass through the
+        // scheduler, millions of times a second.
+        uint64_t deferredEe = 0; // EE cycles granted but not applied yet
+        uint64_t quietEe = 0;    // further EE cycles that may be deferred (0: apply every grant at once)
+        uint64_t quietEpoch = 0; // kernel.stateEpoch() the horizon was computed at
+        uint64_t deferChecked = 0; // check mode: grants verified
+        enum class DeferMode { Off, On, Check };
+        static DeferMode deferMode() noexcept
+        {
+            static const DeferMode mode = [] {
+                const char *v = std::getenv("GA2_IOP_DEFER");
+                if (!v || !*v) return DeferMode::On;
+                if (std::string_view(v) == "check") return DeferMode::Check;
+                return *v == '0' ? DeferMode::Off : DeferMode::On;
+            }();
+            return mode;
+        }
+
+        // The grant as it always was: EE cycles become IOP cycles (8:1) and the IOP runs up to the granted clock.
+        void grantEeCycles(uint64_t eeCycles) noexcept
+        {
+            const uint64_t total = eeCycleCarry + eeCycles;
+            const uint64_t iopCycles = total / 8u;
+            eeCycleCarry = total % 8u;
+            // IOP time is EE time / 8. Synchronous RPC waits and slice overshoot
+            // run the IOP past that (measured ~0.9% in GA2, which made the SPU
+            // produce ~48420 samples per real second); the EE clock repays that
+            // lead instead of stacking new budget on top of it. A lead beyond
+            // kMaxIopLeadCycles (e.g. a long module start) is forgiven so the IOP
+            // never stalls for long.
+            eeIopClock += iopCycles;
+            if (totalCycles > eeIopClock + kMaxIopLeadCycles)
+                eeIopClock = totalCycles - kMaxIopLeadCycles;
+            if (eeIopClock > totalCycles)
+                runCycles(eeIopClock - totalCycles);
+        }
+
+        // Ends the deferral: the deferred grants become what they would have been one by one, clock ticks and nothing
+        // else (that is what the horizon proved when it was computed, and nothing can have run since). Called before
+        // anything else enters the emulator, and before a grant that is applied. Not through grantEeCycles: a thread
+        // woken from outside since (stateEpoch) must start at the clock the grants reached, not before them.
+        void settle() noexcept
+        {
+            quietEe = 0;
+            if (deferredEe == 0u)
+                return;
+            const uint64_t total = eeCycleCarry + deferredEe;
+            deferredEe = 0;
+            eeCycleCarry = total % 8u;
+            eeIopClock += total / 8u; // the lead was within kMaxIopLeadCycles and only shrank: nothing to forgive
+            if (eeIopClock > totalCycles)
+                totalCycles = eeIopClock; // below every deadline and the SPU's next sample
+        }
+
+        // How many EE cycles the coming grants may sum up to before one of them does more than move the clocks; 0
+        // when that cannot be shown. The first grant that brings the granted IOP clock to `act` must be applied:
+        // `act` is the earliest deadline of any kind (thread delay, DMA completion, alarm or queued callback, timer,
+        // the SPU's next sample), or the very next cycle past the IOP's own clock when something is due now (a Ready
+        // thread, a passed deadline). Deadlines masked work cannot reach are counted too: applying early is always
+        // exact, it is what happened on every grant before.
+        [[nodiscard]] uint64_t quietEeCycles() const noexcept
+        {
+            if (deferMode() == DeferMode::Off || resetRequired || syncingSpu || callDepth != 0u || activeCpu != nullptr ||
+                rpcWaitCpu != nullptr || servicingDmaInterrupts || servicingGuestCallbacks || executingAlarm != nullptr ||
+                kernel.hasCurrentThread() || pendingSpuIrq)
+                return 0u;
+            if (totalCycles > eeIopClock + kMaxIopLeadCycles)
+                return 0u; // the next grant forgives part of the lead: not additive
+            bool dueNow = kernel.anyReady() || ga2::spu::autoDmaCompletionPending();
+            uint64_t wake = kernel.nextWakeCycle(UINT64_MAX);
+            for (const auto &[irq, dma] : pendingDmaInterrupts)
+                wake = std::min(wake, dma.deadline);
+            if (!pendingGuestCallbacks.empty())
+                wake = std::min(wake, pendingGuestCallbacks.begin()->first);
+            wake = timrman.nextEventCycle(wake);
+            if (spu)
+            {
+                if (spuNextSample == 0u) dueNow = true; // unknown: the next advance takes the full SPU path
+                else wake = std::min(wake, spuNextSample);
+            }
+            if (wake <= totalCycles) dueNow = true;
+            const uint64_t act = dueNow ? totalCycles + 1u : wake;
+            if (act <= eeIopClock)
+                return 0u;
+            const uint64_t iopCycles = std::min<uint64_t>(act - eeIopClock, uint64_t(1) << 40u);
+            return iopCycles * 8u - eeCycleCarry; // eeCycleCarry < 8
+        }
+
+        // GA2_IOP_DEFER=check: what a deferred grant must leave untouched.
+        struct IdleSignature
+        {
+            uint64_t instructions, identity, kernelWake, timerEvent, spuCycle, callbackFirst, dmaDeadlines;
+            size_t callbacks, dmas, threads;
+            uint32_t interruptStatus;
+            bool ready, current, autoDma, spuIrq;
+            bool operator==(const IdleSignature &) const = default;
+        };
+        [[nodiscard]] IdleSignature idleSignature() const noexcept
+        {
+            IdleSignature s{};
+            s.instructions = totalInstructions;
+            s.identity = nextCallbackIdentity;
+            s.kernelWake = kernel.nextWakeCycle(UINT64_MAX);
+            s.timerEvent = timrman.nextEventCycle(UINT64_MAX);
+            s.spuCycle = spu ? spu->lastIopCycle() : 0u;
+            s.callbackFirst = pendingGuestCallbacks.empty() ? 0u : pendingGuestCallbacks.begin()->first;
+            for (const auto &[irq, dma] : pendingDmaInterrupts)
+                s.dmaDeadlines = s.dmaDeadlines * 1099511628211ull + dma.deadline + uint64_t(irq);
+            s.callbacks = pendingGuestCallbacks.size();
+            s.dmas = pendingDmaInterrupts.size();
+            s.threads = kernel.threadCount();
+            s.interruptStatus = memory.interruptStatus();
+            s.ready = kernel.anyReady();
+            s.current = kernel.hasCurrentThread();
+            s.autoDma = ga2::spu::autoDmaCompletionPending();
+            s.spuIrq = pendingSpuIrq;
+            return s;
+        }
         CpuState *activeCpu = nullptr;
         CpuState *rpcWaitCpu = nullptr;
         uint64_t rpcInstructionDeadline = 0;
