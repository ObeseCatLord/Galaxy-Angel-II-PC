+            t.IsTrue(palm.step(in, 0.3), "40 degrees keeps it open");
+            in.normal = turned(60.0f);
+            t.IsFalse(palm.step(in, 0.4), "60 degrees closes it");
+            in.normal = turned(40.0f);
+            t.IsFalse(palm.step(in, 0.5), "40 degrees does not open it again");
+            in.normal = bvr_hands::unit(in.head - in.palm);
+            in.busy = true;
+            t.IsFalse(palm.step(in, 1.0), "a gripping hand has no menu");
+            in.busy = false;
+            in.palm = {0, -0.6f, -0.6f};
+            in.normal = bvr_hands::unit(in.head - in.palm);
+            palm.step(in, 2.0);
+            t.IsFalse(palm.step(in, 3.0), "out of reach (beyond 0.7 m): no menu");
+        });
+
+        tc.Run("a key fires once when poked from the front, after its travel, and not again until let go", [](TestCase &t) {
+            bvr_hands::Frame f;
+            f.centre = {0, 0, 0}, f.right = {1, 0, 0}, f.up = {0, 1, 0}, f.normal = {0, 0, 1};
+            std::vector<bvr_hands::Key> keys = {{7, -0.02f, -0.02f, 0.02f, 0.02f, true}, {8, 0.03f, -0.02f, 0.07f, 0.02f, false}};
+            bvr_hands::Keys k;
+            t.Equals(k.step(f, keys, true, {0, 0, 0.02f}, 0.0), 0, "hovering in front");
+            t.Equals(k.hovered(), 7, "the key under the finger");
+            t.Equals(k.step(f, keys, true, {0, 0, -0.004f}, 0.05), 0, "4 mm in: not yet");
+            t.Equals(k.step(f, keys, true, {0, 0, -0.007f}, 0.10), 7, "7 mm in: fires");
+            t.Equals(k.step(f, keys, true, {0, 0, -0.008f}, 0.20), 0, "held: no repeat");
