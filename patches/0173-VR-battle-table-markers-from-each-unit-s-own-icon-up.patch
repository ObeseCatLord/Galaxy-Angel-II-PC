+void register_bvr_hands_tests()
+{
+    MiniTest::Case("BvrHands", [](TestCase &tc) {
+        tc.Run("a palm menu opens after facing the head for a moment and closes past the wider angle", [](TestCase &t) {
+            bvr_hands::Palm palm;
+            bvr_hands::PalmInput in;
+            in.valid = true;
+            in.head = {0, 0, 0};
+            in.palm = {0, -0.3f, -0.3f};
+            in.fingers = {0, 1, 0};
+            in.normal = bvr_hands::unit(in.head - in.palm); // straight at the face
+            t.IsFalse(palm.step(in, 0.0), "not at once");
+            t.IsFalse(palm.step(in, 0.1), "not before the dwell");
+            t.IsTrue(palm.step(in, 0.2), "open after the dwell");
+            const bvr_hands::Frame f = palm.frame();
+            t.IsTrue(bvr_hands::dot(f.normal, bvr_hands::unit(in.head - f.centre)) > 0.99f, "the menu faces the head");
+            t.IsTrue(bvr_hands::dot(f.centre - in.palm, in.normal) > 0.03f, "it floats off the palm");
+            // Turned 40 degrees away: still open (closes beyond 50); 60 degrees: closed.
+            auto turned = [&](float degrees) {
+                const float r = degrees * 0.0174533f;
+                const V n = in.normal, side{1, 0, 0};
+                return bvr_hands::unit(n * std::cos(r) + side * std::sin(r));
+            };
