 }
+
+namespace bvr_ships
+{
+    std::shared_ptr<const bvr_assets::Texture> unitIcon(int unitId, int expression)
+    {
+        Loader &l = loader();
+        std::lock_guard<std::mutex> lock(l.mutex);
+        if (l.stage < 0 || unitId < 0 || expression < 0 || expression >= 64)
+            return nullptr;
+        const bvr_assets::StageUnit *su = l.stages[size_t(l.stage)].unit(unitId);
+        if (!su || su->icons.empty())
+            return nullptr;
+        const int key = unitId * 64 + std::min<int>(expression, int(su->icons.size()) - 1);
+        if (const auto it = l.icons.find(key); it != l.icons.end())
+            return it->second;
+        if (!l.iconRequested[key])
+        {
+            l.iconRequested[key] = true;
+            l.queue.push_front(kIconJob + key);
+            l.wake.notify_one();
+        }
+        return nullptr;
+    }
+
+    float stageExtent()
+    {
+        Loader &l = loader();
+        std::lock_guard<std::mutex> lock(l.mutex);
+        if (l.stage < 0)
+            return 0.0f;
+        const bvr_assets::Stage &s = l.stages[size_t(l.stage)];
+        return std::max(s.size[0], s.size[2]);
+    }
+}
