diff --git a/ps2xRuntime/src/lib/battlevr/bvr_hands.h b/ps2xRuntime/src/lib/battlevr/bvr_hands.h
new file mode 100644
index 0000000..b54d952
--- /dev/null
+++ b/ps2xRuntime/src/lib/battlevr/bvr_hands.h
@@ -0,0 +1,305 @@
+// The VR battle table's hand furniture, as pure logic (no GL, no OpenXR; unit-tested in ps2xTest):
+//   - the palm menus (after BattleGroupVR's hand menus, behaviour only): a menu shows on a palm turned toward the face
+//     and is worked by the other hand's fingertip poking its keys;
+//   - floating panels the player places: a grip with the hand on a panel carries it, and its place is remembered.
+// Play space: metres, x right, y up, -z ahead (OpenXR).
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace bvr_hands
+{
+    struct V
+    {
+        float x = 0, y = 0, z = 0;
+    };
+    inline V operator+(V a, V b) { return {a.x + b.x, a.y + b.y, a.z + b.z}; }
+    inline V operator-(V a, V b) { return {a.x - b.x, a.y - b.y, a.z - b.z}; }
+    inline V operator*(V a, float k) { return {a.x * k, a.y * k, a.z * k}; }
+    inline float dot(V a, V b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
+    inline V cross(V a, V b) { return {a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x}; }
+    inline float len(V a) { return std::sqrt(dot(a, a)); }
+    inline V unit(V a)
+    {
+        const float l = len(a);
+        return l > 1e-6f ? a * (1.0f / l) : V{0, 0, 0};
+    }
+
+    // ---- palm menus ----------------------------------------------------------------------------------------------
+    constexpr float kOpenDegrees = 35.0f;  // palm normal within this of the palm-to-head direction: opens
+    constexpr float kCloseDegrees = 50.0f; // beyond this: closes
+    constexpr double kOpenDwell = 0.15;    // seconds the palm must face the head before the menu shows
+    constexpr float kMaxReach = 0.7f;      // the hand within this of the head
+    constexpr float kMenuLift = 0.035f;    // the menu floats this far off the palm, toward the head
+
+    struct PalmInput
+    {
+        bool valid = false;
+        V palm;          // the palm's centre
+        V normal;        // out of the palm (unit)
+        V fingers;       // from the wrist toward the fingers (unit)
+        bool busy = false; // gripping, or dragging an order: no menu
+        V head;
+    };
+
+    // Where a menu is drawn: centre and axes (right, up in the menu's plane, facing the head; normal toward the head).
+    struct Frame
+    {
+        V centre, right, up, normal;
+    };
+
+    class Palm
+    {
+    public:
+        // One headset frame; true while the menu shows.
+        bool step(const PalmInput &in, double now)
+        {
+            if (!in.valid || in.busy)
+            {
+                open_ = false;
+                since_ = -1.0;
+                return false;
+            }
+            const V toHead = in.head - in.palm;
+            const float dist = len(toHead);
+            const float c = dist > 1e-4f ? dot(unit(toHead), in.normal) : -1.0f;
+            const float angle = std::acos(std::clamp(c, -1.0f, 1.0f)) * 57.29578f;
+            const bool facing = dist < kMaxReach && angle < (open_ ? kCloseDegrees : kOpenDegrees);
+            if (!facing)
+            {
+                open_ = false;
+                since_ = -1.0;
+            }
+            else if (!open_)
+            {
+                if (since_ < 0.0)
+                    since_ = now;
+                if (now - since_ >= kOpenDwell)
+                    open_ = true;
+            }
+            if (open_)
+            {
+                // Facing the head, upright along the fingers (seen from the head: the fingers point up the menu).
+                frame_.normal = unit(toHead);
+                frame_.centre = in.palm + in.normal * kMenuLift + in.fingers * 0.02f;
+                V up = in.fingers - frame_.normal * dot(in.fingers, frame_.normal);
+                if (len(up) < 1e-3f)
+                    up = V{0, 1, 0};
+                frame_.up = unit(up);
+                frame_.right = unit(cross(frame_.up, frame_.normal));
+            }
+            return open_;
+        }
+        bool open() const { return open_; }
+        const Frame &frame() const { return frame_; }
+        // Shown at a given frame regardless of the hand (screenshots and tests).
+        void force(const Frame &f)
+        {
+            open_ = true;
+            frame_ = f;
+        }
+
+    private:
+        bool open_ = false;
+        double since_ = -1.0;
+        Frame frame_;
+    };
+
+    // A pressable key on a menu: a rectangle in the menu's plane (metres from its centre, x right, y up).
+    struct Key
+    {
+        int id = 0;
+        float x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+        bool enabled = true;
+    };
+
+    // Poking: the fingertip enters a key from the front. The cap travels 8 mm (drawn by the renderer from depth());
+    // it fires at 6 mm and is let go above 3 mm; one key at a time; 150 ms between presses.
+    constexpr float kTravel = 0.008f, kFire = 0.006f, kRelease = 0.003f, kHover = 0.03f;
+    constexpr double kDebounce = 0.15;
+
+    class Keys
+    {
+    public:
+        // The fingertip of the other hand against the keys of a menu (tipValid false: no finger). Returns the id of a
+        // key pressed this frame, else 0. hovered(): the key under the finger (within 3 cm in front), else 0.
+        int step(const Frame &f, const std::vector<Key> &keys, bool tipValid, V tip, double now)
+        {
+            hovered_ = 0;
+            depth_ = 0.0f;
+            if (!tipValid)
+            {
+                down_ = 0;
+                return 0;
+            }
+            const V d = tip - f.centre;
+            const float x = dot(d, f.right), y = dot(d, f.up), h = dot(d, f.normal); // h > 0: in front
+            const Key *under = nullptr;
+            for (const Key &k : keys)
+                if (x >= k.x0 && x <= k.x1 && y >= k.y0 && y <= k.y1)
+                    under = &k;
+            if (down_)
+            {
+                // Held: let go when the finger backs out (or slides off the key).
+                if (!under || under->id != down_ || -h < kRelease)
+                    down_ = 0;
+                else
+                {
+                    hovered_ = down_;
+                    depth_ = std::clamp(-h, 0.0f, kTravel);
+                }
+                return 0;
+            }
+            if (!under || h > kHover || -h > 0.04f)
+                return 0;
+            hovered_ = under->id;
+            depth_ = std::clamp(-h, 0.0f, kTravel);
+            if (-h >= kFire && under->enabled && now - last_ >= kDebounce)
+            {
+                // Only a key entered from the front fires (not one the finger reached from behind the menu).
+                if (frontSeen_ == under->id)
+                {
+                    down_ = under->id;
+                    last_ = now;
+                    return under->id;
+                }
+            }
+            if (h > 0.0f)
+                frontSeen_ = under->id;
+            return 0;
+        }
+        int hovered() const { return hovered_; }
+        float depth() const { return depth_; }
+        int held() const { return down_; }
+
+    private:
+        int hovered_ = 0, down_ = 0, frontSeen_ = 0;
+        float depth_ = 0.0f;
+        double last_ = -10.0;
+    };
+
+    // ---- floating panels -----------------------------------------------------------------------------------------
+    // A panel's place relative to the table (the table's frame: u right, v away, h up from its centre; yaw radians
+    // added to its facing), and a size factor.
+    struct Place
+    {
+        float u = 0, v = 0, h = 0;
+        float scale = 1.0f;
+        bool set = false; // false: the panel's default place
+    };
+
+    struct PanelHit
+    {
+        int id = -1;
+        V centre, right, up; // half axes (metres)
+    };
+
+    // Grabbing: a hand's grip pressed while its palm (or fingertip) is on a panel (within 5 cm of its plane, inside it
+    // with a 2 cm margin) takes the panel; it follows the hand (the hand's offset kept) until the grip is let go.
+    class Grabber
+    {
+    public:
+        // grip: 0..1 per hand; points: the palm (and fingertip) per hand. Returns true when a hand holds a panel
+        // (that hand's grip is not the table's then). heldBy(id): the hand holding panel id, or -1.
+        struct HandIn
+        {
+            bool valid = false;
+            float grip = 0.0f;
+            V palm, tip;
+        };
+        void step(const HandIn hands[2], const std::vector<PanelHit> &panels)
+        {
+            for (int h = 0; h < 2; ++h)
+            {
+                const HandIn &in = hands[h];
+                const bool on = in.valid && in.grip > (held_[h] >= 0 ? 0.4f : 0.6f);
+                if (!on)
+                {
+                    held_[h] = -1;
+                    wasGrip_[h] = in.valid && in.grip > 0.6f;
+                    continue;
+                }
+                if (held_[h] < 0 && !wasGrip_[h])
+                {
+                    // A new grip: on a panel?
+                    float best = 1e9f;
+                    for (const PanelHit &p : panels)
+                        for (V q : {in.palm, in.tip})
+                        {
+                            const V d = q - p.centre;
+                            const float ru = len(p.right), rv = len(p.up);
+                            if (ru < 1e-4f || rv < 1e-4f)
+                                continue;
+                            const float x = dot(d, unit(p.right)), y = dot(d, unit(p.up));
+                            const V n = unit(cross(p.right, p.up));
+                            const float z = std::fabs(dot(d, n));
+                            if (std::fabs(x) <= ru + 0.02f && std::fabs(y) <= rv + 0.02f && z < 0.05f && z < best &&
+                                held_[h ^ 1] != p.id)
+                            {
+                                best = z;
+                                held_[h] = p.id;
+                                offset_[h] = p.centre - in.palm;
+                            }
+                        }
+                }
+                wasGrip_[h] = true;
+            }
+        }
+        int heldBy(int id) const
+        {
+            for (int h = 0; h < 2; ++h)
+                if (held_[h] == id)
+                    return h;
+            return -1;
+        }
+        int held(int hand) const { return held_[hand & 1]; }
+        // Where a held panel's centre goes for a hand's palm.
+        V target(int hand, V palm) const { return palm + offset_[hand & 1]; }
+
+    private:
+        int held_[2] = {-1, -1};
+        bool wasGrip_[2] = {false, false};
+        V offset_[2];
+    };
+
+    // Places as text (one panel a line: "id u v h scale"), for the layout file in the data folder.
+    inline std::string formatPlaces(const std::map<int, Place> &places)
+    {
+        std::string out;
+        char line[128];
+        for (const auto &[id, p] : places)
+            if (p.set)
+            {
+                std::snprintf(line, sizeof(line), "%d %.4f %.4f %.4f %.3f\n", id, p.u, p.v, p.h, p.scale);
+                out += line;
+            }
+        return out;
+    }
+    inline std::map<int, Place> parsePlaces(const std::string &text)
+    {
+        std::map<int, Place> out;
+        size_t at = 0;
+        while (at < text.size())
+        {
+            const size_t end = std::min(text.find('\n', at), text.size());
+            const std::string line = text.substr(at, end - at);
+            int id = 0;
+            Place p;
+            if (std::sscanf(line.c_str(), "%d %f %f %f %f", &id, &p.u, &p.v, &p.h, &p.scale) == 5 && std::isfinite(p.u) &&
+                std::isfinite(p.v) && std::isfinite(p.h) && p.scale > 0.2f && p.scale < 5.0f && std::fabs(p.u) < 5.0f &&
+                std::fabs(p.v) < 5.0f && std::fabs(p.h) < 5.0f)
+            {
+                p.set = true;
+                out[id] = p;
+            }
+            at = end + 1;
+        }
+        return out;
+    }
+}
