Subject: [PATCH 161/171] VR battle renderer assets: stage tables, ship parts
 (enemies assembled from their part tables), textures by TEXDIR

---
 ps2xRuntime/src/lib/battlevr/bvr_assets.cpp | 89 +++++++++++++++++++++
 ps2xRuntime/src/lib/battlevr/bvr_assets.h   | 33 ++++++++
 ps2xTest/src/bvr_assets_tests.cpp           | 19 +++++
 3 files changed, 141 insertions(+)

diff --git a/ps2xRuntime/src/lib/battlevr/bvr_assets.cpp b/ps2xRuntime/src/lib/battlevr/bvr_assets.cpp
index e28fe52..6ee8a83 100644
--- a/ps2xRuntime/src/lib/battlevr/bvr_assets.cpp
+++ b/ps2xRuntime/src/lib/battlevr/bvr_assets.cpp
@@ -406,6 +406,95 @@ namespace bvr_assets
         return out;
     }
 
+    // ---- stages and ships ---------------------------------------------------------------------------------------
+
+    const StageUnit *Stage::unit(int id) const
+    {
+        for (const StageUnit &u : units)
+            if (u.id == id)
+                return &u;
+        return nullptr;
+    }
+
+    bool loadStage(const Archive &archive, const std::string &path, Stage &stage)
+    {
+        std::vector<uint8_t> text;
+        if (!archive.read(path, text))
+            return false;
+        Table table;
+        parseTable(text.data(), text.size(), table);
+        stage = Stage{};
+        stage.path = path;
+        stage.size[0] = table.number("STAGE", "SIZE_X", 0.0f);
+        stage.size[1] = table.number("STAGE", "SIZE_Y", 0.0f);
+        stage.size[2] = table.number("STAGE", "SIZE_Z", 0.0f);
+        for (const Table::Section &s : table.sections)
+        {
+            const std::string *id = table.get(s.name, "ID"), *model = table.get(s.name, "MODEL_FILENAME");
+            if (!id || !model)
+                continue;
+            StageUnit u;
+            u.id = std::atoi(id->c_str());
+            u.section = s.name;
+            if (const std::string *v = table.get(s.name, "NAME"))
+                u.name = *v;
+            u.modelTable = *model;
+            if (const std::string *v = table.get(s.name, "UNITE_MODEL_FILENAME"))
+                u.uniteTable = *v;
+            u.start[0] = table.number(s.name, "START_POS_X", 0.0f);
+            u.start[1] = table.number(s.name, "START_POS_Y", 0.0f);
+            u.start[2] = table.number(s.name, "START_POS_Z", 0.0f);
+            u.startRot = table.number(s.name, "START_ROT", 0.0f);
+            stage.units.push_back(u);
+        }
+        return !stage.units.empty();
+    }
+
+    std::vector<std::string> stagePaths(const Archive &archive)
+    {
+        std::vector<std::string> out;
+        for (const std::string &p : archive.paths())
+            if (p.rfind("slg/stage/", 0) == 0 && p.size() > 10 && p.compare(p.size() - 10, 10, "/stage.tbl") == 0)
+                out.push_back(p);
+        std::sort(out.begin(), out.end());
+        return out;
+    }
+
+    bool shipParts(const Archive &archive, const std::string &modelTable, std::vector<ShipPart> &parts)
+    {
+        parts.clear();
+        std::function<void(const std::string &, int)> visit = [&](const std::string &tablePath, int depth) {
+            std::vector<uint8_t> text;
+            if (depth > 2 || !archive.read(tablePath, text))
+                return;
+            Table table;
+            parseTable(text.data(), text.size(), table);
+            const std::string *texDir = table.get("HEADER", "TEXDIR");
+            bool model = false;
+            for (const std::string &entry : table.list("MODELFILE"))
+            {
+                const std::string file = entry.substr(0, entry.find_first_of(" \t"));
+                // A part's table names the part, then its "b" variant (the broken part): the first is the ship's.
+                if (file.size() > 4 && file.compare(file.size() - 4, 4, ".axo") == 0 && !model)
+                {
+                    parts.push_back(ShipPart{file, texDir ? *texDir : std::string()});
+                    model = true;
+                }
+                else if (file.size() > 4 && file.compare(file.size() - 4, 4, ".tbl") == 0)
+                    visit(file, depth + 1);
+            }
+        };
+        visit(modelTable, 0);
+        return !parts.empty();
+    }
+
+    bool loadTexture(const Archive &archive, const std::string &texDir, const std::string &name, Texture &texture)
+    {
+        std::vector<uint8_t> data;
+        const bool found = (!texDir.empty() && archive.read(texDir + "/" + name + ".agi", data)) || archive.read(name + ".agi", data);
+        return found && decodeAgi(data.data(), data.size(), texture);
+    }
+
     // ---- AGI textures -------------------------------------------------------------------------------------------
 
     bool decodeAgi(const uint8_t *d, size_t n, Texture &t)
