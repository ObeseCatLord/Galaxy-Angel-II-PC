+    // A battle stage (slg/stage/<id>/stage.tbl): its size and its units.
+    struct StageUnit
+    {
+        int id = -1;              // the section's ID: 0 the mothership, 1.. the angels, 20.. the enemies
+        std::string section;      // MOTHERSHIP01, CREST01, ENEMY01 ...
+        std::string name;         // Shift-JIS
+        std::string modelTable;   // MODEL_FILENAME
+        std::string uniteTable;   // UNITE_MODEL_FILENAME (an angel's combined form), may be empty
+        float start[3] = {0, 0, 0}, startRot = 0.0f; // START_POS_X/Y/Z, START_ROT (degrees)
+    };
+    struct Stage
+    {
+        std::string path;
+        float size[3] = {0, 0, 0}; // SIZE_X/Y/Z
+        std::vector<StageUnit> units;
+        const StageUnit *unit(int id) const;
+    };
+    bool loadStage(const Archive &archive, const std::string &path, Stage &stage);
+    // Every slg/stage/<id>/stage.tbl on the disc.
+    std::vector<std::string> stagePaths(const Archive &archive);
+
+    // A ship: the model files of a model table, with the directory its textures live in. An angel's or the
+    // mothership's table names one .axo; an enemy's info table names one table per part (all modelled in place; each part
+    // table names the part, then its broken "b" variant, which is left out).
+    struct ShipPart
+    {
+        std::string model;   // .axo path
+        std::string texDir;  // TEXDIR of the part's table
+    };
+    bool shipParts(const Archive &archive, const std::string &modelTable, std::vector<ShipPart> &parts);
+    // A model's texture by name, from its table's TEXDIR first (names repeat across enemy directories).
+    bool loadTexture(const Archive &archive, const std::string &texDir, const std::string &name, Texture &texture);
+
     // A frame's model-space transform (its parents applied): row-major 3x3 in m[0..8], translation in m[9..11];
     // p' = M p + t.
     void frameTransform(const Model &model, int frameId, float m[12]);
