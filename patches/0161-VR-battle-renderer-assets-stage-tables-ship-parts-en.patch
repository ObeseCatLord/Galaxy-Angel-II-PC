+                t.IsTrue(crest && crest->modelTable == "slg/machines/si_mon_0000.tbl" && crest->start[0] == 1000.0f &&
+                             crest->start[2] == -3000.0f,
+                         "CREST01: Cross Caliber at (1000, 0, -3000)");
+                t.IsTrue(stage.size[0] == 32.0f, "SIZE_X");
+                std::vector<bvr_assets::ShipPart> parts;
+                t.IsTrue(enemy && bvr_assets::shipParts(archive, enemy->modelTable, parts), "ENEMY01's parts");
+                t.Equals(parts.size(), size_t(48), "the cruiser has 48 parts");
+                t.IsTrue(!parts.empty() && parts[0].model == "slg/machines/mes_0500/si_mes_0501.axo" &&
+                             parts[0].texDir == "slg/machines/mes_0500",
+                         "the first part and its texture directory");
+                bvr_assets::Texture tex;
+                t.IsTrue(bvr_assets::loadTexture(archive, "slg/machines", "si_mon_000", tex) && tex.width == 256, "a texture from TEXDIR");
+            }
             for (const Ref &r : refs)
             {
                 std::vector<uint8_t> data;
