diff --git a/ps2xRuntime/src/lib/ga2_fileread.cpp b/ps2xRuntime/src/lib/ga2_fileread.cpp
new file mode 100644
index 0000000..1567e10
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_fileread.cpp
@@ -0,0 +1,94 @@
+#include "runtime/ga2_fileread.h"
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace ga2_fileread
+{
+    bool File::open(const std::filesystem::path &path)
+    {
+        close();
+#ifdef _WIN32
+        const HANDLE h = CreateFileW(path.wstring().c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                     nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (h == INVALID_HANDLE_VALUE)
+            return false;
+        m_handle = reinterpret_cast<intptr_t>(h);
+        LARGE_INTEGER size{};
+        if (!GetFileSizeEx(h, &size))
+        {
+            close();
+            return false;
+        }
+        m_size = uint64_t(size.QuadPart);
+#else
+        const int fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (fd < 0)
+            return false;
+        m_handle = fd;
+        struct stat st{};
+        if (fstat(fd, &st) != 0)
+        {
+            close();
+            return false;
+        }
+        m_size = uint64_t(st.st_size);
+#endif
+        return true;
+    }
+
+    void File::close()
+    {
+        if (m_handle != kNone)
+        {
+#ifdef _WIN32
+            CloseHandle(reinterpret_cast<HANDLE>(m_handle));
+#else
+            ::close(int(m_handle));
+#endif
+        }
+        m_handle = kNone;
+        m_size = 0;
+    }
+
+    bool File::readAt(uint64_t offset, void *destination, size_t count) const
+    {
+        if (!isOpen() || offset > m_size || count > m_size - offset)
+            return false;
+        auto *out = static_cast<uint8_t *>(destination);
+        while (count > 0)
+        {
+#ifdef _WIN32
+            const DWORD chunk = DWORD(count > 0x40000000u ? 0x40000000u : count);
+            OVERLAPPED at{};
+            at.Offset = DWORD(offset & 0xFFFFFFFFu);
+            at.OffsetHigh = DWORD(offset >> 32);
+            DWORD got = 0;
+            if (!ReadFile(reinterpret_cast<HANDLE>(m_handle), out, chunk, &got, &at) || got == 0)
+                return false;
+#else
+            const ssize_t got = ::pread(int(m_handle), out, count, off_t(offset));
+            if (got < 0 && errno == EINTR)
+                continue; // interrupted by a signal: read again
+            if (got <= 0)
+                return false;
+#endif
+            out += size_t(got);
+            offset += uint64_t(got);
+            count -= size_t(got);
+        }
+        return true;
+    }
+}
