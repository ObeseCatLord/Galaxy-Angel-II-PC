+        // ---- the battle's own sky (the stage's [BG] models from the disc, bvr_ships::stageSky) ----
+        // Drawn as the game draws it: additive, texel x its alpha x the vertex colour x its alpha (0x80 = 1.0), around
+        // the viewer at infinity, turned with the map on the table so the sky around you is the map's own.
+        const char *kSkyMeshFs = R"(#version 330
+in vec2 v_uv;
+in vec4 v_col;
+in vec3 v_n;
+in vec3 v_w;
+uniform sampler2D tex;
+uniform int textured;
+out vec4 o;
+void main()
+{
+    vec4 t = textured != 0 ? texture(tex, v_uv) : vec4(1.0);
+    vec3 k = v_col.rgb * (255.0 / 128.0) * (v_col.a * (255.0 / 128.0));
+    o = vec4(t.rgb * t.a * k, 0.0);
+})";
+        GLuint g_skyMeshProgram = 0;
+
+        // The map's axes on the table (world directions of map +x, map +z, and the table's up).
+        bool mapAxes(const ga2_battletable::State &st, const ga2_battletable::Pose &pose, V3 &rx, V3 &fz, V3 &up)
+        {
+            float u0, v0, u1, v1, u2, v2;
+            ga2_battletable::mapToTable(st, st.cx, st.cz, u0, v0);
+            ga2_battletable::mapToTable(st, st.cx + 1.0f, st.cz, u1, v1);
+            ga2_battletable::mapToTable(st, st.cx, st.cz + 1.0f, u2, v2);
+            const V3 o = playPoint(pose, u0, v0, 0.0f);
+            up = normalize(playPoint(pose, u0, v0, 0.01f) - o);
+            rx = playPoint(pose, u1, v1, 0.0f) - o;
+            fz = playPoint(pose, u2, v2, 0.0f) - o;
+            if (dot(rx, rx) < 1e-12f || dot(fz, fz) < 1e-12f)
+                return false;
+            rx = normalize(rx - up * dot(rx, up));
+            fz = normalize(fz - up * dot(fz, up));
+            return true;
+        }
+
+        // True when the stage's sky was drawn (the generic skybox is then left out).
+        bool drawStageSky(const M4 &rotationView, const M4 &proj)
+        {
+            if (!g_tableView.active)
+                return false;
+            const std::shared_ptr<const bvr_ships::Mesh> mesh = bvr_ships::stageSky();
+            V3 rx, fz, up;
+            if (!mesh || !mapAxes(g_tableView.state, g_tableView.pose, rx, fz, up))
+                return false;
+            GlShip &sky = glShip(mesh);
+            if (!g_skyMeshProgram)
+                g_skyMeshProgram = compile(kShipVs, kSkyMeshFs, "stage sky");
+            float radius = 1.0f;
+            for (int k = 0; k < 3; ++k)
+                radius = std::max({radius, std::fabs(mesh->lo[k]), std::fabs(mesh->hi[k])});
+            const float k = 50.0f / radius; // inside the far plane (100 m), drawn without depth
+            // Game axes X right, Y down, Z forward -> map x, -up, map z.
+            M4 model;
+            model.m[0] = rx.x * k, model.m[1] = rx.y * k, model.m[2] = rx.z * k;
+            model.m[4] = -up.x * k, model.m[5] = -up.y * k, model.m[6] = -up.z * k;
+            model.m[8] = fz.x * k, model.m[9] = fz.y * k, model.m[10] = fz.z * k;
+            glUseProgram(g_skyMeshProgram);
+            setMatrix(g_skyMeshProgram, "model", model);
+            setMatrix(g_skyMeshProgram, "mvp", mul(proj, mul(rotationView, model)));
+            glUniform1i(glGetUniformLocation(g_skyMeshProgram, "tex"), 0);
+            const GLint locTextured = glGetUniformLocation(g_skyMeshProgram, "textured");
+            glDisable(GL_DEPTH_TEST);
+            glDepthMask(GL_FALSE);
+            glEnable(GL_BLEND);
+            glBlendFunc(GL_ONE, GL_ONE);
+            glActiveTexture(GL_TEXTURE0);
+            for (const GlShip::Part &part : sky.parts)
+            {
+                const bool textured = part.texture >= 0 && size_t(part.texture) < sky.textures.size();
+                glUniform1i(locTextured, textured ? 1 : 0);
+                glBindTexture(GL_TEXTURE_2D, textured ? sky.textures[size_t(part.texture)] : 0);
+                glBindVertexArray(part.vao);
+                glDrawElements(GL_TRIANGLES, part.count, GL_UNSIGNED_INT, nullptr);
+            }
+            glBindVertexArray(0);
+            glDisable(GL_BLEND);
+            glEnable(GL_DEPTH_TEST);
+            glDepthMask(GL_TRUE);
+            return true;
         }
 
         void drawScene(const M4 &view, const M4 &proj, V3 eye, GLuint picture, float extentX, float extentY, bool wide,
@@ -1753,18 +1839,21 @@ void main()
