+    std::shared_ptr<const Mesh> stageSky()
+    {
+        Loader &l = loader();
+        std::lock_guard<std::mutex> lock(l.mutex);
+        if (l.stage < 0)
+            return nullptr;
+        if (!l.skyRequested)
+        {
+            l.skyRequested = true;
+            l.queue.push_front(kSkyJob);
+            l.wake.notify_one();
+        }
+        return l.sky;
+    }
