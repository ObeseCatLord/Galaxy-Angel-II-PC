diff --git a/ps2xRuntime/include/runtime/ga2_native3d.h b/ps2xRuntime/include/runtime/ga2_native3d.h
new file mode 100644
index 0000000..94a35c5
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_native3d.h
@@ -0,0 +1,50 @@
+// The native 3D renderer's per-frame capture (research/native3d/design.md): what the game would draw in 3D in a frame,
+// published by the game thread (native/compat) and read by the renderer for the GS frame of the same guest flip.
+#pragma once
+
+#include <cstdint>
+
+namespace ga2_native3d
+{
+    enum class Scene : uint32_t
+    {
+        None = 0,
+        BattleMap = 1, // the battle's tactical map: the stage's map model and sky (battlevr's decoded disc assets)
+    };
+
+    // The game camera as VU1 applies it. V: world -> camera, row vectors (v' = v V, translation in row 3), camera axes
+    // x right, y down, z forward. Projection to GS coordinates: x = cx + scrz*ax*X/Z, y = cy + scrz*ay*Y/Z (the 640-wide
+    // window starts at 2048 - 320).
+    struct Camera
+    {
+        float V[16] = {};
+        float cx = 2048.0f, cy = 2048.0f, scrz = 1.0f, ax = 1.0f, ay = 1.0f;
+    };
+
+    struct Frame
+    {
+        uint64_t flip = 0;       // the guest flip (ga2_framepace::flips()) that shows this frame
+        Scene scene = Scene::None;
+        Camera camera;
+        // The battle's live units (stage section ID, position in game units): the renderer identifies the stage with
+        // them (battlevr), as the VR table does.
+        static constexpr int kMaxUnits = 64;
+        int unitIds[kMaxUnits] = {};
+        float unitX[kMaxUnits] = {}, unitZ[kMaxUnits] = {};
+        int unitCount = 0;
+        uint64_t serial = 0;
+    };
+
+    // Game thread: the frame being built (shown by the next flip).
+    void publish(const Frame &frame);
+    // Renderer: the capture for the GS frame of guest flip `flip` (the newest one at or before it, at most a few
+    // flips old); false when none (the renderer leaves the frame as the GS drew it).
+    bool frameFor(uint64_t flip, Frame &out);
+    // Newest capture regardless of flip.
+    bool latest(Frame &out);
+
+    // Whether the desktop renderer draws the battle map natively (GA2_NATIVE_MAP, default on; native/compat skips the
+    // game's map meshes then). Set by the renderer once it can draw (its pipeline and the stage's assets ready).
+    void setReady(Scene scene, bool ready);
+    bool ready(Scene scene);
+}
